<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HappyPhoton.App"
             Name="Happy Photon"
             xmlns:local="using:HappyPhoton"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://HappyPhoton/Themes/HappyPhotonTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="ExpanderHeaderBorderPointerOverBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="ExpanderHeaderBorderPressedBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="{DynamicResource SurfaceMidColor}"/>
            <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="{DynamicResource SurfaceHighestColor}"/>
            <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="{DynamicResource SurfaceHighestColor}"/>
            <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
            <Thickness x:Key="ExpanderContentDownBorderThickness">0</Thickness>
            <Thickness x:Key="ExpanderContentPadding">0</Thickness>
            <Thickness x:Key="ExpanderHeaderPadding">8,4</Thickness>
            <x:Double x:Key="ExpanderMinHeight">0</x:Double>
            <x:Double x:Key="ExpanderHeaderMinHeight">0</x:Double>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <!-- Global typography -->
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        </Style>
        <Style Selector="TextBlock.section-label">
            <Setter Property="FontFamily" Value="{StaticResource FontLabel}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="LetterSpacing" Value="1"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="{StaticResource FontLabel}"/>
        </Style>
        <Style Selector="ToggleButton">
            <Setter Property="FontFamily" Value="{StaticResource FontLabel}"/>
        </Style>
        <Style Selector="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#PART_toggle">
            <Setter Property="Background" Value="{DynamicResource SurfaceMid}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#PART_toggle:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHighest}"/>
        </Style>
        <Style Selector="Expander /template/ Border#ExpanderContent">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Expander /template/ Path">
            <Setter Property="Stroke" Value="{DynamicResource TextMuted}"/>
        </Style>
        <Style Selector="ComboBox.edit-dropdown">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MaxHeight" Value="28"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
        </Style>
        <Style Selector="TextBox.edit-field">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MaxHeight" Value="28"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
        </Style>
        <Style Selector="ListBox.segmented">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        </Style>
        <Style Selector="ListBox.segmented ListBoxItem">
            <Setter Property="Height" Value="18"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontLabel}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ListBox.segmented ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHighest}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>
        <Style Selector="ListBox.segmented ListBoxItem:selected,
                         ListBox.segmented ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="{StaticResource PrimaryContainer}"/>
            <Setter Property="Foreground" Value="{StaticResource OnPrimary}"/>
        </Style>
        <Style Selector="CheckBox.edit-toggle">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MaxHeight" Value="28"/>
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.quiet-button">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MaxHeight" Value="28"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        </Style>
        <!-- Happy Photon accent rule: brand accent = actions/active state, magenta = highlights. -->
        <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrandAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnBrandAccent}"/>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrandAccentHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnBrandAccent}"/>
        </Style>
        <Style Selector="Button.destructive /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ErrorContainer}"/>
            <Setter Property="Foreground" Value="{StaticResource OnErrorContainer}"/>
        </Style>
        <Style Selector="Button.destructive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ErrorContainer}"/>
            <Setter Property="Foreground" Value="{StaticResource OnErrorContainer}"/>
        </Style>
    </Application.Styles>
</Application>
