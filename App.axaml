<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HappyPhoton.App"
             Name="Happy Photon"
             xmlns:local="using:HappyPhoton"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://HappyPhoton/Themes/HappyPhotonTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="ExpanderHeaderBorderPointerOverBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="ExpanderHeaderBorderPressedBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="{DynamicResource SurfaceMidColor}"/>
            <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="{DynamicResource ControlHoverColor}"/>
            <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="{DynamicResource SurfaceHighestColor}"/>
            <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
            <Thickness x:Key="ExpanderContentDownBorderThickness">0</Thickness>
            <Thickness x:Key="ExpanderContentPadding">0</Thickness>
            <Thickness x:Key="ExpanderHeaderPadding">8,4</Thickness>
            <x:Double x:Key="ExpanderMinHeight">0</x:Double>
            <x:Double x:Key="ExpanderHeaderMinHeight">0</x:Double>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <!-- Global typography -->
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        </Style>
        <Style Selector="TextBlock.section-label">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="LetterSpacing" Value="0"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        </Style>
        <Style Selector="ToggleButton">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        </Style>
        <Style Selector="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#PART_toggle">
            <Setter Property="Background" Value="{DynamicResource SurfaceMid}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#PART_toggle:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlHover}"/>
        </Style>
        <Style Selector="Expander /template/ Border#ExpanderContent">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Expander /template/ Path">
            <Setter Property="Stroke" Value="{DynamicResource TextMuted}"/>
        </Style>
        <Style Selector="ScrollViewer.overlay-scrollbar /template/ ScrollBar#PART_VerticalScrollBar,
                         TreeView.overlay-scrollbar /template/ ScrollViewer /template/ ScrollBar#PART_VerticalScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="ShowDelay" Value="0:0:0.1"/>
        </Style>
        <Style Selector="ScrollViewer.overlay-scrollbar /template/ ScrollBar#PART_VerticalScrollBar /template/ Thumb,
                         TreeView.overlay-scrollbar /template/ ScrollViewer /template/ ScrollBar#PART_VerticalScrollBar /template/ Thumb">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="none"/>
            <Setter Property="Transitions">
                <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.3"/></Transitions>
            </Setter>
        </Style>
        <Style Selector="ScrollViewer.overlay-scrollbar:pointerover /template/ ScrollBar#PART_VerticalScrollBar /template/ Thumb,
                         ScrollViewer.overlay-scrollbar /template/ ScrollBar#PART_VerticalScrollBar[IsExpanded=true] /template/ Thumb,
                         TreeView.overlay-scrollbar:pointerover /template/ ScrollViewer /template/ ScrollBar#PART_VerticalScrollBar /template/ Thumb,
                         TreeView.overlay-scrollbar /template/ ScrollViewer /template/ ScrollBar#PART_VerticalScrollBar[IsExpanded=true] /template/ Thumb">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ScrollViewer.overlay-scrollbar /template/ ScrollBar#PART_VerticalScrollBar[IsExpanded=true] /template/ Thumb,
                         TreeView.overlay-scrollbar /template/ ScrollViewer /template/ ScrollBar#PART_VerticalScrollBar[IsExpanded=true] /template/ Thumb">
            <Setter Property="Width" Value="10"/>
        </Style>
        <Style Selector="ScrollViewer.overlay-scrollbar /template/ ScrollBar#PART_VerticalScrollBar /template/ Thumb:pointerover /template/ Border,
                         ScrollViewer.overlay-scrollbar /template/ ScrollBar#PART_VerticalScrollBar /template/ Thumb:pressed /template/ Border,
                         TreeView.overlay-scrollbar /template/ ScrollViewer /template/ ScrollBar#PART_VerticalScrollBar /template/ Thumb:pointerover /template/ Border,
                         TreeView.overlay-scrollbar /template/ ScrollViewer /template/ ScrollBar#PART_VerticalScrollBar /template/ Thumb:pressed /template/ Border">
            <Setter Property="Background" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style Selector="ScrollViewer.overlay-scrollbar /template/ ScrollBar#PART_VerticalScrollBar[IsExpanded=true] /template/ Grid#Root,
                         TreeView.overlay-scrollbar /template/ ScrollViewer /template/ ScrollBar#PART_VerticalScrollBar[IsExpanded=true] /template/ Grid#Root">
            <Setter Property="Background" Value="{x:Null}"/>
        </Style>
        <Style Selector="ScrollViewer.overlay-scrollbar /template/ ScrollBar#PART_VerticalScrollBar[IsExpanded=true] /template/ Rectangle#TrackRect,
                         TreeView.overlay-scrollbar /template/ ScrollViewer /template/ ScrollBar#PART_VerticalScrollBar[IsExpanded=true] /template/ Rectangle#TrackRect">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="ScrollViewer.overlay-scrollbar /template/ ScrollBar#PART_VerticalScrollBar /template/ RepeatButton#PART_LineUpButton,
                         ScrollViewer.overlay-scrollbar /template/ ScrollBar#PART_VerticalScrollBar /template/ RepeatButton#PART_LineDownButton,
                         TreeView.overlay-scrollbar /template/ ScrollViewer /template/ ScrollBar#PART_VerticalScrollBar /template/ RepeatButton#PART_LineUpButton,
                         TreeView.overlay-scrollbar /template/ ScrollViewer /template/ ScrollBar#PART_VerticalScrollBar /template/ RepeatButton#PART_LineDownButton">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ComboBox.edit-dropdown">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MaxHeight" Value="28"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
        </Style>
        <Style Selector="TextBox.edit-field">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MaxHeight" Value="28"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
        </Style>
        <Style Selector="ListBox.segmented">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        </Style>
        <Style Selector="ListBox.segmented ListBoxItem">
            <Setter Property="Height" Value="18"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.raw-chip">
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="99"/>
        </Style>
        <Style Selector="Border.raw-chip TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>
        <Style Selector="ListBox.segmented ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>
        <Style Selector="ListBox.segmented ListBoxItem:selected,
                         ListBox.segmented ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlSelected}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="CheckBox /template/ Border#NormalRectangle,
                         CheckBox /template/ Viewbox">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform" Value="scale(0.8)"/>
        </Style>
        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle,
                         CheckBox:checked:pointerover /template/ Border#NormalRectangle,
                         CheckBox:checked:pressed /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource ControlActive}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlActive}"/>
        </Style>
        <Style Selector="CheckBox:checked /template/ Path#CheckGlyph,
                         CheckBox:checked:pointerover /template/ Path#CheckGlyph,
                         CheckBox:checked:pressed /template/ Path#CheckGlyph">
            <Setter Property="Fill" Value="{DynamicResource OnControlActive}"/>
        </Style>
        <Style Selector="CheckBox.edit-toggle">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MaxHeight" Value="28"/>
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.quiet-button">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MaxHeight" Value="28"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        </Style>
        <!-- Active controls use value contrast; hue is reserved for semantic data. -->
        <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlActive}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnControlActive}"/>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlActive}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnControlActive}"/>
        </Style>
        <Style Selector="Button.destructive /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ErrorContainer}"/>
            <Setter Property="Foreground" Value="{StaticResource OnErrorContainer}"/>
        </Style>
        <Style Selector="Button.destructive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ErrorContainer}"/>
            <Setter Property="Foreground" Value="{StaticResource OnErrorContainer}"/>
        </Style>
    </Application.Styles>
</Application>
