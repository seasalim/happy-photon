<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="using:HappyPhoton.Views">
    <!-- Happy Photon tokens.
         Single visual source of truth: docs/DESIGN.md.
         Keep code-drawn twins in Views/HappyPhotonColors.cs in sync. -->

    <!-- The color-assessment reference is invariant across application themes.
         #777777 is the sRGB encoding nearest CIE L* 50. It is intentionally
         independent from the MidGray viewer token so either can evolve safely. -->
    <Color x:Key="AssessmentGrayColor">#777777</Color>
    <SolidColorBrush x:Key="AssessmentGray" Color="{StaticResource AssessmentGrayColor}"/>
    <Color x:Key="AssessmentWhiteColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="AssessmentWhite" Color="{StaticResource AssessmentWhiteColor}"/>

    <!-- Hue is reserved for brand and color-semantic data. -->
    <Color x:Key="BrandCyanColor">#00f0ff</Color>
    <SolidColorBrush x:Key="BrandCyan" Color="{StaticResource BrandCyanColor}"/>
    <Color x:Key="WhiteBalanceCoolColor">#74f7ff</Color>
    <Color x:Key="WhiteBalanceNeutralColor">#9df7b0</Color>
    <Color x:Key="WhiteBalanceWarmColor">#f4ff69</Color>
    <Color x:Key="WhiteBalanceTintGreenColor">#73b95a</Color>
    <Color x:Key="WhiteBalanceTintNeutralColor">#849495</Color>
    <Color x:Key="WhiteBalanceTintMagentaColor">#ec3c7e</Color>
    <Color x:Key="ErrorContainerColor">#93000a</Color>
    <Color x:Key="OnErrorContainerColor">#ffdad6</Color>
    <!-- Reject is a culling mark, not an error state. These invariant brushes
         stay legible when drawn over either chrome or photograph pixels. -->
    <Color x:Key="RejectSurfaceColor">#111111</Color>
    <Color x:Key="RejectGlyphColor">#f0f0f0</Color>
    <Color x:Key="RejectOutlineColor">#9a9a9a</Color>
    <!-- Proof caption ink is invariant because it is drawn over photograph pixels. -->
    <Color x:Key="ProofCaptionColor">#FFFFFFFF</Color>
    <Color x:Key="ColorLabelRedColor">#e34b4b</Color>
    <Color x:Key="ColorLabelYellowColor">#e5c85a</Color>
    <Color x:Key="ColorLabelGreenColor">#66c27a</Color>
    <Color x:Key="ColorLabelBlueColor">#4a7ce6</Color>
    <Color x:Key="ColorLabelPurpleColor">#a77ad9</Color>
    <Color x:Key="MixerRedColor">#e34b4b</Color>
    <Color x:Key="MixerOrangeColor">#e58a42</Color>
    <Color x:Key="MixerYellowColor">#d9cf3f</Color>
    <Color x:Key="MixerGreenColor">#58be63</Color>
    <Color x:Key="MixerAquaColor">#44caca</Color>
    <Color x:Key="MixerBlueColor">#557de0</Color>
    <Color x:Key="MixerPurpleColor">#9a65d4</Color>
    <Color x:Key="MixerMagentaColor">#d455ae</Color>
    <Color x:Key="MixerTrackNeutralColor">#66666a</Color>
    <Color x:Key="MixerTrackDarkColor">#17171b</Color>
    <Color x:Key="MixerTrackLightColor">#e7e5ea</Color>
    <Color x:Key="WaveformTraceColor">#cfe6e8</Color>

    <SolidColorBrush x:Key="WhiteBalanceCool" Color="{StaticResource WhiteBalanceCoolColor}"/>
    <SolidColorBrush x:Key="WhiteBalanceNeutral" Color="{StaticResource WhiteBalanceNeutralColor}"/>
    <SolidColorBrush x:Key="WhiteBalanceWarm" Color="{StaticResource WhiteBalanceWarmColor}"/>
    <SolidColorBrush x:Key="WhiteBalanceTintGreen" Color="{StaticResource WhiteBalanceTintGreenColor}"/>
    <SolidColorBrush x:Key="WhiteBalanceTintMagenta" Color="{StaticResource WhiteBalanceTintMagentaColor}"/>
    <SolidColorBrush x:Key="ErrorContainer" Color="{StaticResource ErrorContainerColor}"/>
    <SolidColorBrush x:Key="OnErrorContainer" Color="{StaticResource OnErrorContainerColor}"/>
    <SolidColorBrush x:Key="RejectSurface" Color="{StaticResource RejectSurfaceColor}"/>
    <SolidColorBrush x:Key="RejectGlyph" Color="{StaticResource RejectGlyphColor}"/>
    <SolidColorBrush x:Key="RejectOutline" Color="{StaticResource RejectOutlineColor}"/>
    <SolidColorBrush x:Key="ProofCaption" Color="{StaticResource ProofCaptionColor}"/>
    <SolidColorBrush x:Key="ColorLabelRed" Color="{StaticResource ColorLabelRedColor}"/>
    <SolidColorBrush x:Key="ColorLabelYellow" Color="{StaticResource ColorLabelYellowColor}"/>
    <SolidColorBrush x:Key="ColorLabelGreen" Color="{StaticResource ColorLabelGreenColor}"/>
    <SolidColorBrush x:Key="ColorLabelBlue" Color="{StaticResource ColorLabelBlueColor}"/>
    <SolidColorBrush x:Key="ColorLabelPurple" Color="{StaticResource ColorLabelPurpleColor}"/>
    <SolidColorBrush x:Key="MixerRed" Color="{StaticResource MixerRedColor}"/>
    <SolidColorBrush x:Key="MixerOrange" Color="{StaticResource MixerOrangeColor}"/>
    <SolidColorBrush x:Key="MixerYellow" Color="{StaticResource MixerYellowColor}"/>
    <SolidColorBrush x:Key="MixerGreen" Color="{StaticResource MixerGreenColor}"/>
    <SolidColorBrush x:Key="MixerAqua" Color="{StaticResource MixerAquaColor}"/>
    <SolidColorBrush x:Key="MixerBlue" Color="{StaticResource MixerBlueColor}"/>
    <SolidColorBrush x:Key="MixerPurple" Color="{StaticResource MixerPurpleColor}"/>
    <SolidColorBrush x:Key="MixerMagenta" Color="{StaticResource MixerMagentaColor}"/>
    <SolidColorBrush x:Key="WaveformTrace" Color="{StaticResource WaveformTraceColor}"/>

    <!-- Chart and crop overlays are invariant because they are drawn over pixels. -->
    <Color x:Key="CurveControlPointColor">#ffffffff</Color>
    <Color x:Key="CurveNormalStrokeColor">#849495</Color>
    <Color x:Key="CurveReferenceLineColor">#3cffffff</Color>
    <Color x:Key="CurveGridLineColor">#1effffff</Color>
    <Color x:Key="CropMaskColor">#a0000000</Color>
    <Color x:Key="CropBorderColor">#ffffffff</Color>
    <Color x:Key="CropHandleFillColor">#ffffffff</Color>
    <Color x:Key="CropHandleStrokeColor">#505050</Color>
    <Color x:Key="CropGridLineColor">#64ffffff</Color>
    <Color x:Key="NavigatorViewportHaloColor">#73000000</Color>
    <Color x:Key="ViewerStatusShadowColor">#ff000000</Color>
    <SolidColorBrush x:Key="NavigatorViewportHalo"
                     Color="{StaticResource NavigatorViewportHaloColor}"/>

    <!-- Shape -->
    <BoxShadows x:Key="BadgeShadow">0 1 4 0 #80000000</BoxShadows>
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">16</CornerRadius>
    <CornerRadius x:Key="RadiusCard">24</CornerRadius>
    <x:Double x:Key="TreeViewItemMinHeight">24</x:Double>

    <!-- Compact desktop type scale -->
    <FontFamily x:Key="FontHeading">avares://HappyPhoton/Assets/Fonts#Sora, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="FontBody">avares://HappyPhoton/Assets/Fonts#Hanken Grotesk, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="FontLabel">avares://HappyPhoton/Assets/Fonts#JetBrains Mono, Consolas, monospace</FontFamily>
    <x:Double x:Key="FontSizeHeading">15</x:Double>
    <x:Double x:Key="FontSizeDisplay">28</x:Double>
    <x:Double x:Key="FontSizeFeature">34</x:Double>
    <x:Double x:Key="FontSizeHero">48</x:Double>
    <x:Double x:Key="FontSizeLabel">12</x:Double>
    <x:Double x:Key="FontSizeBody">11</x:Double>
    <x:Double x:Key="FontSizeSmall">10</x:Double>

    <Color x:Key="TourArrowFadeColor">#00ffffff</Color>
    <LinearGradientBrush x:Key="TourArrowTrail"
                         StartPoint="0%,50%"
                         EndPoint="100%,50%">
        <GradientStop Offset="0" Color="{StaticResource TourArrowFadeColor}"/>
        <GradientStop Offset="0.55" Color="#b9b9b9"/>
        <GradientStop Offset="1" Color="#e4e4e4"/>
    </LinearGradientBrush>

    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <ImageBrush x:Key="BrandMark"
                        Source="/Assets/happy-photon-icon.png"
                        Stretch="Uniform"/>
            <Color x:Key="SurfaceLowestColor">#0e0e13</Color>
            <Color x:Key="SurfaceBaseColor">#131318</Color>
            <Color x:Key="SurfaceLowColor">#1b1b20</Color>
            <Color x:Key="WaveformBackdropColor">#1b1b20</Color>
            <Color x:Key="SurfaceMidColor">#1f1f25</Color>
            <Color x:Key="SurfaceHighColor">#2a292f</Color>
            <Color x:Key="SurfaceHighestColor">#35343a</Color>
            <Color x:Key="SurfaceBrightColor">#39383e</Color>
            <Color x:Key="OutlineColor">#849495</Color>
            <Color x:Key="OutlineVariantColor">#3b494b</Color>
            <Color x:Key="TextPrimaryColor">#e4e1e9</Color>
            <Color x:Key="TextSecondaryColor">#b9cacb</Color>
            <Color x:Key="TextMutedColor">#849495</Color>
            <Color x:Key="TextDisabledColor">#849495</Color>
            <Color x:Key="RawFileBackgroundColor">#1f1f25</Color>
            <Color x:Key="ViewerSurroundColor">#131318</Color>
            <Color x:Key="FullScreenBackdropColor">#000000</Color>
            <Color x:Key="SelectionSurfaceColor">#4b4a52</Color>
            <Color x:Key="ControlHoverColor">#353535</Color>
            <Color x:Key="ControlSelectedColor">#4b4b4b</Color>
            <Color x:Key="ControlActiveColor">#e4e4e4</Color>
            <Color x:Key="OnControlActiveColor">#131313</Color>
            <Color x:Key="SystemAccentColor">#ffffff</Color>
            <Color x:Key="SystemAccentColorLight1">#ffffff</Color>
            <Color x:Key="SystemAccentColorLight2">#f0f0f0</Color>
            <Color x:Key="SystemAccentColorLight3">#e4e4e4</Color>
            <Color x:Key="SystemAccentColorDark1">#d4d4d4</Color>
            <Color x:Key="SystemAccentColorDark2">#b9b9b9</Color>
            <Color x:Key="SystemAccentColorDark3">#9a9a9a</Color>

            <SolidColorBrush x:Key="SurfaceLowest" Color="{StaticResource SurfaceLowestColor}"/>
            <SolidColorBrush x:Key="SurfaceBase" Color="{StaticResource SurfaceBaseColor}"/>
            <SolidColorBrush x:Key="SurfaceLow" Color="{StaticResource SurfaceLowColor}"/>
            <SolidColorBrush x:Key="WaveformBackdrop" Color="{StaticResource WaveformBackdropColor}"/>
            <SolidColorBrush x:Key="SurfaceMid" Color="{StaticResource SurfaceMidColor}"/>
            <SolidColorBrush x:Key="SurfaceHigh" Color="{StaticResource SurfaceHighColor}"/>
            <SolidColorBrush x:Key="SurfaceHighest" Color="{StaticResource SurfaceHighestColor}"/>
            <SolidColorBrush x:Key="SurfaceBright" Color="{StaticResource SurfaceBrightColor}"/>
            <SolidColorBrush x:Key="Outline" Color="{StaticResource OutlineColor}"/>
            <SolidColorBrush x:Key="OutlineVariant" Color="{StaticResource OutlineVariantColor}"/>
            <SolidColorBrush x:Key="Divider" Color="{StaticResource OutlineVariantColor}" Opacity="0.55"/>
            <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="NavigatorViewportStroke"
                             Color="{StaticResource TextPrimaryColor}"
                             Opacity="0.92"/>
            <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}"/>
            <SolidColorBrush x:Key="TextDisabled" Color="{StaticResource TextDisabledColor}"/>
            <SolidColorBrush x:Key="RawFileBackground" Color="{StaticResource RawFileBackgroundColor}"/>
            <SolidColorBrush x:Key="ViewerSurround" Color="{StaticResource ViewerSurroundColor}"/>
            <SolidColorBrush x:Key="FullScreenBackdrop" Color="{StaticResource FullScreenBackdropColor}"/>
            <SolidColorBrush x:Key="SelectionSurface" Color="{StaticResource SelectionSurfaceColor}"/>
            <SolidColorBrush x:Key="ControlHover" Color="{StaticResource ControlHoverColor}"/>
            <SolidColorBrush x:Key="ControlSelected" Color="{StaticResource ControlSelectedColor}"/>
            <SolidColorBrush x:Key="ControlActive" Color="{StaticResource ControlActiveColor}"/>
            <SolidColorBrush x:Key="OnControlActive" Color="{StaticResource OnControlActiveColor}"/>
            <SolidColorBrush x:Key="ActiveImageRing" Color="{StaticResource ControlActiveColor}" Opacity="0.77"/>
            <SolidColorBrush x:Key="SelectionCheck" Color="{StaticResource ControlActiveColor}"/>
            <SolidColorBrush x:Key="ViewerControlBarBackground" Color="Transparent"/>
            <BoxShadows x:Key="CoachmarkShadow">0 12 30 0 #99000000</BoxShadows>
            <x:Double x:Key="TourDimmedOpacity">0.48</x:Double>
            <x:Double x:Key="TourFocusGlowOpacity">0.5</x:Double>
            <x:Double x:Key="CoachmarkFocusGlowOpacity">0.55</x:Double>
            <x:Double x:Key="DisabledOpacity">0.32</x:Double>

            <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource SurfaceHighColor}"/>
            <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource ControlHoverColor}"/>
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource SurfaceBrightColor}"/>
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource OutlineVariantColor}"/>
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource OutlineColor}"/>
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource ControlActiveColor}"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{StaticResource ControlActiveColor}"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{StaticResource OnControlActiveColor}"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{StaticResource ControlActiveColor}"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{StaticResource OnControlActiveColor}"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="{x:Static views:HappyPhotonThemes.MidGray}">
            <!-- Neutral chrome stays below the L* 50 image surround. -->
            <ImageBrush x:Key="BrandMark"
                        Source="/Assets/happy-photon-icon.png"
                        Stretch="Uniform"/>
            <Color x:Key="SurfaceLowestColor">#303030</Color>
            <Color x:Key="SurfaceBaseColor">#363636</Color>
            <Color x:Key="SurfaceLowColor">#3d3d3d</Color>
            <Color x:Key="WaveformBackdropColor">#3d3d3d</Color>
            <Color x:Key="SurfaceMidColor">#444444</Color>
            <Color x:Key="SurfaceHighColor">#4b4b4b</Color>
            <Color x:Key="SurfaceHighestColor">#535353</Color>
            <Color x:Key="SurfaceBrightColor">#5c5c5c</Color>
            <!-- Chrome neutrals are strictly achromatic (R=G=B) so nothing near
                 the photograph carries a color cast; the Dark theme's teal-tinted
                 neutral family must not leak into this dictionary. -->
            <Color x:Key="OutlineColor">#c8c8c8</Color>
            <Color x:Key="OutlineVariantColor">#747474</Color>
            <Color x:Key="TextPrimaryColor">#ffffff</Color>
            <Color x:Key="TextSecondaryColor">#f0f0f0</Color>
            <Color x:Key="TextMutedColor">#d4d4d4</Color>
            <Color x:Key="TextDisabledColor">#c8c8c8</Color>
            <Color x:Key="RawFileBackgroundColor">#444444</Color>
            <Color x:Key="ViewerSurroundColor">#777777</Color>
            <Color x:Key="FullScreenBackdropColor">#777777</Color>
            <Color x:Key="SelectionSurfaceColor">#616161</Color>
            <Color x:Key="ControlHoverColor">#535353</Color>
            <Color x:Key="ControlSelectedColor">#616161</Color>
            <Color x:Key="ControlActiveColor">#e4e4e4</Color>
            <Color x:Key="OnControlActiveColor">#303030</Color>
            <!-- Muted accents for chrome that borders photo pixels: reduced chroma
                 limits simultaneous-contrast shifts against the L* 50 surround. -->
            <!-- Achromatic at the same relative luminance the muted teal carried,
                 so the ring keeps its former visual weight against the surround. -->
            <Color x:Key="ActiveImageRingColor">#bbbbbb</Color>
            <Color x:Key="SystemAccentColor">#ffffff</Color>
            <Color x:Key="SystemAccentColorLight1">#ffffff</Color>
            <Color x:Key="SystemAccentColorLight2">#f0f0f0</Color>
            <Color x:Key="SystemAccentColorLight3">#e4e4e4</Color>
            <Color x:Key="SystemAccentColorDark1">#d4d4d4</Color>
            <Color x:Key="SystemAccentColorDark2">#b9b9b9</Color>
            <Color x:Key="SystemAccentColorDark3">#9a9a9a</Color>

            <SolidColorBrush x:Key="SurfaceLowest" Color="{StaticResource SurfaceLowestColor}"/>
            <SolidColorBrush x:Key="SurfaceBase" Color="{StaticResource SurfaceBaseColor}"/>
            <SolidColorBrush x:Key="SurfaceLow" Color="{StaticResource SurfaceLowColor}"/>
            <SolidColorBrush x:Key="WaveformBackdrop" Color="{StaticResource WaveformBackdropColor}"/>
            <SolidColorBrush x:Key="SurfaceMid" Color="{StaticResource SurfaceMidColor}"/>
            <SolidColorBrush x:Key="SurfaceHigh" Color="{StaticResource SurfaceHighColor}"/>
            <SolidColorBrush x:Key="SurfaceHighest" Color="{StaticResource SurfaceHighestColor}"/>
            <SolidColorBrush x:Key="SurfaceBright" Color="{StaticResource SurfaceBrightColor}"/>
            <SolidColorBrush x:Key="Outline" Color="{StaticResource OutlineColor}"/>
            <SolidColorBrush x:Key="OutlineVariant" Color="{StaticResource OutlineVariantColor}"/>
            <SolidColorBrush x:Key="Divider" Color="{StaticResource OutlineVariantColor}" Opacity="0.72"/>
            <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="NavigatorViewportStroke"
                             Color="{StaticResource TextPrimaryColor}"
                             Opacity="0.92"/>
            <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}"/>
            <SolidColorBrush x:Key="TextDisabled" Color="{StaticResource TextDisabledColor}"/>
            <SolidColorBrush x:Key="RawFileBackground" Color="{StaticResource RawFileBackgroundColor}"/>
            <SolidColorBrush x:Key="ViewerSurround" Color="{StaticResource ViewerSurroundColor}"/>
            <SolidColorBrush x:Key="FullScreenBackdrop" Color="{StaticResource FullScreenBackdropColor}"/>
            <SolidColorBrush x:Key="SelectionSurface" Color="{StaticResource SelectionSurfaceColor}"/>
            <SolidColorBrush x:Key="ControlHover" Color="{StaticResource ControlHoverColor}"/>
            <SolidColorBrush x:Key="ControlSelected" Color="{StaticResource ControlSelectedColor}"/>
            <SolidColorBrush x:Key="ControlActive" Color="{StaticResource ControlActiveColor}"/>
            <SolidColorBrush x:Key="OnControlActive" Color="{StaticResource OnControlActiveColor}"/>
            <SolidColorBrush x:Key="ActiveImageRing" Color="{StaticResource ActiveImageRingColor}"/>
            <SolidColorBrush x:Key="SelectionCheck" Color="{StaticResource ControlActiveColor}"/>
            <SolidColorBrush x:Key="ViewerControlBarBackground" Color="{StaticResource SurfaceLowColor}"/>
            <BoxShadows x:Key="CoachmarkShadow">0 12 30 0 #b3000000</BoxShadows>
            <x:Double x:Key="TourDimmedOpacity">0.44</x:Double>
            <x:Double x:Key="TourFocusGlowOpacity">0.75</x:Double>
            <x:Double x:Key="CoachmarkFocusGlowOpacity">0.75</x:Double>
            <x:Double x:Key="DisabledOpacity">0.62</x:Double>

            <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource SurfaceHighColor}"/>
            <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource ControlHoverColor}"/>
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource SurfaceBrightColor}"/>
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource OutlineVariantColor}"/>
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource OutlineColor}"/>
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource ControlActiveColor}"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{StaticResource ControlActiveColor}"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{StaticResource OnControlActiveColor}"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{StaticResource ControlActiveColor}"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{StaticResource OnControlActiveColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
