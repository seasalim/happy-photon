<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>HappyPhoton.Tests</AssemblyName>
    <RootNamespace>HappyPhoton.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HappyPhoton.csproj" />
    <None Update="assets\lightroom\*.lua" CopyToOutputDirectory="PreserveNewest" />
    <None Update="assets\lightroom\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ColorLabelUiTests.cs" />
    <Compile Remove="EditAutoSaveRefreshRaceTests.cs" />
    <Compile Remove="CloudSourceViewTests.cs" />
    <Compile Remove="CloudSelectionStateTests.cs" />
    <Compile Remove="ClippingOverlayViewModelTests.cs" />
    <Compile Remove="ClippingOutcomeCorrelationTests.cs" />
    <Compile Remove="ColorAssessmentViewTests.cs" />
    <Compile Remove="ComparePreviewCacheTests.cs" />
    <Compile Remove="CompareViewTests.cs" />
    <Compile Remove="FirstRunWindowTests.cs" />
    <Compile Remove="HelpAboutDialogTests.cs" />
    <Compile Remove="ImageFileThumbnailLifetimeTests.cs" />
    <Compile Remove="BrowseSelectionMenuTests.cs" />
    <Compile Remove="ManualFolderRefreshViewTests.cs" />
    <Compile Remove="PreviewBitmapLifetimeTests.cs" />
    <Compile Remove="PreviewPlaceholderTests.cs" />
    <Compile Remove="PreviewCacheOutcomeOrderingTests.cs" />
    <Compile Remove="PromotionOutcomeTests.cs" />
    <Compile Remove="RawHighlightReconstructionUiTests.cs" />
    <Compile Remove="RawHistogramUiTests.cs" />
    <Compile Remove="RenderFailureRollbackTests.cs" />
    <Compile Remove="ShortcutReachabilityTests.cs" />
    <Compile Remove="WhiteBalanceUiTests.cs" />
    <Compile Remove="WhiteBalanceOutcomeRaceTests.cs" />
    <Compile Remove="WaveformScopeUiTests.cs" />
    <Compile Remove="WaveformViewTests.cs" />
    <Compile Remove="WorkspaceTransitionTests.cs" />
    <Compile Remove="WorkflowTourDimmingTests.cs" />
  </ItemGroup>
</Project>
