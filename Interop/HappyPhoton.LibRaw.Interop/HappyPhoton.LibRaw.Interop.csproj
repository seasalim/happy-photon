<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- CI restores with a global -p:RuntimeIdentifier, which flows into this
         project through the HappyPhoton reference; the lock file must carry a
         section per RID or locked-mode restore fails with NU1004. -->
    <RuntimeIdentifiers>win-x64;linux-x64;osx-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HappyPhoton.LibRaw.Interop.Tests" />
    <InternalsVisibleTo Include="HappyPhoton.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HappyPhoton.LibRaw.Native" Version="0.22.2.12" />
  </ItemGroup>
</Project>
