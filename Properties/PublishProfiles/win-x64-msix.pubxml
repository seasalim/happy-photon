<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- The app's reflection-based JSON stays on; trimming would otherwise switch it off. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- The runtime's debugger and dump files serve only debugger attach and managed dump creation;
       the single-file builds already ship without them. Dropping them from both lists also keeps
       them out of HappyPhoton.deps.json. package-windows-msix.ps1 rejects a payload that still
       carries one. -->
  <PropertyGroup>
    <DebuggerRuntimeFilePattern>^(createdump\.exe|mscordbi\.dll|mscordaccore.*\.dll|Microsoft\.DiaSymReader\.Native\.amd64\.dll)$</DebuggerRuntimeFilePattern>
  </PropertyGroup>

  <Target Name="ExcludeDebuggerRuntimeFiles" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)%(Extension)', '$(DebuggerRuntimeFilePattern)'))" />
      <RuntimePackAsset Remove="@(RuntimePackAsset)"
                        Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)%(Extension)', '$(DebuggerRuntimeFilePattern)'))" />
    </ItemGroup>
  </Target>
</Project>
