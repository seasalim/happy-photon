<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:HappyPhoton.Views"
             xmlns:vm="using:HappyPhoton.ViewModels"
             xmlns:models="using:HappyPhoton.Models"
             mc:Ignorable="d"
             d:DesignWidth="250"
             d:DesignHeight="660"
             x:Class="HappyPhoton.Views.DevelopEditPanel"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>
        <StyleInclude Source="avares://HappyPhoton/Views/DevelopActionStyles.axaml"/>
        <Style Selector="ToggleButton.tool">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="AutomationProperties.HelpText" Value=""/>
        </Style>
        <Style Selector="ToggleButton.tool-mask:checked">
            <Setter Property="Background" Value="{DynamicResource ControlActive}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnControlActive}"/>
        </Style>
        <Style Selector="ToggleButton.tool Ellipse">
            <Setter Property="Fill" Value="{DynamicResource ControlActive}"/>
        </Style>
        <Style Selector="ToggleButton.tool:checked Ellipse">
            <Setter Property="Fill" Value="{DynamicResource OnControlActive}"/>
        </Style>
        <Style Selector="ToggleButton.crop.has-content">
            <Setter Property="AutomationProperties.HelpText" Value="contains a committed crop"/>
        </Style>
        <Style Selector="ToggleButton.locals.has-content">
            <Setter Property="AutomationProperties.HelpText" Value="contains saved locals"/>
        </Style>
        <Style Selector="StackPanel.global-edits.locked">
            <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}"/>
        </Style>
        <Style Selector="views|CompactSlider.crossing-dependent:disabled">
            <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}"/>
        </Style>
        <Style Selector="StackPanel.color-dependent:disabled,
                         views|CompactSlider.color-dependent:disabled,
                         views|MixerEditGroup.color-dependent:disabled">
            <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}"/>
        </Style>
        <Style Selector="ToggleButton.wb-picker:checked">
            <Setter Property="Background" Value="{DynamicResource ControlActive}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnControlActive}"/>
        </Style>
        <Style Selector="Button.wb-auto">
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MaxHeight" Value="28"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="ToggleButton.wb-picker">
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MaxHeight" Value="28"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="TextBlock.edit-control-label">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Grid.highlight-handling-row:disabled">
            <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}"/>
        </Style>
        <Style Selector="StackPanel.global-edits.locked > StackPanel.color-dependent,
                         StackPanel.global-edits.locked > views|CompactSlider.color-dependent,
                         StackPanel.global-edits.locked > views|CompactSlider.crossing-dependent,
                         StackPanel.global-edits.locked > views|MixerEditGroup.color-dependent,
                         StackPanel.global-edits.locked > Grid.highlight-handling-row">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource SurfaceMid}"
            IsEnabled="{Binding IsWorkspaceInteractionEnabled}">
        <Grid RowDefinitions="Auto,*,Auto">
            <StackPanel Grid.Row="0" IsEnabled="{Binding HasSelectedImage}">
                <Border x:Name="DevelopScopeBox"
                        Margin="15,15,15,10"
                        Padding="5"
                        Background="{DynamicResource SurfaceLow}"
                        CornerRadius="8"
                        IsEnabled="{Binding HasSelectedImage}">
                    <StackPanel Spacing="5">
                        <views:ScopeSelectorRow x:Name="ScopeSelector"/>
                        <Grid>
                            <views:HistogramView
                                x:Name="DevelopHistogram"
                                Histogram="{Binding EffectiveHistogram}"
                                Clipping="{Binding DisplayClippingStats}"
                                IsClippingOverlayLatched="{Binding IsClippingOverlayLatched}"
                                ShowDisplayClippingIndicators="True"
                                IsVisible="{Binding IsHistogramScopeEffective}"/>
                            <views:WaveformView
                                x:Name="DevelopWaveform"
                                Waveform="{Binding EffectiveWaveform}"
                                IsVisible="{Binding IsWaveformScopeEffective}"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="DevelopToolRow" Orientation="Horizontal" Spacing="4" Margin="15,0,15,8">
                    <ToggleButton x:Name="CropModeButton" Classes="develop-action tool crop" Classes.has-content="{Binding HasCommittedCrop}"
                                  IsChecked="{Binding IsCropMode, Mode=OneWay}" Command="{Binding ToggleCropModeCommand}"
                                  AutomationProperties.Name="Crop" ToolTip.Tip="Crop Image (R)" IsEnabled="{Binding CanEditSelectedImage}">
                        <Grid>
                            <TextBlock Text="⬚" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Ellipse Width="4" Height="4" HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Margin="0,-2,-3,0" IsVisible="{Binding HasCommittedCrop}"/>
                        </Grid>
                    </ToggleButton>
                    <ToggleButton x:Name="LocalsModeButton" Classes="develop-action tool locals" Classes.has-content="{Binding HasLocals}"
                                  IsChecked="{Binding IsLocalsMode, Mode=OneWay}" Command="{Binding ToggleLocalsModeCommand}"
                                  AutomationProperties.Name="Locals" ToolTip.Tip="Locals">
                        <Grid>
                            <TextBlock Text="◩" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Ellipse Width="4" Height="4" HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Margin="0,-2,-3,0" IsVisible="{Binding HasLocals}"/>
                        </Grid>
                    </ToggleButton>
                </StackPanel>
                <Grid x:Name="CropToolHeader" ColumnDefinitions="*,Auto,Auto" Margin="15,0,15,8"
                      IsVisible="{Binding IsCropMode}" IsEnabled="{Binding CanEditSelectedImage}">
                    <TextBlock Text="CROP" Classes="section-label" VerticalAlignment="Center"/>
                    <Button x:Name="CancelCropButton" Grid.Column="1" Content="Cancel" Command="{Binding CancelCropCommand}"
                            ToolTip.Tip="Cancel (Escape)" FontSize="10" Padding="8,4" BorderThickness="0"/>
                    <Button x:Name="ApplyCropButton" Grid.Column="2" Content="Apply" Command="{Binding ApplyCropCommand}"
                            ToolTip.Tip="Apply Crop (Enter)" FontSize="10" Padding="10,4" Classes="accent" BorderThickness="0"/>
                </Grid>
                <Grid x:Name="LocalsToolHeader" ColumnDefinitions="*,Auto,Auto" Margin="15,0,15,8" IsVisible="{Binding IsLocalsMode}">
                    <TextBlock Text="LOCALS" Classes="section-label" VerticalAlignment="Center"/>
                    <ToggleButton x:Name="ShowLocalMaskButton" Classes="tool-mask" Grid.Column="1" Content="Show Mask"
                                  IsChecked="{Binding ShowLocalMask}" AutomationProperties.Name="Show selected mask" Padding="5,3" FontSize="10"/>
                    <Button x:Name="CloseLocalsButton" Grid.Column="2" Content="Close" Command="{Binding CloseLocalsCommand}" Padding="5,3" FontSize="10"/>
                </Grid>
            </StackPanel>

            <ScrollViewer x:Name="DevelopControlsScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="15,5,15,15"
                            Spacing="4"
                            IsEnabled="{Binding HasSelectedImage}">
                    <views:CropEditSection/>
                    <views:LocalsEditSection/>
                    <StackPanel Classes="global-edits" Classes.locked="{Binding IsToolActive}" Spacing="4" IsEnabled="{Binding !IsToolActive}">
                        <views:RawProfilePicker x:Name="RawProfilePicker"
                            IsEnabled="{Binding IsColorEditingEnabled}"/>

                        <StackPanel x:Name="WhiteBalanceControls"
                                    Classes="color-dependent"
                                    Spacing="4"
                                    IsEnabled="{Binding IsColorEditingEnabled}">
                            <Border BorderBrush="{DynamicResource Divider}"
                                    BorderThickness="0,1,0,0"
                                    Margin="0,1,0,12">
                                <TextBlock x:Name="WhiteBalanceHeading"
                                           Classes="section-label"
                                           Text="White Balance"/>
                            </Border>

                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  Height="28"
                                  Margin="0,0,0,8">
                                <ComboBox x:Name="WhiteBalanceModeBox"
                                          Grid.Column="0"
                                          Classes="edit-dropdown"
                                          ItemsSource="{Binding WhiteBalanceModeOptions}"
                                          SelectedItem="{Binding SelectedWhiteBalanceMode, Mode=TwoWay}"/>
                                <Button x:Name="WhiteBalanceAutoButton"
                                        Grid.Column="1"
                                        Classes="wb-auto"
                                        Command="{Binding AutoWhiteBalanceCommand}"
                                        Content="Auto"
                                        Margin="6,0,0,0"
                                        ToolTip.Tip="Automatic white balance"/>
                                <ToggleButton x:Name="WhiteBalancePickerButton"
                                              Grid.Column="2"
                                              Classes="wb-picker"
                                              Command="{Binding ToggleWhiteBalancePickerCommand}"
                                              IsChecked="{Binding IsWhiteBalancePicking, Mode=OneWay}"
                                              Margin="4,0,0,0"
                                              ToolTip.Tip="White balance eyedropper (W)">
                                    <Viewbox Width="16" Height="16">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="{DynamicResource TextPrimary}"
                                                  StrokeThickness="1.8"
                                                  StrokeLineCap="Round"
                                                  StrokeJoin="Round"
                                                  Data="M2,22 L3,21 L6,21 L15,12 M3,21 L3,18 L12,9 M15,6 L18.4,2.6 C19.2,1.8 20.5,1.8 21.3,2.6 C22.1,3.4 22.1,4.7 21.3,5.5 L18,9 Z M15,6 L12,9 L15,12 L18,9 Z"/>
                                        </Canvas>
                                    </Viewbox>
                                </ToggleButton>
                            </Grid>

                            <views:CompactSlider Label="Kelvin"
                                                 Value="{Binding WhiteBalanceKelvinPosition}"
                                                 Minimum="0"
                                                 Maximum="1"
                                                 SmallChange="0.005"
                                                 DisplayText="{Binding WhiteBalanceKelvinText}"
                                                 ShowValueFill="False">
                                <views:CompactSlider.TrackBrush>
                                    <LinearGradientBrush StartPoint="0%,50%"
                                                         EndPoint="100%,50%">
                                        <GradientStop Color="{StaticResource WhiteBalanceCoolColor}"
                                                      Offset="0"/>
                                        <GradientStop Color="{StaticResource WhiteBalanceNeutralColor}"
                                                      Offset="0.55"/>
                                        <GradientStop Color="{StaticResource WhiteBalanceWarmColor}"
                                                      Offset="1"/>
                                    </LinearGradientBrush>
                                </views:CompactSlider.TrackBrush>
                            </views:CompactSlider>

                            <views:CompactSlider Label="Tint"
                                                 Value="{Binding WhiteBalanceTint}"
                                                 Minimum="-100"
                                                 Maximum="100"
                                                 SmallChange="1"
                                                 DisplayText="{Binding WhiteBalanceTintText}"
                                                 ShowValueFill="False">
                                <views:CompactSlider.TrackBrush>
                                    <LinearGradientBrush StartPoint="0%,50%"
                                                         EndPoint="100%,50%">
                                        <GradientStop Color="{StaticResource WhiteBalanceTintGreenColor}"
                                                      Offset="0"/>
                                        <GradientStop Color="{StaticResource WhiteBalanceTintNeutralColor}"
                                                      Offset="0.5"/>
                                        <GradientStop Color="{StaticResource WhiteBalanceTintMagentaColor}"
                                                      Offset="1"/>
                                    </LinearGradientBrush>
                                </views:CompactSlider.TrackBrush>
                            </views:CompactSlider>
                        </StackPanel>

                        <Border BorderBrush="{DynamicResource Divider}"
                                BorderThickness="0,1,0,0"
                                Margin="0,19,0,8">
                            <TextBlock Classes="section-label" Text="Adjustments"/>
                        </Border>

                        <views:CompactSlider Label="Exposure"
                                             Value="{Binding Exposure}"
                                             Minimum="-3"
                                             Maximum="3"
                                             SmallChange="0.05"
                                             StringFormat="{}{0:F2}"
                                             EnableDoubleClickReset="True"/>
                        <views:CompactSlider x:Name="BrightnessSlider"
                                             Classes="crossing-dependent"
                                             Label="Brightness"
                                             Value="{Binding Brightness}"
                                             IsEnabled="{Binding IsBrightnessEnabled}"
                                             Minimum="-100"
                                             Maximum="100"
                                             SmallChange="1"
                                             EnableDoubleClickReset="True"/>
                        <views:CompactSlider Label="Contrast"
                                             Value="{Binding Contrast}"
                                             Minimum="-100"
                                             Maximum="100"
                                             SmallChange="1"
                                             EnableDoubleClickReset="True"/>
                        <views:CompactSlider x:Name="SaturationSlider"
                                             Classes="color-dependent"
                                             Label="Saturation"
                                             Value="{Binding Saturation}"
                                             IsEnabled="{Binding IsColorEditingEnabled}"
                                             Minimum="-100"
                                             Maximum="100"
                                             SmallChange="1"
                                             EnableDoubleClickReset="True"/>
                        <views:CompactSlider x:Name="VibranceSlider"
                                             Classes="color-dependent"
                                             Label="Vibrance"
                                             Value="{Binding Vibrance}"
                                             IsEnabled="{Binding IsColorEditingEnabled}"
                                             Minimum="-100"
                                             Maximum="100"
                                             SmallChange="1"
                                             EnableDoubleClickReset="True"/>
                        <views:CompactSlider Label="Shadows"
                                             Value="{Binding Shadows}"
                                             Minimum="-100"
                                             Maximum="100"
                                             SmallChange="1"
                                             EnableDoubleClickReset="True"/>
                        <views:CompactSlider Label="Highlights"
                                             Value="{Binding Highlights}"
                                             Minimum="-100"
                                             Maximum="100"
                                             SmallChange="1"
                                             EnableDoubleClickReset="True"/>

                        <Grid x:Name="HighlightHandlingRow"
                              Classes="highlight-handling-row"
                              ColumnDefinitions="70,*,40"
                              Height="26"
                              Margin="0,0,0,4"
                              IsEnabled="{Binding IsHighlightHandlingEnabled}">
                            <TextBlock Classes="edit-control-label"
                                       Text="Recovery"/>
                            <ListBox x:Name="HighlightHandlingControl"
                                     Grid.Column="1"
                                     Margin="8,0"
                                     Classes="segmented"
                                     ItemsSource="{Binding HighlightHandlingOptions}"
                                     SelectedItem="{Binding HlReconstruction, Mode=TwoWay}"
                                     SelectionMode="Single,AlwaysSelected"
                                     AutomationProperties.Name="Recovery">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" ColumnSpacing="2"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static views:DevelopEditPanel.HighlightHandlingLabelConverter}}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Grid.Column="2"
                                    Classes="raw-chip"
                                    HorizontalAlignment="Right">
                                <TextBlock Text="RAW"/>
                            </Border>
                        </Grid>

                        <views:CurveView x:Name="ToneCurveView"
                                         Curve="{Binding CurrentCurve}" CompositeCurve="{Binding CompositeCurve}" ActiveChannel="{Binding ActiveCurveChannel, Mode=TwoWay}"
                                         HasRedCurve="{Binding HasRedCurve}" HasGreenCurve="{Binding HasGreenCurve}" HasBlueCurve="{Binding HasBlueCurve}" CurveEditStarted="OnCurveEditStarted" CurveChanged="OnCurveChanged"
                                         AreColorChannelsEnabled="{Binding AreColorCurveChannelsEnabled}"
                                         Margin="0,20,0,0"
                                         Height="180"/>

                        <views:MixerEditGroup x:Name="MixerEditGroup"
                                              Classes="color-dependent"
                                              IsEnabled="{Binding IsColorEditingEnabled}"/>
                        <views:DetailEditGroup x:Name="DetailEditGroup"/>
                        <views:EffectsEditGroup x:Name="EffectsEditGroup"/>
                        <views:GeometryEditGroup x:Name="GeometryEditGroup"/>
                        <views:LensEditGroup x:Name="LensEditGroup"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <views:DevelopActionBar x:Name="DevelopActionBar"
                                    Grid.Row="2"
                                    Margin="15,8,15,15"/>
        </Grid>
    </Border>
</UserControl>
