<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:HappyPhoton.Views"
             xmlns:vm="using:HappyPhoton.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="250"
             d:DesignHeight="660"
             x:Class="HappyPhoton.Views.DevelopEditPanel"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>
        <Style Selector="views|CompactSlider.crossing-dependent:disabled">
            <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}"/>
        </Style>
        <Style Selector="ToggleButton.wb-picker:checked">
            <Setter Property="Background" Value="{StaticResource PrimaryContainer}"/>
            <Setter Property="Foreground" Value="{StaticResource OnPrimary}"/>
        </Style>
        <Style Selector="ComboBox.edit-dropdown">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MaxHeight" Value="28"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
        </Style>
        <Style Selector="ComboBox.scope-selector">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="MaxHeight" Value="24"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontFamily" Value="{StaticResource FontLabel}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
        </Style>
        <Style Selector="Button.develop-action, ToggleButton.develop-action">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryContainer}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.develop-action:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ToggleButton.develop-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
        </Style>
        <Style Selector="Button.develop-action:disabled, ToggleButton.develop-action:disabled">
            <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
        </Style>
        <Style Selector="Button.develop-action:disabled /template/ ContentPresenter#PART_ContentPresenter,
                         ToggleButton.develop-action:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
        </Style>
        <Style Selector="Button.develop-action Path, ToggleButton.develop-action Path">
            <Setter Property="Stroke" Value="{StaticResource PrimaryContainer}"/>
        </Style>
        <Style Selector="Button.develop-action:pointerover Path,
                         ToggleButton.develop-action:pointerover Path">
            <Setter Property="Stroke" Value="{StaticResource Primary}"/>
        </Style>
        <Style Selector="ToggleButton.develop-action:checked">
            <Setter Property="Background" Value="{StaticResource PrimaryContainer}"/>
            <Setter Property="Foreground" Value="{StaticResource OnPrimary}"/>
        </Style>
        <Style Selector="ToggleButton.develop-action:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PrimaryContainer}"/>
            <Setter Property="Foreground" Value="{StaticResource OnPrimary}"/>
        </Style>
        <Style Selector="ToggleButton.develop-action:checked Path">
            <Setter Property="Stroke" Value="{StaticResource OnPrimary}"/>
        </Style>
        <Style Selector="Button.develop-reset">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryContainer}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontLabel}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.develop-reset:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
        </Style>
        <Style Selector="Button.develop-reset /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryContainer}"/>
        </Style>
        <Style Selector="Button.develop-reset:disabled">
            <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
        </Style>
        <Style Selector="Button.develop-reset:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
        </Style>
        <Style Selector="Button.wb-auto">
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MaxHeight" Value="28"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
        </Style>
        <Style Selector="ToggleButton.wb-picker">
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MaxHeight" Value="28"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
        </Style>
        <Style Selector="TextBlock.edit-control-label">
            <Setter Property="FontFamily" Value="{StaticResource FontLabel}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Grid.highlight-handling-row:disabled">
            <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}"/>
        </Style>
        <Style Selector="ListBox.highlight-handling">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        </Style>
        <Style Selector="ListBox.highlight-handling ListBoxItem">
            <Setter Property="Height" Value="18"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontLabel}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ListBox.highlight-handling ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHighest}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>
        <Style Selector="ListBox.highlight-handling ListBoxItem:selected">
            <Setter Property="Background" Value="{StaticResource PrimaryContainer}"/>
            <Setter Property="Foreground" Value="{StaticResource OnPrimary}"/>
        </Style>
        <Style Selector="ListBox.highlight-handling ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="{StaticResource PrimaryContainer}"/>
            <Setter Property="Foreground" Value="{StaticResource OnPrimary}"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource SurfaceMid}"
            IsEnabled="{Binding IsWorkspaceInteractionEnabled}">
        <Grid RowDefinitions="Auto,*,Auto">
            <Grid Grid.Row="0" RowDefinitions="Auto,2">
                <Border x:Name="DevelopScopeBox"
                        Margin="15,15,15,10"
                        Padding="5"
                        Background="{DynamicResource SurfaceLow}"
                        CornerRadius="8"
                        IsEnabled="{Binding HasSelectedImage}">
                    <StackPanel Spacing="5">
                        <ComboBox x:Name="ScopeSelector"
                                  Classes="scope-selector"
                                  ItemsSource="{Binding ScopeOptions}"
                                  SelectedItem="{Binding SelectedScopeOption, Mode=TwoWay}"
                                  AutomationProperties.Name="Develop scope">
                            <ComboBox.Styles>
                                <Style Selector="ComboBoxItem">
                                    <Setter Property="IsEnabled"
                                            Value="{ReflectionBinding IsEnabled}"/>
                                    <Setter Property="ToolTip.Tip"
                                            Value="{ReflectionBinding Hint}"/>
                                    <Setter Property="ToolTip.ShowOnDisabled"
                                            Value="True"/>
                                </Style>
                            </ComboBox.Styles>
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScopeOption">
                                    <TextBlock Text="{Binding DisplayName}"
                                               ToolTip.Tip="{Binding Hint}"
                                               ToolTip.ShowOnDisabled="True"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Grid>
                            <views:HistogramView
                                x:Name="DevelopHistogram"
                                Histogram="{Binding EffectiveHistogram}"
                                Clipping="{Binding DisplayClippingStats}"
                                ClippingIsRawSource="{Binding DisplayClippingIsRawSource}"
                                ShowDisplayClippingIndicators="True"
                                IsVisible="{Binding IsHistogramScopeEffective}"/>
                            <views:WaveformView
                                x:Name="DevelopWaveform"
                                Waveform="{Binding EffectiveWaveform}"
                                IsVisible="{Binding IsWaveformScopeEffective}"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <ProgressBar Name="BaseArmingProgressBar"
                             Grid.Row="1"
                             IsIndeterminate="{Binding IsBaseArming}"
                             IsVisible="{Binding IsBaseArming}"
                             Height="2"/>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="15,5,15,15"
                            Spacing="4"
                            IsEnabled="{Binding HasSelectedImage}">
                        <views:RawProfilePicker/>

                        <TextBlock x:Name="WhiteBalanceHeading"
                                   Classes="section-label"
                                   Text="WHITE BALANCE"
                                   Margin="0,2,0,12"/>

                        <Grid ColumnDefinitions="*,Auto,Auto"
                              Height="28"
                              Margin="0,0,0,8">
                            <ComboBox x:Name="WhiteBalanceModeBox"
                                      Grid.Column="0"
                                      Classes="edit-dropdown"
                                      ItemsSource="{Binding WhiteBalanceModeOptions}"
                                      SelectedItem="{Binding SelectedWhiteBalanceMode, Mode=TwoWay}"/>
                            <Button x:Name="WhiteBalanceAutoButton"
                                    Grid.Column="1"
                                    Classes="wb-auto"
                                    Command="{Binding AutoWhiteBalanceCommand}"
                                    Content="Auto"
                                    Margin="6,0,0,0"
                                    ToolTip.Tip="Automatic white balance"/>
                            <ToggleButton x:Name="WhiteBalancePickerButton"
                                          Grid.Column="2"
                                          Classes="wb-picker"
                                          Command="{Binding ToggleWhiteBalancePickerCommand}"
                                          IsChecked="{Binding IsWhiteBalancePicking, Mode=OneWay}"
                                          Margin="4,0,0,0"
                                          ToolTip.Tip="White balance eyedropper (W)">
                                <Viewbox Width="16" Height="16">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="{StaticResource Primary}"
                                              StrokeThickness="1.8"
                                              StrokeLineCap="Round"
                                              StrokeJoin="Round"
                                              Data="M2,22 L3,21 L6,21 L15,12 M3,21 L3,18 L12,9 M15,6 L18.4,2.6 C19.2,1.8 20.5,1.8 21.3,2.6 C22.1,3.4 22.1,4.7 21.3,5.5 L18,9 Z M15,6 L12,9 L15,12 L18,9 Z"/>
                                    </Canvas>
                                </Viewbox>
                            </ToggleButton>
                        </Grid>

                        <views:CompactSlider Label="Kelvin"
                                             Value="{Binding WhiteBalanceKelvinPosition}"
                                             Minimum="0"
                                             Maximum="1"
                                             SmallChange="0.005"
                                             DisplayText="{Binding WhiteBalanceKelvinText}"
                                             ShowValueFill="False">
                            <views:CompactSlider.TrackBrush>
                                <LinearGradientBrush StartPoint="0%,50%"
                                                     EndPoint="100%,50%">
                                    <GradientStop Color="{StaticResource WhiteBalanceCoolColor}"
                                                  Offset="0"/>
                                    <GradientStop Color="{StaticResource WhiteBalanceNeutralColor}"
                                                  Offset="0.55"/>
                                    <GradientStop Color="{StaticResource WhiteBalanceWarmColor}"
                                                  Offset="1"/>
                                </LinearGradientBrush>
                            </views:CompactSlider.TrackBrush>
                        </views:CompactSlider>

                        <views:CompactSlider Label="Tint"
                                             Value="{Binding WhiteBalanceTint}"
                                             Minimum="-100"
                                             Maximum="100"
                                             SmallChange="1"
                                             DisplayText="{Binding WhiteBalanceTintText}"
                                             ShowValueFill="False">
                            <views:CompactSlider.TrackBrush>
                                <LinearGradientBrush StartPoint="0%,50%"
                                                     EndPoint="100%,50%">
                                    <GradientStop Color="{StaticResource WhiteBalanceTintGreenColor}"
                                                  Offset="0"/>
                                    <GradientStop Color="{StaticResource WhiteBalanceTintNeutralColor}"
                                                  Offset="0.5"/>
                                    <GradientStop Color="{StaticResource WhiteBalanceTintMagentaColor}"
                                                  Offset="1"/>
                                </LinearGradientBrush>
                            </views:CompactSlider.TrackBrush>
                        </views:CompactSlider>

                        <TextBlock Classes="section-label"
                                   Text="ADJUSTMENTS"
                                   Margin="0,20,0,8"/>

                        <views:CompactSlider Label="Exposure"
                                             Value="{Binding Exposure}"
                                             Minimum="-3"
                                             Maximum="3"
                                             SmallChange="0.05"
                                             StringFormat="{}{0:F2}"
                                             EnableDoubleClickReset="True"/>
                        <views:CompactSlider x:Name="BrightnessSlider"
                                             Classes="crossing-dependent"
                                             Label="Brightness"
                                             Value="{Binding Brightness}"
                                             IsEnabled="{Binding IsBrightnessEnabled}"
                                             Minimum="-100"
                                             Maximum="100"
                                             SmallChange="1"
                                             EnableDoubleClickReset="True"/>
                        <views:CompactSlider Label="Contrast"
                                             Value="{Binding Contrast}"
                                             Minimum="-100"
                                             Maximum="100"
                                             SmallChange="1"
                                             EnableDoubleClickReset="True"/>
                        <views:CompactSlider Label="Saturation"
                                             Value="{Binding Saturation}"
                                             Minimum="-100"
                                             Maximum="100"
                                             SmallChange="1"
                                             EnableDoubleClickReset="True"/>
                        <views:CompactSlider Label="Vibrance"
                                             Value="{Binding Vibrance}"
                                             Minimum="-100"
                                             Maximum="100"
                                             SmallChange="1"
                                             EnableDoubleClickReset="True"/>
                        <views:CompactSlider Label="Shadows"
                                             Value="{Binding Shadows}"
                                             Minimum="-100"
                                             Maximum="100"
                                             SmallChange="1"
                                             EnableDoubleClickReset="True"/>
                        <views:CompactSlider Label="Highlights"
                                             Value="{Binding Highlights}"
                                             Minimum="-100"
                                             Maximum="100"
                                             SmallChange="1"
                                             EnableDoubleClickReset="True"/>

                        <Grid x:Name="HighlightHandlingRow"
                              Classes="highlight-handling-row"
                              ColumnDefinitions="70,*,40"
                              Height="26"
                              Margin="0,0,0,4"
                              IsEnabled="{Binding IsHighlightHandlingEnabled}">
                            <TextBlock Classes="edit-control-label"
                                       Text="Recovery"/>
                            <ListBox x:Name="HighlightHandlingControl"
                                     Grid.Column="1"
                                     Margin="8,0"
                                     Classes="highlight-handling"
                                     ItemsSource="{Binding HighlightHandlingOptions}"
                                     SelectedItem="{Binding HlReconstruction, Mode=TwoWay}"
                                     SelectionMode="Single,AlwaysSelected"
                                     AutomationProperties.Name="Recovery">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" ColumnSpacing="2"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static views:DevelopEditPanel.HighlightHandlingLabelConverter}}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Padding="5,1"
                                    BorderBrush="{DynamicResource OutlineVariant}"
                                    BorderThickness="1"
                                    CornerRadius="99">
                                <TextBlock Text="RAW"
                                           FontFamily="{StaticResource FontLabel}"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1"
                                           Foreground="{DynamicResource TextMuted}"/>
                            </Border>
                        </Grid>

                        <views:CurveView x:Name="ToneCurveView"
                                         Curve="{Binding CurrentCurve}" CompositeCurve="{Binding CompositeCurve}" ActiveChannel="{Binding ActiveCurveChannel, Mode=TwoWay}"
                                         HasRedCurve="{Binding HasRedCurve}" HasGreenCurve="{Binding HasGreenCurve}" HasBlueCurve="{Binding HasBlueCurve}" CurveEditStarted="OnCurveEditStarted" CurveChanged="OnCurveChanged"
                                         Margin="0,20,0,0"
                                         Height="180"/>

                        <views:DetailEditGroup x:Name="DetailEditGroup"/>
                        <views:EffectsEditGroup x:Name="EffectsEditGroup"/>

                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2"
                  Margin="15,8,15,15"
                  ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                    <ToggleButton x:Name="BeforeAfterButton"
                                  Classes="develop-action"
                                  IsChecked="{Binding IsShowingOriginal, Mode=OneWay}"
                                  Command="{Binding ToggleBeforeAfterCommand}"
                                  ToolTip.Tip="Toggle original preview (B)"
                                  AutomationProperties.Name="Toggle original preview">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="16" Height="16">
                                <Path Fill="Transparent"
                                      Data="M 1,8 C 2.8,5.2 5.1,3.8 8,3.8 C 10.9,3.8 13.2,5.2 15,8 C 13.2,10.8 10.9,12.2 8,12.2 C 5.1,12.2 2.8,10.8 1,8 Z M 8,5.8 A 2.2,2.2 0 1 1 7.99,5.8"
                                      StrokeThickness="1.4"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>
                    <Button x:Name="UndoEditButton"
                            Classes="develop-action"
                            Command="{Binding UndoCommand}"
                            IsEnabled="{Binding CanUndo}"
                            ToolTip.Tip="Undo (Ctrl+Z)"
                            AutomationProperties.Name="Undo edit">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="16" Height="16">
                                <Path Fill="Transparent"
                                      Data="M 6,3.5 L 2,7.5 L 6,11.5 M 2,7.5 L 9,7.5 C 12,7.5 14,9.5 14,12.5"
                                      StrokeThickness="1.5"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="RedoEditButton"
                            Classes="develop-action"
                            Command="{Binding RedoCommand}"
                            IsEnabled="{Binding CanRedo}"
                            ToolTip.Tip="Redo (Ctrl+Y / Ctrl+Shift+Z)"
                            AutomationProperties.Name="Redo edit">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="16" Height="16">
                                <Path Fill="Transparent"
                                      Data="M 10,3.5 L 14,7.5 L 10,11.5 M 14,7.5 L 7,7.5 C 4,7.5 2,9.5 2,12.5"
                                      StrokeThickness="1.5"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
                <Button x:Name="ResetAdjustmentsButton"
                        Grid.Column="2"
                        Classes="develop-reset"
                        VerticalAlignment="Center"
                        Command="{Binding ResetEditsCommand}"
                        Content="RESET"
                        ToolTip.Tip="Reset adjustments; crop and rotation are preserved"
                        AutomationProperties.Name="Reset adjustments"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
