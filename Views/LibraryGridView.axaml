<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="using:HappyPhoton.Converters"
             xmlns:models="using:HappyPhoton.Models"
             xmlns:views="using:HappyPhoton.Views"
             xmlns:vm="using:HappyPhoton.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="HappyPhoton.Views.LibraryGridView"
             x:Name="Root"
             x:DataType="vm:MainWindowViewModel"
             Focusable="True"
             Background="{StaticResource SurfaceBase}">

    <UserControl.Resources>
        <converters:BurstColorConverter x:Key="BurstColorConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.filter">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>
        <Style Selector="Button.filter:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceHigh}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style Selector="Button.filter.active">
            <Setter Property="Background" Value="{StaticResource PrimaryContainer}"/>
            <Setter Property="Foreground" Value="{StaticResource OnPrimary}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.filter.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PrimaryContainer}"/>
            <Setter Property="Foreground" Value="{StaticResource OnPrimary}"/>
        </Style>
        <Style Selector="Border.burst-stripe">
            <Setter Property="Opacity" Value="0.65"/>
        </Style>
        <Style Selector="Border.burst-stripe.highlighted">
            <Setter Property="Opacity" Value="1.0"/>
        </Style>
        <Style Selector="RadioButton.thumbnail-size">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Opacity" Value="0.62"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.thumbnail-size:pointerover">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Opacity" Value="0.86"/>
        </Style>
        <Style Selector="RadioButton.thumbnail-size:checked">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryContainer}"/>
            <Setter Property="Opacity" Value="0.82"/>
        </Style>
        <Style Selector="RadioButton.thumbnail-size:checked:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryContainer}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="RadioButton.thumbnail-size:focus-visible">
            <Setter Property="Background" Value="{StaticResource SurfaceHigh}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Selection Controls -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceMid}" Padding="10,8"
                BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1"
                x:Name="SelectionBar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="Filter" FontSize="10" Foreground="{StaticResource TextMuted}" FontFamily="{StaticResource FontLabel}"
                           VerticalAlignment="Center" Margin="0,0,7,0"/>

                <ScrollViewer Grid.Column="1"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Button x:Name="FilterAllButton" Content="All" Classes="filter"
                                Click="OnFilterAllClick"/>
                        <Button x:Name="FilterRawButton" Content="RAW" Classes="filter"
                                Click="OnFilterRawClick"/>
                        <Button x:Name="FilterJpegButton" Content="JPEG" Classes="filter"
                                Click="OnFilterJpegClick"/>
                        <Rectangle Width="1" Fill="{StaticResource Outline}" Margin="5,2"/>
                        <TextBlock Text="Flag" FontSize="10" Foreground="{StaticResource TextMuted}" FontFamily="{StaticResource FontLabel}"
                                   VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <Button x:Name="FlagFilterAllButton" Content="All" Classes="filter"
                                Click="OnFlagFilterAllClick"/>
                        <Button x:Name="FlagFilterPickedButton" Content="Picked" Classes="filter"
                                Click="OnFlagFilterPickedClick"/>
                        <Button x:Name="FlagFilterRejectedButton" Content="Rejected" Classes="filter"
                                Click="OnFlagFilterRejectedClick"/>
                        <Rectangle Width="1" Fill="{StaticResource Outline}" Margin="5,2"/>
                        <TextBlock Text="Rating" FontSize="10" Foreground="{StaticResource TextMuted}" FontFamily="{StaticResource FontLabel}"
                                   VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <Button x:Name="RatingFilterAllButton" Content="All" Classes="filter"
                                Click="OnRatingFilterAllClick"/>
                        <Button x:Name="RatingFilter1Button" Content="1+" Classes="filter"
                                Click="OnRatingFilter1Click"/>
                        <Button x:Name="RatingFilter2Button" Content="2+" Classes="filter"
                                Click="OnRatingFilter2Click"/>
                        <Button x:Name="RatingFilter3Button" Content="3+" Classes="filter"
                                Click="OnRatingFilter3Click"/>
                        <Button x:Name="RatingFilter4Button" Content="4+" Classes="filter"
                                Click="OnRatingFilter4Click"/>
                        <Button x:Name="RatingFilter5Button" Content="5" Classes="filter"
                                Click="OnRatingFilter5Click"/>
                        <Rectangle Width="1" Fill="{StaticResource Outline}" Margin="5,2"/>
                        <Button x:Name="BurstsButton" Content="Bursts" Classes="filter"
                                Click="OnBurstsClick"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5"
                            Margin="10,0,0,0">
                    <Rectangle Width="1" Fill="{StaticResource Outline}" Margin="0,2,5,2"/>
                    <Button Content="Select All" FontSize="10" Padding="8,4"
                            IsEnabled="{Binding HasSelectedImage}"
                            Click="OnSelectAllClick"/>
                    <Button Content="Select None" FontSize="10" Padding="8,4"
                            IsEnabled="{Binding HasSelectedImage}"
                            Click="OnDeselectAllClick"/>
                    <Button Content="Export…" FontSize="10" Padding="10,4"
                            Classes="accent"
                            ToolTip.Tip="Export (Ctrl+E)"
                            Click="OnBatchExportClick"/>
                    <Button Content="…" FontSize="14" Width="30" Padding="4,0"
                            IsEnabled="{Binding HasSelectedImage}"
                            ToolTip.Tip="More library actions"
                            AutomationProperties.Name="More library actions">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Delete Rejected…"
                                          Click="OnDeleteRejectedClick"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Thumbnail Grid with Virtualization -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden"
                      x:Name="ThumbnailScrollViewer">
            <ItemsRepeater x:Name="ThumbnailGrid" Margin="5">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="{Binding ThumbnailItemWidth, ElementName=Root}"
                                       MinItemHeight="{Binding ThumbnailItemHeight, ElementName=Root}"
                                       MinRowSpacing="5" MinColumnSpacing="5"
                                       ItemsStretch="None"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate DataType="models:ImageFile">
                        <Border Padding="5" CornerRadius="8"
                                PointerPressed="OnThumbnailPointerPressed"
                                PointerEntered="OnThumbnailPointerEntered"
                                PointerExited="OnThumbnailPointerExited"
                                DoubleTapped="OnThumbnailDoubleTapped"
                                Background="{Binding IsSelected, Converter={StaticResource SelectionBackgroundConverter}}"
                                BorderThickness="2"
                                BorderBrush="{Binding IsActive, Converter={StaticResource ActiveBorderConverter}}">
                            <Border.Styles>
                                <Style Selector="Border:pointerover">
                                    <Setter Property="Background" Value="{StaticResource SurfaceHigh}"/>
                                </Style>
                            </Border.Styles>
                            <StackPanel>
                                <Panel Width="{Binding $parent[views:LibraryGridView].ImageViewportWidth}"
                                       Height="{Binding $parent[views:LibraryGridView].ImageViewportHeight}">
                                    <!-- Background: darker blue-gray for RAW, standard for others -->
                                    <Border Background="{StaticResource RawFileBackground}" CornerRadius="8"
                                            IsVisible="{Binding IsRaw}" ToolTip.Tip="RAW file"/>
                                    <Border Background="{StaticResource SurfaceHigh}" CornerRadius="8"
                                            IsVisible="{Binding !IsRaw}"/>
                                    <!-- Thumbnail content -->
                                    <Border CornerRadius="8" ClipToBounds="True">
                                        <Panel>
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="Uniform"
                                                   IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                            <ProgressBar IsIndeterminate="True"
                                                         IsVisible="{Binding IsLoading}"
                                                         Width="50" Height="4"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                                            <StackPanel IsVisible="{Binding ShowCloudPlaceholder}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Spacing="2">
                                                <TextBlock Text="☁" FontSize="24"
                                                           Foreground="{StaticResource PrimaryContainer}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="ONLINE" FontSize="9"
                                                           FontFamily="{StaticResource FontLabel}"
                                                           Foreground="{StaticResource TextMuted}"/>
                                            </StackPanel>
                                        </Panel>
                                    </Border>
                                    <Border Background="{StaticResource SurfaceHighest}"
                                            BorderBrush="{StaticResource PrimaryContainer}"
                                            BorderThickness="1"
                                            CornerRadius="999"
                                            Padding="5,1"
                                            Margin="0,5,5,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            IsVisible="{Binding SourceRequiresHydration}"
                                            ToolTip.Tip="Online-only original">
                                        <TextBlock Text="☁" FontSize="10"
                                                   Foreground="{StaticResource PrimaryContainer}"/>
                                    </Border>
                                    <Border Width="4" HorizontalAlignment="Left"
                                            CornerRadius="2,0,0,2"
                                            Classes="burst-stripe"
                                            Classes.highlighted="{Binding IsBurstHighlighted}"
                                            IsVisible="{Binding HasBurstGroup}"
                                            IsHitTestVisible="False"
                                            Background="{Binding BurstColorIndex, Converter={StaticResource BurstColorConverter}}"/>
                                </Panel>
                                <Grid Width="{Binding $parent[views:LibraryGridView].ImageViewportWidth}"
                                      Margin="0,5,0,0"
                                      RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding FileName}"
                                               FontSize="11" Foreground="{StaticResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding FileName}"/>
                                    <Border Grid.Row="0" Grid.Column="1"
                                            Background="{StaticResource Tertiary}"
                                            CornerRadius="{StaticResource RadiusSmall}"
                                            Padding="4,1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="6,0,8,0"
                                            IsVisible="{Binding HasEdits}"
                                            ToolTip.Tip="Has edits">
                                        <TextBlock Text="EDIT" FontSize="9" FontWeight="SemiBold"
                                                   FontFamily="{StaticResource FontLabel}"
                                                   Foreground="{StaticResource SurfaceBase}"/>
                                    </Border>
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                                                Orientation="Horizontal" Spacing="3" Margin="0,2,0,0">
                                        <Border Background="{StaticResource PrimaryContainer}" CornerRadius="2"
                                                Padding="3,0"
                                                IsVisible="{Binding IsPicked}"
                                                ToolTip.Tip="Picked">
                                            <TextBlock Text="P" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{StaticResource OnPrimary}"/>
                                        </Border>
                                        <Border Background="{StaticResource ErrorContainer}" CornerRadius="2"
                                                Padding="3,0"
                                                IsVisible="{Binding IsRejected}"
                                                ToolTip.Tip="Rejected">
                                            <TextBlock Text="X" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{StaticResource OnErrorContainer}"/>
                                        </Border>
                                        <TextBlock Text="{Binding RatingStars}"
                                                   FontSize="10" Foreground="{StaticResource SecondaryContainer}"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding HasRating}"
                                                   ToolTip.Tip="Rating"/>
                                        <Border CornerRadius="2" Padding="3,0"
                                                IsVisible="{Binding HasBurstGroup}"
                                                Background="{Binding BurstColorIndex, Converter={StaticResource BurstColorConverter}}"
                                                ToolTip.Tip="Burst frame">
                                            <TextBlock Text="{Binding BurstChipText}" FontSize="9"
                                                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel Grid.Row="1"
                    x:Name="EmptyState"
                    IsVisible="False"
                    Spacing="8"
                    MaxWidth="520"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock x:Name="EmptyHeading"
                       Text="Select a folder to view photographs"
                       FontFamily="{StaticResource FontHeading}"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="16"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="EmptyMessage"
                       Text="Choose a folder in the folder tree."
                       Foreground="{StaticResource TextMuted}"
                       FontSize="12"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBase}"
                BorderBrush="{StaticResource Divider}"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <Grid ColumnDefinitions="*,Auto,*">
                <TextBlock Grid.Column="0"
                           x:Name="OnlineOnlyMessage"
                           Text="{Binding OnlineOnlyMessage}"
                           IsVisible="{Binding HasOnlineOnlyPhotos}"
                           Foreground="{StaticResource TextSecondary}"
                           FontFamily="{StaticResource FontLabel}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding OnlineOnlyMessage}"/>
                <views:ImageAssessmentControl Grid.Column="1"
                                              IsEnabled="{Binding HasSelectedImage}"
                                              HorizontalAlignment="Center"/>
                <StackPanel Grid.Column="2"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="2">
                        <RadioButton x:Name="SmallThumbnailButton"
                                     GroupName="LibraryThumbnailSize"
                                     Classes="thumbnail-size"
                                     Click="OnSmallThumbnailClick"
                                     ToolTip.Tip="Small thumbnails"
                                     AutomationProperties.Name="Small thumbnails">
                            <PathIcon Width="12"
                                      Height="12"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M1 1h3v3H1z M6.5 1h3v3h-3z M12 1h3v3h-3z M1 6.5h3v3H1z M6.5 6.5h3v3h-3z M12 6.5h3v3h-3z M1 12h3v3H1z M6.5 12h3v3h-3z M12 12h3v3h-3z"/>
                        </RadioButton>
                        <RadioButton x:Name="MediumThumbnailButton"
                                     GroupName="LibraryThumbnailSize"
                                     Classes="thumbnail-size"
                                     Click="OnMediumThumbnailClick"
                                     ToolTip.Tip="Medium thumbnails"
                                     AutomationProperties.Name="Medium thumbnails">
                            <PathIcon Width="12"
                                      Height="12"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M1 1h6v6H1z M9 1h6v6H9z M1 9h6v6H1z M9 9h6v6H9z"/>
                        </RadioButton>
                        <RadioButton x:Name="LargeThumbnailButton"
                                     GroupName="LibraryThumbnailSize"
                                     Classes="thumbnail-size"
                                     Click="OnLargeThumbnailClick"
                                     ToolTip.Tip="Large thumbnails"
                                     AutomationProperties.Name="Large thumbnails">
                            <PathIcon Width="12"
                                      Height="12"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M1 2h14v5H1z M1 9h14v5H1z"/>
                        </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <views:WorkflowCoachmark
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="12"
            IsVisible="{Binding IsChooseWhatMattersTourVisible}"
            StepText="1 of 3"
            Heading="Curate your images"
            Body="Use the controls below to pick, reject, and curate your photographs"
            PrimaryText="Show me Develop"
            PrimaryCommand="{Binding ShowDevelopTourStepCommand}"
            SecondaryText="End tour"
            SecondaryCommand="{Binding EndWorkflowTourCommand}"/>

        <views:WorkflowCoachmark
            Grid.Row="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="12"
            IsVisible="{Binding IsDeliverCopiesTourVisible}"
            StepText="3 of 3"
            Heading="Export the edited images"
            Body="Select the photographs you curated, then use the Export button to save edited copies to disk. Originals remain untouched."
            PrimaryText="Open export dialog"
            PrimaryCommand="{Binding OpenExportFromTourCommand}"
            SecondaryText="Finish"
            SecondaryCommand="{Binding FinishWorkflowTourCommand}"/>
    </Grid>

</UserControl>
