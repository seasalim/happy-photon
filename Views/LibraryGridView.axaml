<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="using:HappyPhoton.Converters"
             xmlns:models="using:HappyPhoton.Models"
             xmlns:views="using:HappyPhoton.Views"
             xmlns:vm="using:HappyPhoton.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="HappyPhoton.Views.LibraryGridView"
             x:Name="Root"
             x:DataType="vm:MainWindowViewModel"
             Focusable="True"
             Background="{DynamicResource ViewerSurround}">

    <UserControl.Resources>
        <converters:BurstColorConverter x:Key="BurstColorConverter"/>
        <converters:ColorLabelBrushConverter x:Key="ColorLabelBrushConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://HappyPhoton/Views/LibraryFilterBarStyles.axaml"/>
        <Style Selector="Border.burst-stripe">
            <Setter Property="Opacity" Value="0.65"/>
        </Style>
        <Style Selector="Border.burst-stripe.highlighted">
            <Setter Property="Opacity" Value="1.0"/>
        </Style>
        <Style Selector="Border.thumbnail">
            <Setter Property="Background" Value="{DynamicResource SurfaceLow}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Border.thumbnail:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
        </Style>
        <Style Selector="Border.thumbnail.selected">
            <Setter Property="Background" Value="{DynamicResource SelectionSurface}"/>
        </Style>
        <Style Selector="Border.thumbnail.active">
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryContainer}"/>
        </Style>
        <Style Selector="RadioButton.thumbnail-size">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Opacity" Value="0.62"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.thumbnail-size:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Opacity" Value="0.86"/>
        </Style>
        <Style Selector="RadioButton.thumbnail-size:checked">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryContainer}"/>
            <Setter Property="Opacity" Value="0.82"/>
        </Style>
        <Style Selector="RadioButton.thumbnail-size:checked:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryContainer}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="RadioButton.thumbnail-size:focus-visible">
            <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Selection Controls -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceMid}" Padding="8,4"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1"
                x:Name="SelectionBar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock x:Name="FilterLabel"
                           Classes="tour-region"
                           Classes.tour-dimmed="{Binding IsWorkflowTourPresented}"
                           Text="Filter" FontSize="10" Foreground="{DynamicResource TextMuted}" FontFamily="{StaticResource FontLabel}"
                           VerticalAlignment="Center" Margin="0,0,7,0"/>

                <ScrollViewer x:Name="FilterScrollViewer"
                              Grid.Column="1"
                              Classes="tour-region"
                              Classes.tour-dimmed="{Binding IsWorkflowTourPresented}"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Button x:Name="FilterAllButton" Content="All" Classes="filter"
                                Click="OnFilterAllClick"/>
                        <Button x:Name="FilterRawButton" Content="RAW" Classes="filter"
                                Click="OnFilterRawClick"/>
                        <Button x:Name="FilterJpegButton" Content="JPEG" Classes="filter"
                                Click="OnFilterJpegClick"/>
                        <Rectangle Width="1" Fill="{DynamicResource Outline}" Margin="5,2"/>
                        <TextBlock Text="Flag" FontSize="10" Foreground="{DynamicResource TextMuted}" FontFamily="{StaticResource FontLabel}"
                                   VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <Button x:Name="FlagFilterAllButton" Content="All" Classes="filter"
                                Click="OnFlagFilterAllClick"/>
                        <Button x:Name="FlagFilterPickedButton" Content="Picked" Classes="filter"
                                Click="OnFlagFilterPickedClick"/>
                        <Button x:Name="FlagFilterRejectedButton" Content="Rejected" Classes="filter"
                                Click="OnFlagFilterRejectedClick"/>
                        <Rectangle Width="1" Fill="{DynamicResource Outline}" Margin="5,2"/>
                        <TextBlock Text="Rating" FontSize="10" Foreground="{DynamicResource TextMuted}" FontFamily="{StaticResource FontLabel}"
                                   VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <Button x:Name="RatingFilterAllButton" Content="All" Classes="filter"
                                Click="OnRatingFilterAllClick"/>
                        <views:LibraryRatingFilter x:Name="RatingFilter"
                            MinimumRating="{Binding MinimumRating, ElementName=Root, Mode=TwoWay}"/>
                        <views:LibraryColorLabelFilter
                            x:Name="ColorLabelFilterControl"
                            Choices="{Binding ColorLabelFilterChoices}"
                            Filter="{Binding ColorLabelFilter, ElementName=Root, Mode=TwoWay}"/>
                        <Rectangle Width="1" Fill="{DynamicResource Outline}" Margin="5,2"/>
                        <Button x:Name="BurstsButton" Classes="filter-icon"
                                Click="OnBurstsClick"
                                ToolTip.Tip="Group bursts"
                                AutomationProperties.Name="Group bursts">
                            <PathIcon Width="18" Height="18"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M0 5V0h13v2H2v3z M2 7V2h14v2H4v3z M4 5h14v2H4z M4 16h14v2H4z M4 7h2v9H4z M16 7h2v9h-2z M7 8h2v2H7z M7 14l2.5-3 2 2 1.5-2 2.5 3z"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="LibraryActionsPanel"
                            Grid.Column="2" Orientation="Horizontal" Spacing="5"
                            Margin="10,0,0,0"
                            Classes="tour-region tour-glow"
                            Classes.tour-dimmed="{Binding IsWorkflowTourPresented}"
                            Classes.tour-focus="{Binding IsDeliverCopiesTourVisible}">
                    <Rectangle Width="1" Fill="{DynamicResource Outline}" Margin="0,2,5,2"/>
                    <TextBlock Text="Select" FontSize="10" Foreground="{DynamicResource TextMuted}"
                               FontFamily="{StaticResource FontLabel}"
                               VerticalAlignment="Center" Margin="0,0,2,0"/>
                    <Button x:Name="SelectAllButton" Content="All" FontSize="10" Padding="8,4"
                            IsEnabled="{Binding HasSelectedImage}"
                            Click="OnSelectAllClick"/>
                    <Button x:Name="SelectNoneButton" Content="None" FontSize="10" Padding="8,4"
                            IsEnabled="{Binding HasSelectedImage}"
                            Click="OnDeselectAllClick"/>
                    <Button Content="Export…" FontSize="10" Padding="10,4"
                            Classes="accent"
                            ToolTip.Tip="Export (Ctrl+E)"
                            Click="OnBatchExportClick"/>
                    <Button Content="…" FontSize="14" Width="30" Padding="4,0"
                            IsEnabled="{Binding HasSelectedImage}"
                            ToolTip.Tip="More library actions"
                            AutomationProperties.Name="More library actions">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Delete Rejected…"
                                          Click="OnDeleteRejectedClick"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Thumbnail Grid with Virtualization -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden"
                      x:Name="ThumbnailScrollViewer">
            <ItemsRepeater x:Name="ThumbnailGrid" Margin="5">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="{Binding ThumbnailItemWidth, ElementName=Root}"
                                       MinItemHeight="{Binding ThumbnailItemHeight, ElementName=Root}"
                                       MinRowSpacing="5" MinColumnSpacing="5"
                                       ItemsStretch="None"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate DataType="models:ImageFile">
                        <Border Padding="5" CornerRadius="8"
                                Classes="thumbnail"
                                Classes.selected="{Binding IsSelected}"
                                Classes.active="{Binding IsActive}"
                                PointerPressed="OnThumbnailPointerPressed"
                                PointerEntered="OnThumbnailPointerEntered"
                                PointerExited="OnThumbnailPointerExited"
                                DoubleTapped="OnThumbnailDoubleTapped"
                                BorderThickness="3">
                            <StackPanel>
                                <Panel Width="{Binding $parent[views:LibraryGridView].ImageViewportWidth}"
                                       Height="{Binding $parent[views:LibraryGridView].ImageViewportHeight}">
                                    <!-- Background: darker blue-gray for RAW, standard for others -->
                                    <Border Background="{DynamicResource RawFileBackground}" CornerRadius="8"
                                            IsVisible="{Binding IsRaw}" ToolTip.Tip="RAW file"/>
                                    <Border Background="{DynamicResource SurfaceHigh}" CornerRadius="8"
                                            IsVisible="{Binding !IsRaw}"/>
                                    <!-- Thumbnail content -->
                                    <Border CornerRadius="8" ClipToBounds="True">
                                        <Panel>
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="Uniform"
                                                   IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                            <Border Name="TileLoadingPlaceholder"
                                                    Background="{DynamicResource SurfaceHighest}"
                                                    IsVisible="{Binding IsLoading}"
                                                    Width="50" Height="4"
                                                    CornerRadius="2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                            <StackPanel IsVisible="{Binding ShowCloudPlaceholder}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Spacing="2">
                                                <TextBlock Text="☁" FontSize="24"
                                                           Foreground="{StaticResource PrimaryContainer}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="ONLINE" FontSize="9"
                                                           FontFamily="{StaticResource FontLabel}"
                                                           Foreground="{DynamicResource TextMuted}"/>
                                            </StackPanel>
                                        </Panel>
                                    </Border>
                                    <Border Background="{DynamicResource SurfaceHighest}"
                                            BorderBrush="{StaticResource PrimaryContainer}"
                                            BorderThickness="1"
                                            CornerRadius="999"
                                            Padding="5,1"
                                            Margin="0,5,5,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            IsVisible="{Binding SourceRequiresHydration}"
                                            ToolTip.Tip="Online-only original">
                                        <TextBlock Text="☁" FontSize="10"
                                                   Foreground="{StaticResource PrimaryContainer}"/>
                                    </Border>
                                    <Border Width="4" HorizontalAlignment="Left"
                                            CornerRadius="2,0,0,2"
                                            Classes="burst-stripe"
                                            Classes.highlighted="{Binding IsBurstHighlighted}"
                                            IsVisible="{Binding HasBurstGroup}"
                                            IsHitTestVisible="False"
                                            >
                                        <Border.Background>
                                            <MultiBinding Converter="{StaticResource BurstColorConverter}">
                                                <Binding Path="BurstColorIndex"/>
                                                <Binding Path="$parent[views:LibraryGridView].ActualThemeVariant"/>
                                            </MultiBinding>
                                        </Border.Background>
                                    </Border>
                                    <Border Width="14" Height="14"
                                            CornerRadius="999"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,6,6"
                                            BorderBrush="{DynamicResource SurfaceLowest}"
                                            BorderThickness="1.5"
                                            IsVisible="{Binding HasColorLabel}"
                                            IsHitTestVisible="False"
                                            ToolTip.Tip="Color label"
                                            Background="{Binding ColorLabel, Converter={StaticResource ColorLabelBrushConverter}}"/>
                                    <Border Width="17" Height="17"
                                            CornerRadius="5"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="8,6,0,0"
                                            Opacity="0.8"
                                            Background="{DynamicResource SurfaceLowest}"
                                            BorderBrush="{StaticResource PrimaryContainer}"
                                            BorderThickness="1.5"
                                            IsVisible="{Binding IsSelected}"
                                            IsHitTestVisible="False">
                                        <Path Data="M 3,7.5 L 6.5,11 L 12,4"
                                              Stretch="Uniform" Width="9" Height="7"
                                              Stroke="{StaticResource PrimaryContainer}"
                                              StrokeThickness="1.8"
                                              StrokeLineCap="Round"
                                              StrokeJoin="Round"/>
                                    </Border>
                                </Panel>
                                <Grid Width="{Binding $parent[views:LibraryGridView].ImageViewportWidth}"
                                      Margin="0,5,0,0"
                                      RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding FileName}"
                                               FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding FileName}"/>
                                    <Border Grid.Row="0" Grid.Column="1"
                                            Background="{StaticResource Tertiary}"
                                            CornerRadius="{StaticResource RadiusSmall}"
                                            Padding="4,1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="6,0,8,0"
                                            IsVisible="{Binding HasEdits}"
                                            ToolTip.Tip="Has edits">
                                        <TextBlock Text="EDIT" FontSize="9" FontWeight="SemiBold"
                                                   FontFamily="{StaticResource FontLabel}"
                                                   Foreground="{StaticResource OnTertiary}"/>
                                    </Border>
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                                                Orientation="Horizontal" Spacing="3" Margin="0,2,0,0">
                                        <Border Background="{StaticResource PrimaryContainer}" CornerRadius="2"
                                                Padding="3,0"
                                                IsVisible="{Binding IsPicked}"
                                                ToolTip.Tip="Picked">
                                            <TextBlock Text="P" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{StaticResource OnPrimary}"/>
                                        </Border>
                                        <Border Background="{StaticResource ErrorContainer}" CornerRadius="2"
                                                Padding="3,0"
                                                IsVisible="{Binding IsRejected}"
                                                ToolTip.Tip="Rejected">
                                            <TextBlock Text="X" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{StaticResource OnErrorContainer}"/>
                                        </Border>
                                        <TextBlock Text="{Binding RatingStars}"
                                                   FontSize="10" Foreground="{StaticResource SecondaryContainer}"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding HasRating}"
                                                   ToolTip.Tip="Rating"/>
                                        <Border CornerRadius="2" Padding="3,0"
                                                IsVisible="{Binding HasBurstGroup}"
                                                ToolTip.Tip="Burst frame">
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource BurstColorConverter}">
                                                    <Binding Path="BurstColorIndex"/>
                                                    <Binding Path="$parent[views:LibraryGridView].ActualThemeVariant"/>
                                                </MultiBinding>
                                            </Border.Background>
                                            <TextBlock Text="{Binding BurstChipText}" FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="{x:Static views:HappyPhotonColors.BurstChipInk}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Empty state -->
        <Border Grid.Row="1"
                x:Name="EmptyState"
                IsVisible="False"
                Background="{DynamicResource SurfaceLow}"
                CornerRadius="{StaticResource RadiusMedium}"
                Padding="20"
                MaxWidth="520"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="8">
                <TextBlock x:Name="EmptyHeading"
                           Text="Select a folder to view photographs"
                           FontFamily="{StaticResource FontHeading}"
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="16"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="EmptyMessage"
                           Text="Choose a folder in the folder tree."
                           Foreground="{DynamicResource TextMuted}"
                           FontSize="12"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceLow}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <Grid ColumnDefinitions="*,Auto,*">
                <TextBlock Grid.Column="0"
                           x:Name="OnlineOnlyMessage"
                           Classes="tour-region"
                           Classes.tour-dimmed="{Binding IsWorkflowTourPresented}"
                           Text="{Binding OnlineOnlyMessage}"
                           IsVisible="{Binding HasOnlineOnlyPhotos}"
                           Foreground="{DynamicResource TextSecondary}"
                           FontFamily="{StaticResource FontLabel}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding OnlineOnlyMessage}"/>
                <views:ImageAssessmentControl x:Name="ImageAssessment"
                                              Grid.Column="1"
                                              Classes="tour-region tour-glow"
                                              Classes.tour-dimmed="{Binding IsWorkflowTourPresented}"
                                              Classes.tour-focus="{Binding IsChooseWhatMattersTourVisible}"
                                              IsEnabled="{Binding HasSelectedImage}"
                                              HorizontalAlignment="Center"/>
                <StackPanel x:Name="ThumbnailSizePanel"
                            Grid.Column="2"
                            Classes="tour-region"
                            Classes.tour-dimmed="{Binding IsWorkflowTourPresented}"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="2">
                        <RadioButton x:Name="SmallThumbnailButton"
                                     GroupName="LibraryThumbnailSize"
                                     Classes="thumbnail-size"
                                     Click="OnSmallThumbnailClick"
                                     ToolTip.Tip="Small thumbnails"
                                     AutomationProperties.Name="Small thumbnails">
                            <PathIcon Width="12"
                                      Height="12"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M1 1h3v3H1z M6.5 1h3v3h-3z M12 1h3v3h-3z M1 6.5h3v3H1z M6.5 6.5h3v3h-3z M12 6.5h3v3h-3z M1 12h3v3H1z M6.5 12h3v3h-3z M12 12h3v3h-3z"/>
                        </RadioButton>
                        <RadioButton x:Name="MediumThumbnailButton"
                                     GroupName="LibraryThumbnailSize"
                                     Classes="thumbnail-size"
                                     Click="OnMediumThumbnailClick"
                                     ToolTip.Tip="Medium thumbnails"
                                     AutomationProperties.Name="Medium thumbnails">
                            <PathIcon Width="12"
                                      Height="12"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M1 1h6v6H1z M9 1h6v6H9z M1 9h6v6H1z M9 9h6v6H9z"/>
                        </RadioButton>
                        <RadioButton x:Name="LargeThumbnailButton"
                                     GroupName="LibraryThumbnailSize"
                                     Classes="thumbnail-size"
                                     Click="OnLargeThumbnailClick"
                                     ToolTip.Tip="Large thumbnails"
                                     AutomationProperties.Name="Large thumbnails">
                            <PathIcon Width="12"
                                      Height="12"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M1 2h14v5H1z M1 9h14v5H1z"/>
                        </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <views:WorkflowCoachmark
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="12"
            IsVisible="{Binding IsChooseWhatMattersTourVisible}"
            Pointer="Down"
            StepText="1 of 3"
            Heading="Curate your images"
            Body="Use the controls below to pick, reject, and curate your photographs"
            PrimaryText="Show me Develop"
            PrimaryCommand="{Binding ShowDevelopTourStepCommand}"
            SecondaryText="End tour"
            SecondaryCommand="{Binding EndWorkflowTourCommand}"/>

        <views:WorkflowCoachmark
            Grid.Row="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="12"
            IsVisible="{Binding IsDeliverCopiesTourVisible}"
            Pointer="Up"
            PointerAlignment="End"
            StepText="3 of 3"
            Heading="Export the edited images"
            Body="Select the photographs you curated, then use the Export button to save edited copies to disk. Originals remain untouched."
            PrimaryText="Open export dialog"
            PrimaryCommand="{Binding OpenExportFromTourCommand}"
            SecondaryText="Finish"
            SecondaryCommand="{Binding FinishWorkflowTourCommand}"/>
    </Grid>

</UserControl>
