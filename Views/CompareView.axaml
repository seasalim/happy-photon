<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:HappyPhoton.Converters"
             xmlns:views="using:HappyPhoton.Views"
             xmlns:vm="using:HappyPhoton.ViewModels"
             x:Class="HappyPhoton.Views.CompareView"
             x:DataType="vm:MainWindowViewModel"
             Focusable="True"
             Background="{DynamicResource ViewerSurround}">
    <UserControl.Resources>
        <converters:ColorLabelBrushConverter x:Key="ColorLabelBrushConverter"/>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Border.compare-pane">
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <Style Selector="Border.compare-pane.active">
            <Setter Property="BorderBrush" Value="{DynamicResource ActiveImageRing}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="{DynamicResource SurfaceMid}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1"
                Padding="10,6">
            <Grid ColumnDefinitions="Auto,*">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Compare" Classes="section-label"/>
                    <TextBlock Text="{Binding ComparePanes.Count}"
                               Foreground="{DynamicResource TextMuted}"
                               FontFamily="{StaticResource FontLabel}" FontSize="{StaticResource FontSizeSmall}"/>
                    <TextBlock Text="photos" Classes="hint-text"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                            HorizontalAlignment="Center">
                    <Button Classes="icon-button" x:Name="ComparePreviousButton"
                            Command="{Binding SelectPreviousImageCommand}"
                            ToolTip.Tip="Previous comparison image (←)" AutomationProperties.Name="←">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="16" Height="16">
                                <Path Data="M10,3.5 L5.5,8 L10,12.5" Fill="Transparent" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Classes="icon-button" x:Name="CompareNextButton"
                            Command="{Binding SelectNextImageCommand}"
                            ToolTip.Tip="Next comparison image (→)" AutomationProperties.Name="→">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="16" Height="16">
                                <Path Data="M6,3.5 L10.5,8 L6,12.5" Fill="Transparent" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ItemsControl x:Name="PaneItems" Grid.Row="1"
                      ItemsSource="{Binding ComparePanes}" Margin="6">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ComparePaneViewModel">
                    <Border Classes="compare-pane"
                            Classes.active="{Binding Image.IsActive}"
                            Background="{DynamicResource SurfaceLowest}"
                            Margin="3">
                        <Border ClipToBounds="True">
                          <Grid RowDefinitions="*,Auto">
                            <Panel>
                                <views:PlaceholderImage Source="{Binding Image.Thumbnail}"
                                       OriginalPixelWidth="{Binding Image.PixelWidth, FallbackValue=0}"
                                       OriginalPixelHeight="{Binding Image.PixelHeight, FallbackValue=0}"
                                       Stretch="Uniform" Margin="8"
                                       RenderOptions.BitmapInterpolationMode="LowQuality"/>
                                <views:ZoomPanControl Source="{Binding Preview}"
                                                      DisplayTransform="{Binding DisplayTransform}"
                                                      SourceIdentity="{Binding Image}"
                                                      OriginalViewPixelSize="{Binding OriginalViewPixelSize}"
                                                      AutoFit="True"
                                                      ScrollBarVisibility="Hidden"
                                                      ContentInset="8"
                                                      AttachedToVisualTree="OnPaneAttached"
                                                      DetachedFromVisualTree="OnPaneDetached"/>
                                <TextBlock Text="Loading preview…"
                                           IsVisible="{Binding IsLoadingMessageVisible}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="{StaticResource FontSizeBody}"/>
                            </Panel>
                            <Border Grid.Row="1" Background="{DynamicResource SurfaceLow}"
                                    BorderBrush="{DynamicResource Divider}"
                                    BorderThickness="0,1,0,0" Padding="8,5">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Image.FileName}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontSize="{StaticResource FontSizeBody}" ToolTip.Tip="{Binding Image.FileName}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                Spacing="5" Margin="8,0,0,0">
                                        <Border Background="{DynamicResource ControlActive}" Padding="3,0"
                                                IsVisible="{Binding Image.IsPicked}">
                                            <TextBlock Text="P" FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{DynamicResource OnControlActive}"/>
                                        </Border>
                                        <Border Background="{StaticResource RejectSurface}"
                                                BorderBrush="{StaticResource RejectOutline}"
                                                BorderThickness="1" Padding="3,0"
                                                IsVisible="{Binding Image.IsRejected}">
                                            <TextBlock Text="X" FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{StaticResource RejectGlyph}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Image.RatingStars}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   IsVisible="{Binding Image.HasRating}"/>
                                        <Border Width="11" Height="11"
                                                IsVisible="{Binding Image.HasColorLabel}"
                                                Background="{Binding Image.ColorLabel, Converter={StaticResource ColorLabelBrushConverter}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                          </Grid>
                        </Border>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="2" Background="Transparent" Padding="8,4">
            <TextBlock Text="Fit · Zoom · Pan · Loupe synced"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMuted}"
                       FontFamily="{StaticResource FontBody}" FontSize="{StaticResource FontSizeSmall}"/>
        </Border>
    </Grid>
</UserControl>
