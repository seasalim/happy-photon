<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HappyPhoton.ViewModels"
             xmlns:models="using:HappyPhoton.Models"
             xmlns:views="using:HappyPhoton.Views"
             x:Class="HappyPhoton.Views.LocalsEditSection"
             x:DataType="vm:MainWindowViewModel" IsVisible="{Binding IsLocalsMode}">
    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                         ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectionSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ToggleButton.mask:checked">
            <Setter Property="Background" Value="{DynamicResource ControlActive}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnControlActive}"/>
        </Style>
        <Style Selector="ToggleButton#LocalHuePick:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlActive}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnControlActive}"/>
        </Style>
        <Style Selector="views|CompactSlider:disabled">
            <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}"/>
        </Style>
        <Style Selector="ToggleButton.geometry-disclosure Path">
            <Setter Property="Data" Value="M 0,0 L 3,3 L 0,6"/>
        </Style>
        <Style Selector="ToggleButton.geometry-disclosure:checked Path">
            <Setter Property="Data" Value="M 0,0 L 3,3 L 6,0"/>
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="8" Margin="0,0,0,12">
        <StackPanel x:Name="LocalCreationRow" Orientation="Horizontal" Spacing="5" IsEnabled="{Binding CanAddLocal}">
            <Button x:Name="AddLinearButton" Content="+ Linear" Command="{Binding AddLinearCommand}" Padding="8,4" FontSize="10"/>
            <Button x:Name="AddRadialButton" Content="+ Radial" Command="{Binding AddRadialCommand}" Padding="8,4" FontSize="10"/>
            <Button x:Name="AddBrushButton" Content="+ Brush" Command="{Binding AddBrushCommand}" Padding="8,4" FontSize="10"/>
        </StackPanel>
        <StackPanel x:Name="LocalDetailsArea" MinHeight="40" Spacing="8">
            <StackPanel x:Name="LocalEditor" Grid.IsSharedSizeScope="True" Spacing="8" IsVisible="{Binding HasLocals}">
                <ListBox x:Name="LocalList" ItemsSource="{Binding LocalRows}" SelectedItem="{Binding SelectedLocalRow}"
                         IsEnabled="{Binding CanEditLocals}" MaxHeight="120" AutomationProperties.Name="Local adjustments">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LocalRowViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="24">
                                <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Padding="0" Margin="0,0,5,0"
                                          AutomationProperties.Name="Enable local"
                                          Command="{Binding $parent[views:LocalsEditSection].((vm:MainWindowViewModel)DataContext).ToggleLocalEnabledCommand}"
                                          CommandParameter="{Binding Local}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="{Binding Glyph}" FontSize="11"/>
                                        <TextBlock Text="{Binding Name}" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding RangeLabel}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="Disabled" IsVisible="{Binding !Enabled}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="×" Padding="5,2" AutomationProperties.Name="Delete local"
                                        Command="{Binding $parent[views:LocalsEditSection].((vm:MainWindowViewModel)DataContext).DeleteLocalCommand}"
                                        CommandParameter="{Binding Local}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <views:CompactSlider Label="Exposure" Value="{Binding LocalExposure}" Minimum="-4" Maximum="4"
                                     SmallChange="0.1" StringFormat="{}{0:+0.00;-0.00;0.00}"
                                     EnableDoubleClickReset="True" IsEnabled="{Binding HasSelectedLocal}"/>
                <StackPanel Spacing="8" IsEnabled="{Binding CanEditLocalColor}">
                    <views:CompactSlider Label="Temperature" Value="{Binding LocalTemperature}" Minimum="-50" Maximum="50"
                                         SmallChange="1" StringFormat="{}{0:+0;-0;0}" EnableDoubleClickReset="True" ShowValueFill="False">
                        <views:CompactSlider.TrackBrush>
                            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                <GradientStop Color="{StaticResource WhiteBalanceCoolColor}" Offset="0"/>
                                <GradientStop Color="{StaticResource WhiteBalanceNeutralColor}" Offset="0.5"/>
                                <GradientStop Color="{StaticResource WhiteBalanceWarmColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </views:CompactSlider.TrackBrush>
                    </views:CompactSlider>
                    <views:CompactSlider Label="Tint" Value="{Binding LocalTint}" Minimum="-50" Maximum="50"
                                         SmallChange="1" StringFormat="{}{0:+0;-0;0}" EnableDoubleClickReset="True" ShowValueFill="False">
                        <views:CompactSlider.TrackBrush>
                            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                <GradientStop Color="{StaticResource WhiteBalanceTintGreenColor}" Offset="0"/>
                                <GradientStop Color="{StaticResource WhiteBalanceTintNeutralColor}" Offset="0.5"/>
                                <GradientStop Color="{StaticResource WhiteBalanceTintMagentaColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </views:CompactSlider.TrackBrush>
                    </views:CompactSlider>
                    <views:CompactSlider Label="Saturation" Value="{Binding LocalSaturation}" Minimum="-100" Maximum="100"
                                         SmallChange="1" StringFormat="{}{0:+0;-0;0}" EnableDoubleClickReset="True"/>
                </StackPanel>
                <TextBlock Text="Monochrome RAW — color controls unavailable" IsVisible="{Binding IsMonochromeSource}"
                           TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Button Content="Reset adjustments" Command="{Binding ResetLocalAdjustmentsCommand}"
                            IsEnabled="{Binding HasSelectedLocal}" Padding="8,4" FontSize="10"/>
                    <Button x:Name="CenterLocalInViewButton" IsVisible="{Binding IsGradientSectionVisible}" Content="Center in view"
                            IsEnabled="{Binding CanEditLocalGeometry}" Command="{Binding CenterLocalInViewCommand}" Padding="8,4" FontSize="10"/>
                </StackPanel>
            </StackPanel>
            <StackPanel x:Name="BrushSection" Spacing="6" IsVisible="{Binding IsBrushSectionVisible}" IsEnabled="{Binding CanEditLocals}">
                <TextBlock Text="Brush" Classes="section-label" FontSize="10"/>
                <Grid ColumnDefinitions="*,*">
                    <ToggleButton Classes="mask" Content="Paint" IsChecked="{Binding IsBrushPaint, Mode=OneWay}"
                                  Command="{Binding SetBrushModeCommand}" CommandParameter="paint" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Center" Padding="5,3" FontSize="10"/>
                    <ToggleButton Classes="mask" Grid.Column="1" Content="Erase" IsChecked="{Binding IsBrushErase, Mode=OneWay}"
                                  Command="{Binding SetBrushModeCommand}" CommandParameter="erase" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Center" Padding="5,3" FontSize="10"/>
                </Grid>
                <views:CompactSlider Label="Size" Value="{Binding BrushSize}" Minimum="1" Maximum="100" SmallChange="1"/>
                <views:CompactSlider Label="Feather" Value="{Binding BrushFeather}" Minimum="0" Maximum="100" SmallChange="1" StringFormat="{}{0:0}%"/>
                <views:CompactSlider Label="Flow" Value="{Binding BrushFlow}" Minimum="5" Maximum="100" SmallChange="1" StringFormat="{}{0:0}%"/>
                <Button Content="Clear strokes" Command="{Binding ClearBrushStrokesCommand}" IsVisible="{Binding !IsBrushCreationArmed}"
                        Padding="8,4" FontSize="10"/>
            </StackPanel>
            <StackPanel Spacing="8" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasLocals}">
                <Grid ColumnDefinitions="*,*" IsVisible="{Binding IsRadialLocal}" IsEnabled="{Binding CanEditLocalGeometry}">
                    <ToggleButton Classes="mask" Content="Inside" IsChecked="{Binding IsLocalInside, Mode=OneWay}"
                                  Command="{Binding SetLocalPolarityCommand}" CommandParameter="inside" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Center" Padding="5,3" FontSize="10"/>
                    <ToggleButton Classes="mask" Grid.Column="1" Content="Outside" IsChecked="{Binding IsLocalOutside, Mode=OneWay}"
                                  Command="{Binding SetLocalPolarityCommand}" CommandParameter="outside" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Center" Padding="5,3" FontSize="10"/>
                </Grid>
                <ToggleButton x:Name="LocalGeometryDisclosure" IsVisible="{Binding IsGradientSectionVisible}" Classes="geometry-disclosure"
                              IsChecked="{Binding IsLocalGeometryExpanded}" AutomationProperties.Name="Geometry"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0"
                              Background="Transparent" BorderThickness="0" MinHeight="20">
                    <ToggleButton.Template>
                        <ControlTemplate>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              Background="{TemplateBinding Background}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="Center"/>
                        </ControlTemplate>
                    </ToggleButton.Template>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Geometry" Classes="section-label" FontSize="10"/>
                        <Path Width="6" Height="6" VerticalAlignment="Center"
                              Stroke="{DynamicResource TextMuted}" StrokeThickness="1"/>
                    </StackPanel>
                </ToggleButton>
                <StackPanel IsVisible="{Binding IsGradientGeometryExpanded}" IsEnabled="{Binding CanEditLocalGeometry}">
                    <views:CompactSlider x:Name="LocalXSlider" Classes="local-geometry" Label="X"
                                         Value="{Binding LocalX}" Minimum="-100" Maximum="200" SmallChange="0.1"
                                         StringFormat="{}{0:0.0}%" AutomationProperties.Name="Local X"/>
                    <views:CompactSlider x:Name="LocalYSlider" Classes="local-geometry" Label="Y"
                                         Value="{Binding LocalY}" Minimum="-100" Maximum="200" SmallChange="0.1"
                                         StringFormat="{}{0:0.0}%" AutomationProperties.Name="Local Y"/>
                    <views:CompactSlider x:Name="LocalAngleSlider" Classes="local-geometry" Label="Angle"
                                         Value="{Binding LocalAngle}" Minimum="0" Maximum="360" SmallChange="1"
                                         WrapValue="True" StringFormat="{}{0:0}°" AutomationProperties.Name="Local angle"/>
                    <views:CompactSlider x:Name="LocalWidthSlider" Classes="local-geometry" Label="Width"
                                         Value="{Binding LocalWidth}" Minimum="{Binding LocalWidthMinimum}" Maximum="200" SmallChange="0.1"
                                         StringFormat="{}{0:0.0}%" AutomationProperties.Name="Local width"/>
                    <views:CompactSlider x:Name="LocalHeightSlider" Classes="local-geometry" Label="Height" IsVisible="{Binding IsRadialLocal}"
                                         Value="{Binding LocalHeight}" Minimum="0.2" Maximum="200" SmallChange="0.1"
                                         StringFormat="{}{0:0.0}%" AutomationProperties.Name="Local height"/>
                    <views:CompactSlider x:Name="LocalFeatherSlider" Classes="local-geometry" Label="Feather" IsVisible="{Binding IsRadialLocal}"
                                         Value="{Binding LocalFeather}" Minimum="0" Maximum="100" SmallChange="1"
                                         StringFormat="{}{0:0.0}%" AutomationProperties.Name="Local feather"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="LocalRangeHeader"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="LocalLuminanceDisclosure" Classes="geometry-disclosure" IsChecked="{Binding IsLocalLuminanceExpanded}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0"
                                  Background="Transparent" BorderThickness="0" MinHeight="20" AutomationProperties.Name="Luminance Range">
                        <ToggleButton.Template>
                            <ControlTemplate><ContentPresenter Content="{TemplateBinding Content}" Background="{TemplateBinding Background}"
                                HorizontalContentAlignment="Left" VerticalContentAlignment="Center"/></ControlTemplate>
                        </ToggleButton.Template>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Luminance Range" Classes="section-label" FontSize="10"/>
                            <Path Width="6" Height="6" VerticalAlignment="Center" Stroke="{DynamicResource TextMuted}" StrokeThickness="1"/>
                        </StackPanel>
                    </ToggleButton>
                    <CheckBox x:Name="LocalLuminanceEnabled" Grid.Column="1" Margin="8,0,0,0" MinHeight="20"
                              AutomationProperties.Name="Enable Luminance Range" ToolTip.Tip="Enable Luminance Range"
                              IsChecked="{Binding IsLocalLuminanceEnabled, Mode=OneWay}"
                              IsEnabled="{Binding CanEditLocalGeometry}" Command="{Binding ToggleLocalLuminanceCommand}"/>
                </Grid>
                <StackPanel Spacing="8" IsVisible="{Binding IsLocalLuminanceExpanded}">
                        <StackPanel Spacing="8" IsEnabled="{Binding CanEditLocalLuminance}">
                            <StackPanel.Styles>
                                <Style Selector="StackPanel:disabled"><Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}"/></Style>
                            </StackPanel.Styles>
                            <views:DualRangeTrack EditIdentity="{Binding LocalRangeEditIdentity}" Lower="{Binding LocalLuminanceLower}" Upper="{Binding LocalLuminanceUpper}"/>
                            <views:CompactSlider Classes="local-range" Label="Softness" Value="{Binding LocalLuminanceSoftness}"
                                                 Minimum="0" Maximum="50" SmallChange="1" AutomationProperties.Name="Luminance softness"/>
                        </StackPanel>
                        <TextBlock Text="Ranges follow the base image before local adjustments. Global white balance or profile changes may change the mask."
                                   TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="LocalRangeHeader"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="LocalHueDisclosure" Classes="geometry-disclosure" IsChecked="{Binding IsLocalHueExpanded}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0"
                                  Background="Transparent" BorderThickness="0" MinHeight="20" AutomationProperties.Name="Hue Range">
                        <ToggleButton.Template>
                            <ControlTemplate><ContentPresenter Content="{TemplateBinding Content}" Background="{TemplateBinding Background}"
                                HorizontalContentAlignment="Left" VerticalContentAlignment="Center"/></ControlTemplate>
                        </ToggleButton.Template>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Hue Range" Classes="section-label" FontSize="10"/>
                            <Path Width="6" Height="6" VerticalAlignment="Center" Stroke="{DynamicResource TextMuted}" StrokeThickness="1"/>
                        </StackPanel>
                    </ToggleButton>
                    <CheckBox x:Name="LocalHueEnabled" Grid.Column="1" Margin="8,0,0,0" MinHeight="20" AutomationProperties.Name="Enable Hue Range"
                              IsChecked="{Binding IsLocalHueEnabled, Mode=OneWay}" IsEnabled="{Binding CanEditLocalColor}"
                              Command="{Binding ToggleLocalHueCommand}"/>
                </Grid>
                <StackPanel Spacing="6" IsVisible="{Binding IsLocalHueExpanded}">
                    <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding CanEditLocalColor}">
                        <StackPanel.Styles>
                            <Style Selector="StackPanel:disabled"><Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}"/></Style>
                        </StackPanel.Styles>
                        <views:HueRangeStrip Center="{Binding LocalHueCenter}" IsSwatch="True" Width="22" Height="22"/>
                        <ToggleButton x:Name="LocalHuePick" Content="Pick Hue" Classes="mask" IsChecked="{Binding IsLocalHuePicking, Mode=OneWay}"
                                      Command="{Binding ToggleLocalHuePickCommand}" IsEnabled="{Binding CanPickLocalHue}"
                                      ToolTip.Tip="{Binding LocalHuePickAvailability}" AutomationProperties.Name="Pick Hue" Padding="8,4" FontSize="10"/>
                    </StackPanel>
                    <StackPanel Spacing="6" IsEnabled="{Binding CanEditLocalHue}">
                        <StackPanel.Styles>
                            <Style Selector="StackPanel:disabled"><Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}"/></Style>
                        </StackPanel.Styles>
                        <views:CompactSlider Classes="local-hue" Label="Center" Value="{Binding LocalHueCenter}"
                                             Minimum="0" Maximum="360" SmallChange="1" WrapValue="True"
                                             StringFormat="{}{0:0}°" AutomationProperties.Name="Hue center"/>
                        <views:HueRangeStrip Center="{Binding LocalHueCenter}" RangeWidth="{Binding LocalHueWidth}"
                                             Softness="{Binding LocalHueSoftness}" Height="16"/>
                        <views:CompactSlider Classes="local-hue" Label="Width" Value="{Binding LocalHueWidth}"
                                             Minimum="0" Maximum="360" SmallChange="1" StringFormat="{}{0:0}°" AutomationProperties.Name="Hue width"/>
                        <views:CompactSlider Classes="local-hue" Label="Softness" Value="{Binding LocalHueSoftness}"
                                             Minimum="0" Maximum="90" SmallChange="1" StringFormat="{}{0:0}°" AutomationProperties.Name="Hue softness"/>
                    </StackPanel>
                    <TextBlock Text="Selects colors before local adjustments. Neutral colors fade out. Global white balance or profile changes may change the mask."
                               TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock Text="{Binding LocalHuePickAvailability}" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
                <TextBlock Text="Updating mask" IsVisible="{Binding IsLocalRangeMaskUpdating}" FontSize="10"
                           Foreground="{DynamicResource TextMuted}"/>
            </StackPanel>
            <TextBlock Text="{Binding LocalsInstruction}" IsVisible="{Binding !IsLocalCreationArmed}"
                       TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
            <StackPanel Orientation="Horizontal" IsVisible="{Binding IsLocalCreationArmed}"
                        AutomationProperties.Name="{Binding LocalsInstruction}">
                <TextBlock Text="{Binding LocalsInstruction}" IsVisible="{Binding IsBrushCreationArmed}" TextWrapping="Wrap"
                           FontSize="9" Foreground="{DynamicResource TextMuted}"/>
                <TextBlock Text="Drag to place, or " IsVisible="{Binding !IsBrushCreationArmed}" FontSize="9" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}"/>
                <Button x:Name="PlaceLocalAtCenterButton" IsVisible="{Binding !IsBrushCreationArmed}" Content="Place at center"
                        Command="{Binding PlaceLocalAtCenterCommand}" Padding="3,2" FontSize="9"/>
                <TextBlock IsVisible="{Binding !IsBrushCreationArmed}" Text=" · Escape cancels" FontSize="9" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}"/>
            </StackPanel>
        </StackPanel>
        <Button Content="Return to local editing" Command="{Binding ResumeLocalEditingCommand}"
                IsVisible="{Binding !CanEditLocals}" FontSize="10" Padding="5,3"/>
        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0"/>
    </StackPanel>
</UserControl>
