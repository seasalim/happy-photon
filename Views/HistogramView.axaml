<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="250" d:DesignHeight="100"
             x:Class="HappyPhoton.Views.HistogramView">

    <Border Background="{DynamicResource SurfaceLow}" CornerRadius="8" Padding="5">
        <Grid RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Classes="section-label" Text="HISTOGRAM"
                       Margin="0,0,0,5"/>
            <Canvas Grid.Row="1" x:Name="HistogramCanvas"
                    Height="80" ClipToBounds="True"/>
        </Grid>
    </Border>
</UserControl>
