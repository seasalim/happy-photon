<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="250" d:DesignHeight="100"
             xmlns:views="using:HappyPhoton.Views"
             x:Class="HappyPhoton.Views.HistogramView" x:Name="HistogramRoot">

    <Grid RowDefinitions="Auto,Auto">
        <views:ScopePlotPanel>
            <Canvas x:Name="HistogramCanvas" ClipToBounds="True"/>
            <Grid x:Name="DisplayClippingIndicators"
                  IsVisible="False">
                <ToggleButton Classes="icon-button compact" Focusable="False" IsChecked="{Binding IsClippingOverlayLatched, ElementName=HistogramRoot, Mode=OneWay}" x:Name="DisplayFloorTriangleTarget"
                        Padding="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        VerticalContentAlignment="Top"
                        Background="Transparent">
                    <Grid>
                        <Path x:Name="DisplayFloorTriangle"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              StrokeThickness="0" Data="M 0,0 L 11,0 L 0,11 Z"/>
                        <Rectangle x:Name="DisplayFloorLatchMarker"
                                   Width="11" Height="2"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Margin="0,12,0,0"
                                   IsVisible="False"/>
                    </Grid>
                </ToggleButton>
                <ToggleButton Classes="icon-button compact" Focusable="False" IsChecked="{Binding IsClippingOverlayLatched, ElementName=HistogramRoot, Mode=OneWay}" x:Name="SceneHighlightTriangleTarget"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        VerticalContentAlignment="Top"
                        Background="Transparent">
                    <Grid>
                        <Path x:Name="SceneHighlightTriangle"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              StrokeThickness="0" Data="M 0,0 L 11,0 L 11,11 Z"/>
                        <Rectangle x:Name="SceneHighlightLatchMarker"
                                   Width="11" Height="2"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   Margin="0,12,0,0"
                                   IsVisible="False"/>
                    </Grid>
                </ToggleButton>
            </Grid>
        </views:ScopePlotPanel>
        <StackPanel Grid.Row="1" x:Name="RawClippingPanel"
                    IsVisible="False" Margin="0,5,0,0" Spacing="2">
                <TextBlock Text="≥ Sensor white"
                           FontFamily="{StaticResource FontBody}"
                           FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextMuted}"/>
                <Grid ColumnDefinitions="*,*,*">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <Ellipse x:Name="RawRedClippingDot" Width="6" Height="6"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="RawRedClippingText" FontFamily="{StaticResource FontLabel}" FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3">
                        <Ellipse x:Name="RawGreenClippingDot" Width="6" Height="6"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="RawGreenClippingText" FontFamily="{StaticResource FontLabel}" FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3">
                        <Ellipse x:Name="RawBlueClippingDot" Width="6" Height="6"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="RawBlueClippingText" FontFamily="{StaticResource FontLabel}" FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                </Grid>
        </StackPanel>
    </Grid>
</UserControl>
