<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="250" d:DesignHeight="100"
             x:Class="HappyPhoton.Views.HistogramView"
             x:Name="Root">

    <Border Background="{DynamicResource SurfaceLow}" CornerRadius="8" Padding="5">
        <Grid RowDefinitions="Auto,*,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,5">
                <TextBlock Classes="section-label"
                           Text="{Binding Title, ElementName=Root}"/>
                <ContentControl Grid.Column="1"
                                Content="{Binding HeaderContent, ElementName=Root}"/>
            </Grid>
            <Canvas Grid.Row="1" x:Name="HistogramCanvas"
                    Height="80" ClipToBounds="True"/>
            <StackPanel Grid.Row="2" x:Name="RawClippingPanel"
                        IsVisible="False" Margin="0,5,0,0" Spacing="2">
                <TextBlock Text="≥ SENSOR WHITE"
                           FontFamily="{StaticResource FontLabel}"
                           FontSize="8" Foreground="{DynamicResource TextMuted}"/>
                <Grid ColumnDefinitions="*,*,*">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <Ellipse x:Name="RawRedClippingDot" Width="6" Height="6"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="RawRedClippingText" FontSize="8"
                                   Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3">
                        <Ellipse x:Name="RawGreenClippingDot" Width="6" Height="6"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="RawGreenClippingText" FontSize="8"
                                   Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3">
                        <Ellipse x:Name="RawBlueClippingDot" Width="6" Height="6"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="RawBlueClippingText" FontSize="8"
                                   Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
