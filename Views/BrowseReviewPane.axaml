<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HappyPhoton.ViewModels"
             xmlns:views="using:HappyPhoton.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="250" d:DesignHeight="660"
             x:Class="HappyPhoton.Views.BrowseReviewPane"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>
        <Style Selector="Button.metadata-link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{x:Null}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="Button.metadata-link:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource SurfaceMid}"
            IsEnabled="{Binding IsWorkspaceInteractionEnabled}">
        <Grid RowDefinitions="Auto,*,Auto">
            <Border x:Name="BrowseHistogramBox"
                    Margin="15,15,15,10"
                    Padding="5"
                    Background="{DynamicResource SurfaceLow}"
                    IsEnabled="{Binding HasSelectedImage}">
                <Grid RowDefinitions="Auto,Auto">
                    <TextBlock x:Name="BrowseHistogramHeader"
                               Classes="section-label"
                               Text="Histogram"
                               Margin="0,0,0,5"/>
                    <views:HistogramView x:Name="BrowseHistogram"
                                         Grid.Row="1"
                                         Histogram="{Binding Histogram}"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="15,5,15,15" Spacing="16">
                    <TextBlock x:Name="ReviewEmptyHint"
                               Text="Select a photo to review its details"
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="8,24"
                               MaxWidth="180"
                               IsVisible="{Binding !HasSelectedImage}"/>

                    <StackPanel x:Name="ReviewMetadataPanel"
                                Spacing="12"
                                IsVisible="{Binding HasSelectedImage}">
                        <StackPanel.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="CopyDetailsMenuItem"
                                          Header="Copy details"
                                          Command="{Binding CopyMetadataDetailsCommand}"/>
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="section-label" Text="File"/>
                            <TextBlock x:Name="ReviewFileNameText"
                                       Text="{Binding SelectedImage.FileName}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding SelectedImage.FilePath}"/>
                            <TextBlock x:Name="ReviewMetadataLoadingHint"
                                       Text="Loading details…"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       IsVisible="{Binding IsSelectedMetadataLoading}"/>
                            <TextBlock x:Name="ReviewOnlineOnlyHint"
                                       Text="This original is online-only."
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding SelectedImage.SourceRequiresHydration}"/>
                            <TextBlock x:Name="ReviewMetadataUnavailableHint"
                                       Text="Details unavailable"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       IsVisible="{Binding IsSelectedMetadataUnavailable}"/>
                            <StackPanel Spacing="4"
                                        IsVisible="{Binding SelectedImage.MetadataLoaded}">
                                <TextBlock x:Name="ReviewFileDetailsText" FontFamily="{StaticResource FontLabel}"
                                           Text="{Binding SelectedImage.FileDetailsDisplay}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           IsVisible="{Binding SelectedImage.FileDetailsDisplay, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                <TextBlock x:Name="ReviewCaptureDateText" FontFamily="{StaticResource FontLabel}"
                                           Text="{Binding SelectedImage.DisplayDate, StringFormat='{}{0:MMM d, yyyy  h:mm tt}'}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           IsVisible="{Binding SelectedImage.HasCaptureDate}"/>
                                <TextBlock x:Name="ReviewModifiedDateText" FontFamily="{StaticResource FontLabel}"
                                           Text="{Binding SelectedImage.DisplayDate, StringFormat='{}{0:MMM d, yyyy  h:mm tt}'}"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           ToolTip.Tip="File modified date; capture date is unavailable"
                                           IsVisible="{Binding SelectedImage.IsFileModifiedDateFallback}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="4"
                                    IsVisible="{Binding SelectedImage.MetadataLoaded}">
                            <StackPanel x:Name="ReviewCameraSection"
                                        Spacing="4"
                                        IsVisible="{Binding SelectedImage.HasCameraMetadata}">
                                <TextBlock Classes="section-label" Text="Camera"/>
                                <TextBlock x:Name="ReviewCameraText"
                                           Text="{Binding SelectedImage.CameraDisplay}"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding SelectedImage.CameraModel}"
                                           IsVisible="{Binding SelectedImage.CameraDisplay, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                <TextBlock x:Name="ReviewLensText"
                                           Text="{Binding SelectedImage.LensModel}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding SelectedImage.LensModel}"
                                           IsVisible="{Binding SelectedImage.LensModel, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                <TextBlock x:Name="ReviewExposureText" FontFamily="{StaticResource FontLabel}"
                                           Text="{Binding SelectedImage.ExposureDisplay}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           TextWrapping="Wrap"
                                           ToolTip.Tip="{Binding SelectedImage.ExposureTooltip}"
                                           IsVisible="{Binding SelectedImage.ExposureDisplay, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                <TextBlock x:Name="ReviewConditionsText"
                                           Text="{Binding SelectedImage.CaptureConditionsDisplay}"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding SelectedImage.CaptureConditionsDisplay, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            </StackPanel>

                            <StackPanel x:Name="ReviewLocationSection"
                                        Margin="0,8,0,0" Spacing="4"
                                        IsVisible="{Binding SelectedImage.HasLocationMetadata}">
                                <TextBlock Classes="section-label" Text="Location"/>
                                <Button x:Name="ReviewMapLink" FontFamily="{StaticResource FontLabel}"
                                        Classes="metadata-link"
                                        Content="{Binding SelectedImage.GpsDisplay}"
                                        FontSize="{DynamicResource FontSizeBody}"
                                        Command="{Binding OpenSelectedImageMapCommand}"
                                        IsEnabled="{Binding SelectedImage.HasGpsCoordinates}"
                                        IsVisible="{Binding SelectedImage.GpsDisplay, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        ToolTip.Tip="Open location in OpenStreetMap"/>
                                <TextBlock x:Name="ReviewAltitudeText" FontFamily="{StaticResource FontLabel}"
                                           Text="{Binding SelectedImage.GpsAltitudeDisplay}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           IsVisible="{Binding SelectedImage.GpsAltitudeDisplay, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <Button x:Name="SyncSettingsButton"
                    Grid.Row="2"
                    Classes="compact-button filled"
                    Content="Sync settings…"
                    AutomationProperties.Name="Sync settings"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="15,8,15,15"
                    Command="{Binding SyncSettingsCommand}"
                    ToolTip.Tip="{Binding SyncSettingsToolTip}"
                    ToolTip.ShowOnDisabled="True"/>
        </Grid>
    </Border>
</UserControl>
