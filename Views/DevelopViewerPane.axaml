<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:HappyPhoton.Views"
             xmlns:vm="using:HappyPhoton.ViewModels"
             x:Class="HappyPhoton.Views.DevelopViewerPane"
             x:DataType="vm:MainWindowViewModel">
    <Grid RowDefinitions="*,Auto">
        <Grid x:Name="ViewerGrid" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Panel x:Name="BeforePane" Grid.Column="0" IsVisible="{Binding IsBeforeAfterSplit}">
                <views:ZoomPanControl x:Name="BeforeZoomPanControl"
                                      Source="{Binding BeforeAfterPreviewImage}"
                                      SourceIdentity="{Binding SelectedImage}"
                                      ZoomLevel="{Binding ZoomLevel}"
                                      OriginalViewPixelSize="{Binding BeforeAfterOriginalViewPixelSize}"
                                      AutoFit="{Binding IsZoomFitMode}"
                                      ScrollBarVisibility="Hidden" ContentInset="10"/>
                <TextBlock Classes="section-label" Text="Before" Margin="16,12" Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </Panel>
            <Panel Grid.Column="1">
            <views:PlaceholderImage x:Name="DevelopPlaceholderImage"
                   Source="{Binding SelectedImage.Thumbnail}"
                   OriginalPixelWidth="{Binding SelectedImage.PixelWidth, FallbackValue=0}"
                   OriginalPixelHeight="{Binding SelectedImage.PixelHeight, FallbackValue=0}"
                   IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNull}}"
                   Stretch="Uniform" Margin="10"
                   RenderOptions.BitmapInterpolationMode="LowQuality"/>
            <views:ZoomPanControl x:Name="ZoomPanControl"
                                  Source="{Binding PreviewImage}"
                                  SourceIdentity="{Binding SelectedImage}"
                                  ZoomLevel="{Binding ZoomLevel}"
                                  OriginalViewPixelSize="{Binding OriginalViewPixelSize}"
                                  AutoFit="{Binding IsZoomFitMode}"
                                  IsCropMode="{Binding IsCropMode}"
                                  IsWhiteBalancePicking="{Binding IsWhiteBalancePicking}"
                                  IsColorAssessment="{Binding IsColorAssessmentMode}"
                                  IsDisplayTraceActive="{Binding IsDevelopPreviewSurfaceActive}"
                                  ClippingMask="{Binding PreviewClippingMask}"
                                  VisibleClippingSides="{Binding VisibleClippingOverlaySides}"
                                  IsClippingOverlayLatched="{Binding IsClippingOverlayLatched}"
                                  ShowAlignmentGrid="{Binding IsAlignmentGridVisible}"
                                  IsCropAspectLocked="{Binding IsCropAspectLocked}"
                                  Crop="{Binding CurrentCrop, Mode=TwoWay}"
                                  ScrollBarVisibility="Hidden" ContentInset="10"/>
                <TextBlock Classes="section-label" Text="After" Margin="16,12" Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding IsBeforeAfterSplit}"/>
            <views:AssessmentFeedbackOverlay x:Name="DevelopAssessmentFeedbackOverlay"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Bottom"
                                             Margin="16,16,16,32"/>
            <Border x:Name="DevelopEmptyState"
                    IsVisible="{Binding IsDevelopEmptyStateVisible}"
                    Background="{DynamicResource SurfaceLow}"
                    CornerRadius="{StaticResource RadiusMedium}" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Select an image to edit"
                           Foreground="{DynamicResource TextMuted}" FontSize="16"/>
            </Border>
            </Panel>
        </Grid>
        <Border x:Name="DevelopControlBar" Grid.Row="1" Padding="10,4"
                Background="{DynamicResource SurfaceLow}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,1,0,0"
                IsEnabled="{Binding HasSelectedImage}"
                HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel x:Name="DevelopImageActionsPanel"
                        Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="PreviousImageButton"
                        Command="{Binding SelectPreviousImageCommand}"
                        ToolTip.Tip="Previous image (←)"
                        AutomationProperties.Name="Previous image"
                        Padding="7,3" BorderThickness="0">
                    <Viewbox Width="14" Height="14"><Canvas Width="16" Height="16">
                        <Path Data="M 10,3.5 L 5.5,8 L 10,12.5" Fill="Transparent"
                              Stroke="{DynamicResource ControlActive}" StrokeThickness="1.5"
                              StrokeLineCap="Round" StrokeJoin="Round"/>
                    </Canvas></Viewbox>
                </Button>
                <Button x:Name="NextImageButton"
                        Command="{Binding SelectNextImageCommand}"
                        ToolTip.Tip="Next image (→)"
                        AutomationProperties.Name="Next image"
                        Padding="7,3" BorderThickness="0">
                    <Viewbox Width="14" Height="14"><Canvas Width="16" Height="16">
                        <Path Data="M 6,3.5 L 10.5,8 L 6,12.5" Fill="Transparent"
                              Stroke="{DynamicResource ControlActive}" StrokeThickness="1.5"
                              StrokeLineCap="Round" StrokeJoin="Round"/>
                    </Canvas></Viewbox>
                </Button>
                <Rectangle Width="1" Height="16" Fill="{DynamicResource Outline}" Margin="4,0"/>
                <Button x:Name="RotateLeftButton" Command="{Binding RotateLeftCommand}"
                        IsEnabled="{Binding CanEditSelectedImage}" Content="↶"
                        ToolTip.Tip="Rotate Left (90° counter-clockwise)"
                        FontSize="14" Padding="8,3" BorderThickness="0"/>
                <Button Command="{Binding RotateRightCommand}"
                        IsEnabled="{Binding CanEditSelectedImage}" Content="↷"
                        ToolTip.Tip="Rotate Right (90° clockwise)"
                        FontSize="14" Padding="8,3" BorderThickness="0"/>
                <ToggleButton x:Name="CropModeButton"
                              IsChecked="{Binding IsCropMode, Mode=OneWay}"
                              Command="{Binding ToggleCropModeCommand}"
                              IsEnabled="{Binding CanEditSelectedImage}"
                              ToolTip.Tip="Crop Image (R)" FontSize="14"
                              Padding="8,3" BorderThickness="0">
                    <TextBlock Text="⬚" FontSize="14"/>
                </ToggleButton>
                <Rectangle Width="1" Height="16" Fill="{DynamicResource Outline}"
                           Margin="4,0" IsVisible="{Binding IsCropMode}"/>
                <StackPanel Orientation="Horizontal" Spacing="4"
                            IsVisible="{Binding IsCropMode}"
                            IsEnabled="{Binding CanEditSelectedImage}">
                    <views:CompactSlider Label="Horizon" Value="{Binding HorizonRotation}"
                                         Minimum="-5" Maximum="5" SmallChange="0.1"
                                         StringFormat="{}{0:+0.0;-0.0;0.0}°"
                                         EnableDoubleClickReset="True" Width="150"/>
                    <ToggleButton IsChecked="{Binding IsCropAspectLocked}"
                                  ToolTip.Tip="Lock Aspect Ratio" FontSize="10"
                                  Padding="8,4" BorderThickness="0">
                        <TextBlock Text="🔒" FontSize="12"/>
                    </ToggleButton>
                    <Button x:Name="ApplyCropButton" Command="{Binding ApplyCropCommand}"
                            Content="Apply" ToolTip.Tip="Apply Crop (Enter)"
                            FontSize="10" Padding="10,4" Classes="accent" BorderThickness="0"/>
                    <Button Command="{Binding ResetCropCommand}" Content="Reset"
                            ToolTip.Tip="Reset Crop" FontSize="10" Padding="8,4" BorderThickness="0"/>
                    <Button x:Name="CancelCropButton" Command="{Binding CancelCropCommand}"
                            Content="Cancel" ToolTip.Tip="Cancel (Escape)"
                            FontSize="10" Padding="8,4" BorderThickness="0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel x:Name="DevelopViewStatePanel"
                        Grid.Column="2"
                        Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <views:CompactSlider Label="Zoom"
                                     Value="{Binding ManualZoomLevel, Mode=TwoWay}"
                                     Minimum="0.1" Maximum="5" SmallChange="0.1"
                                     StringFormat="{}{0:P0}" Width="180"/>
                <Button Command="{Binding ZoomFitCommand}" Content="Fit"
                        ToolTip.Tip="Fit to View" FontSize="10"
                        Padding="8,3" BorderThickness="0"/>
                <ToggleButton x:Name="ActualSizeButton"
                              IsChecked="{Binding !IsZoomFitMode, Mode=OneWay}"
                              Command="{Binding ToggleActualSizeCommand}"
                              Content="1:1" ToolTip.Tip="Fit / 1:1 (Space or Z)"
                              FontSize="10" Padding="8,3" BorderThickness="0"/>
                <ToggleButton x:Name="ColorAssessmentButton"
                              IsChecked="{Binding IsColorAssessmentMode, Mode=OneWay}"
                              Command="{Binding ToggleColorAssessmentModeCommand}"
                              Content="Assess" ToolTip.Tip="Color assessment mode (L)"
                              FontSize="10" Padding="8,3" BorderThickness="0"/>
                <Button x:Name="FullScreenButton" Command="{Binding ToggleFullScreenCommand}"
                        IsEnabled="{Binding !IsCropMode}" ToolTip.Tip="Fullscreen (F)"
                        AutomationProperties.Name="Enter fullscreen"
                        Padding="7,3" BorderThickness="0">
                    <Viewbox Width="14" Height="14"><Canvas Width="16" Height="16">
                        <Path Data="M 2,6 L 2,2 L 6,2 M 10,2 L 14,2 L 14,6 M 14,10 L 14,14 L 10,14 M 6,14 L 2,14 L 2,10"
                              Fill="Transparent" Stroke="{DynamicResource ControlActive}"
                              StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"/>
                    </Canvas></Viewbox>
                </Button>
                <ToggleButton x:Name="BeforeAfterSplitButton"
                              IsChecked="{Binding IsBeforeAfterSplit, Mode=OneWay}"
                              Command="{Binding ToggleBeforeAfterSplitCommand}"
                              ToolTip.Tip="Before | After (Y)"
                              AutomationProperties.Name="Show Before and After side by side"
                              FontSize="10" Padding="8,3" BorderThickness="0">
                    <TextBlock Text="Y|Y" FontFamily="{StaticResource FontBody}" FontSize="10"/>
                </ToggleButton>
                <ToggleButton x:Name="RawJpegSwitchButton"
                              IsChecked="{Binding IsViewingPairedRaw, Mode=OneWay}"
                              Command="{Binding SwitchCaptureMemberCommand}"
                              IsEnabled="{Binding CanSwitchCaptureMember}"
                              ToolTip.Tip="Switch JPEG / RAW (Shift+R)"
                              AutomationProperties.Name="Switch JPEG and RAW"
                              Content="J|R" FontFamily="{StaticResource FontBody}"
                              FontSize="10" Padding="8,3" BorderThickness="0"/>
            </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
