<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:HappyPhoton.ViewModels"
        xmlns:views="using:HappyPhoton.Views"
        mc:Ignorable="d"
        d:DesignWidth="840"
        d:DesignHeight="540"
        x:Class="HappyPhoton.Views.BatchExportDialog"
        x:DataType="vm:ExportDialogViewModel"
        Title="Export Images"
        Width="840"
        MinWidth="720"
        MaxHeight="700"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="72"
        Background="{DynamicResource SurfaceLow}">

    <Window.Styles>
        <Style Selector="Border.field-surface">
            <Setter Property="Background" Value="{DynamicResource SurfaceLowest}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
            <Setter Property="Padding" Value="12,9"/>
        </Style>
        <Style Selector="TextBlock.preview">
            <Setter Property="FontFamily" Value="{StaticResource FontLabel}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style Selector="TextBox.size-input">
            <Setter Property="Background" Value="{DynamicResource SurfaceLowest}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="TextBox.size-input:disabled">
            <Setter Property="Background" Value="{DynamicResource SurfaceMid}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto">
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceMid}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,0,0,1"
                Padding="24,18">
            <Grid ColumnDefinitions="*,Auto">
                <Border Background="Transparent"
                        PointerPressed="OnHeaderPointerPressed">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="⇧"
                                   Margin="0,0,12,0"
                                   FontSize="24"
                                   Foreground="{StaticResource Primary}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding HeaderText}"
                                   FontFamily="{StaticResource FontHeading}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Button x:Name="CloseDialogButton"
                         Grid.Column="1"
                         Content="✕"
                         Width="32"
                         Height="32"
                         Padding="0"
                         FontSize="14"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"
                         Background="Transparent"
                         BorderBrush="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource TextSecondary}"
                        AutomationProperties.Name="Close export dialog"
                        Click="OnCloseClick"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      MaxHeight="470"
                      Background="{DynamicResource SurfaceBase}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,28" RowDefinitions="Auto,Auto">
                <StackPanel x:Name="ConfigurationPanel"
                            Grid.Row="0"
                            Spacing="24"
                            IsVisible="{Binding ShowConfiguration}"
                            IsEnabled="{Binding IsIdle}">
                    <Border Padding="12,10"
                            Background="{DynamicResource SurfaceMid}"
                            BorderBrush="{StaticResource Primary}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMedium}"
                            IsVisible="{Binding HasOnlineOnlyImages}">
                        <TextBlock Text="{Binding OnlineOnlyMessage}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   TextWrapping="Wrap"/>
                    </Border>
                    <StackPanel Spacing="8">
                        <TextBlock Text="FOLDER" Classes="section-label"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Text="{Binding Settings.OutputFolder, Mode=TwoWay}"
                                     MinHeight="40"
                                     Padding="12,9"
                                     FontFamily="{StaticResource FontLabel}"
                                     AutomationProperties.Name="Export folder"/>
                            <Button Grid.Column="1"
                                    Content="Browse…"
                                    Margin="10,0,0,0"
                                    MinWidth="104"
                                    Padding="16,9"
                                    AutomationProperties.Name="Browse export folder"
                                    Click="OnBrowseClick"/>
                        </Grid>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,32,*">
                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Text="FORMAT" Classes="section-label"/>
                            <ComboBox ItemsSource="{Binding FormatOptions}"
                                      SelectedItem="{Binding SelectedFormatOption, Mode=TwoWay}"
                                      Width="180"
                                      HorizontalAlignment="Left"
                                      MinHeight="40"
                                      Padding="12,7"
                                      AutomationProperties.Name="Export format">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ExportFormatOption">
                                        <TextBlock Text="{Binding Label}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="8">
                            <TextBlock Text="QUALITY" Classes="section-label"/>
                            <Grid ColumnDefinitions="*,52"
                                  MinHeight="40"
                                  IsVisible="{Binding IsQualityAvailable}">
                                <Slider Minimum="1"
                                        Maximum="100"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding Settings.Quality, Mode=TwoWay}"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Export quality"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Settings.Quality, StringFormat={}{0}%}"
                                           FontFamily="{StaticResource FontLabel}"
                                           Foreground="{StaticResource Primary}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <Border Classes="field-surface"
                                    MinHeight="40"
                                    IsVisible="{Binding IsLosslessFormat}">
                                <TextBlock Text="Lossless"
                                           Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,32,*">
                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Text="SIZE" Classes="section-label"/>
                            <StackPanel Spacing="7">
                                <RadioButton GroupName="ExportSize"
                                             Content="Hi-Res  ·  Original dimensions"
                                             IsChecked="{Binding IsHiResSelected, Mode=TwoWay}"/>
                                <Grid ColumnDefinitions="64,Auto,Auto" MinHeight="32">
                                    <RadioButton Content="Web"
                                                 GroupName="ExportSize"
                                                 VerticalAlignment="Center"
                                                 IsChecked="{Binding IsWebSelected, Mode=TwoWay}"/>
                                     <TextBox Grid.Column="1"
                                             Classes="size-input"
                                             Margin="12,0,6,0"
                                             Width="92"
                                             HorizontalAlignment="Left"
                                             Text="{Binding Settings.WebMaxSize, Mode=TwoWay}"
                                             IsEnabled="{Binding IsWebSelected}"
                                             AutomationProperties.Name="Web maximum dimension"/>
                                    <TextBlock Grid.Column="2"
                                               Text="px"
                                               Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <Grid ColumnDefinitions="64,Auto,Auto" MinHeight="32">
                                    <RadioButton Content="Small"
                                                 GroupName="ExportSize"
                                                 VerticalAlignment="Center"
                                                 IsChecked="{Binding IsSmallSelected, Mode=TwoWay}"/>
                                     <TextBox Grid.Column="1"
                                             Classes="size-input"
                                             Margin="12,0,6,0"
                                             Width="92"
                                             HorizontalAlignment="Left"
                                             Text="{Binding Settings.SmallMaxSize, Mode=TwoWay}"
                                             IsEnabled="{Binding IsSmallSelected}"
                                             AutomationProperties.Name="Small maximum dimension"/>
                                    <TextBlock Grid.Column="2"
                                               Text="px"
                                               Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="8">
                            <TextBlock Text="NAMING" Classes="section-label"/>
                            <ComboBox ItemsSource="{Binding NamingOptions}"
                                      SelectedItem="{Binding SelectedNamingOption, Mode=TwoWay}"
                                      Width="180"
                                      HorizontalAlignment="Left"
                                      MinHeight="40"
                                      Padding="12,7"
                                      AutomationProperties.Name="Export naming pattern"/>
                            <TextBox Text="{Binding Settings.NamingPattern, Mode=TwoWay}"
                                     MinHeight="36"
                                     Padding="10,7"
                                     IsVisible="{Binding IsCustomNaming}"
                                     AutomationProperties.Name="Custom naming pattern"/>
                            <Border Classes="field-surface">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Text="→"
                                               Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding PreviewFileName}"
                                               Classes="preview"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="0"
                            IsVisible="{Binding ShowEmptyState}"
                            HorizontalAlignment="Center"
                            Margin="36,44"
                            Spacing="8">
                    <TextBlock Text="No images selected"
                               FontFamily="{StaticResource FontHeading}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Close this dialog and select photographs using Space or the selection controls."
                               MaxWidth="440"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Margin="0,18,0,0"
                            Spacing="8"
                            IsVisible="{Binding IsExporting}">
                    <ProgressBar Name="ExportProgressBar"
                                 Minimum="0"
                                 Maximum="{Binding ProgressMaximum}"
                                 Value="{Binding ProgressValue}"
                                 Height="5"/>
                    <TextBlock Text="{Binding ProgressText}"
                               Classes="preview"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="0,18,0,0"
                        Padding="12,10"
                        Background="{StaticResource ErrorContainer}"
                        CornerRadius="{StaticResource RadiusMedium}"
                        IsVisible="{Binding HasError}">
                    <SelectableTextBlock Text="{Binding ErrorMessage}"
                                         Foreground="{StaticResource OnErrorContainer}"
                                         TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceMid}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,1,0,0"
                Padding="32,18">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="5"
                            IsVisible="{Binding ShowFooterOptions}"
                            IsEnabled="{Binding IsIdle}">
                    <CheckBox x:Name="OutputSharpeningCheckBox"
                              Content="Output sharpening"
                              IsChecked="{Binding Settings.OutputSharpening, Mode=TwoWay}"/>
                    <CheckBox Content="Strip location data"
                              IsChecked="{Binding Settings.StripLocationData, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <Button Content="Close"
                            MinWidth="96"
                            Padding="18,9"
                            IsVisible="{Binding ShowEmptyState}"
                            Click="OnCloseClick"/>
                    <Button Content="Cancel"
                            MinWidth="96"
                            Padding="18,9"
                            IsVisible="{Binding ShowIdleImageActions}"
                            Click="OnCloseClick"/>
                    <Button Content="Cancel Export"
                            MinWidth="124"
                            Padding="18,9"
                            IsVisible="{Binding IsExporting}"
                            Click="OnCancelExportClick"/>
                    <Button x:Name="ExportButton"
                            Content="{Binding PrimaryActionText}"
                            MinWidth="112"
                            Padding="18,9"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Classes="accent"
                            IsDefault="True"
                            IsVisible="{Binding ShowPrimaryAction}"
                            IsEnabled="{Binding CanPrimaryAction}"
                            Click="OnExportClick"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
