<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HappyPhoton.ViewModels"
             xmlns:views="using:HappyPhoton.Views"
             x:Class="HappyPhoton.Views.ExportSettingsPane"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <StyleInclude Source="avares://HappyPhoton/Views/DevelopGroupStyles.axaml"/>
        <Style Selector="Expander.develop-group /template/ ToggleButton#ExpanderHeader">
            <Setter Property="ToolTip.Tip" Value="{x:Null}"/>
        </Style>
        <Style Selector="Expander.develop-group#ExportMoreOptions /template/ ToggleButton#ExpanderHeader">
            <Setter Property="AutomationProperties.Name" Value="More options"/>
        </Style>
        <Style Selector="Expander.develop-group#ExportWatermarkExpander /template/ ToggleButton#ExpanderHeader">
            <Setter Property="AutomationProperties.Name" Value="Watermark"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource SurfaceMid}">
        <Grid RowDefinitions="*,Auto">
            <ScrollViewer x:Name="ExportSettingsScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="15,0,15,15" Spacing="4">
                    <TextBlock Text="Destination" Classes="section-label" Margin="0,12,0,4"/>
                    <TextBox x:Name="ExportFolderField" Classes="edit-field"
                             Text="{Binding ExportSettings.OutputFolder, Mode=TwoWay}"
                             ToolTip.Tip="{Binding ExportSettings.OutputFolder}" AutomationProperties.Name="Export folder"/>
                    <Button Classes="quiet-button" Content="Browse…" HorizontalAlignment="Left" Margin="0,4,0,0"
                            Click="OnBrowseClick" AutomationProperties.Name="Browse export folder"/>

                    <TextBlock Text="Output sizes" Classes="section-label" Margin="0,12,0,4"/>
                    <CheckBox Classes="edit-toggle" Content="Full size · No resizing"
                              IsChecked="{Binding ExportSettings.ExportHiRes, Mode=TwoWay}"/>
                    <Grid ColumnDefinitions="70,*,Auto" Height="28">
                        <CheckBox Classes="edit-toggle" Content="Web" IsChecked="{Binding ExportSettings.ExportWeb, Mode=TwoWay}"/>
                        <TextBox x:Name="WebMaxSizeField" FontFamily="{StaticResource FontLabel}" Grid.Column="1" Classes="edit-field" Margin="0,0,5,0"
                                 IsEnabled="{Binding ExportSettings.ExportWeb}"
                                 Text="{Binding ExportSettings.WebMaxSizeText, Mode=TwoWay}"
                                 AutomationProperties.Name="Web long edge in pixels"/>
                        <TextBlock Grid.Column="2" Text="px" VerticalAlignment="Center" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource TextMuted}"/>
                    </Grid>
                    <Grid ColumnDefinitions="70,*,Auto" Height="28">
                        <CheckBox Classes="edit-toggle" Content="Small" IsChecked="{Binding ExportSettings.ExportSmall, Mode=TwoWay}"/>
                        <TextBox x:Name="SmallMaxSizeField" FontFamily="{StaticResource FontLabel}" Grid.Column="1" Classes="edit-field" Margin="0,0,5,0"
                                 IsEnabled="{Binding ExportSettings.ExportSmall}"
                                 Text="{Binding ExportSettings.SmallMaxSizeText, Mode=TwoWay}"
                                 AutomationProperties.Name="Small long edge in pixels"/>
                        <TextBlock Grid.Column="2" Text="px" VerticalAlignment="Center" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource TextMuted}"/>
                    </Grid>

                    <TextBlock Text="Long edge · preserves aspect ratio" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextMuted}"/>

                    <TextBlock Text="Format" Classes="section-label" Margin="0,12,0,4"/>
                    <ComboBox x:Name="ExportFormatBox" Classes="edit-dropdown" SelectedIndex="{Binding ExportSettings.Format, Mode=TwoWay}">
                        <ComboBoxItem Content="JPEG"/>
                        <ComboBoxItem Content="PNG"/>
                        <ComboBoxItem Content="WebP"/>
                        <ComboBoxItem Content="TIFF (16-bit)"/>
                    </ComboBox>
                    <views:CompactSlider x:Name="ExportQualitySlider" Label="Quality"
                                         Minimum="1" Maximum="100" SmallChange="1" StringFormat="{}{0:0}%"
                                         IsVisible="{Binding IsExportQualityAvailable}"
                                         Value="{Binding ExportSettings.Quality, Mode=TwoWay}" Margin="0,4,0,0"/>

                    <TextBlock x:Name="ExportLosslessLabel" Text="Lossless" IsVisible="{Binding !IsExportQualityAvailable}" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource TextSecondary}"/>
                    <CheckBox Classes="edit-toggle" Content="Remove location data" IsChecked="{Binding ExportSettings.StripLocationData, Mode=TwoWay}"/>
                    <StackPanel Spacing="0">
                        <Expander Classes="develop-group compact-chevron" HeaderTemplate="{x:Null}" x:Name="ExportMoreOptions" IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="More options" Classes="section-label"/>
                            </Expander.Header>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding ExportOptionsSummary}" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                <TextBlock Text="Color space" Classes="section-label" Margin="0,12,0,4"/>
                                <ListBox x:Name="ExportColorSpaceBox" Classes="segmented" SelectedIndex="{Binding ExportSettings.OutputColorSpace, Mode=TwoWay}"
                                         SelectionMode="Single,AlwaysSelected">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" ColumnSpacing="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    <ListBoxItem Content="sRGB"/>
                                    <ListBoxItem Content="Display P3"/>
                                </ListBox>

                                <TextBlock Text="Output sharpening" Classes="section-label" Margin="0,12,0,4"/>
                                <ListBox x:Name="ExportSharpeningBox" Classes="segmented" SelectedIndex="{Binding ExportSettings.OutputSharpening, Mode=TwoWay}"
                                         SelectionMode="Single,AlwaysSelected">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" ColumnSpacing="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    <ListBoxItem Content="Off"/>
                                    <ListBoxItem Content="Screen"/>
                                    <ListBoxItem Content="Print"/>
                                </ListBox>

                                <TextBlock Text="Filenames" Classes="section-label" Margin="0,12,0,4"/>
                                <ComboBox Classes="edit-dropdown" SelectedIndex="{Binding ExportFilenameChoice, Mode=TwoWay}">
                                    <ComboBoxItem Content="Keep original filename"/>
                                    <ComboBoxItem Content="Custom pattern"/>
                                </ComboBox>
                                <TextBox x:Name="ExportNamingPatternField" Classes="edit-field" IsVisible="{Binding IsCustomExportFilename}"
                                         Text="{Binding ExportSettings.NamingPattern, Mode=TwoWay}"
                                         PlaceholderText="{}{name}, {date}" AutomationProperties.Name="Export naming pattern"/>
                                <TextBlock Text="{}{name} = original name · {date} = export date" IsVisible="{Binding IsCustomExportFilename}" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Expander>
                        <Expander Classes="develop-group compact-chevron" HeaderTemplate="{x:Null}" x:Name="ExportWatermarkExpander" IsExpanded="{Binding IsWatermarkExpanded, Mode=TwoWay}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Watermark" Classes="section-label"/>
                                    <TextBlock Text="Off" IsVisible="{Binding !ExportSettings.Watermark.Enabled}" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding WatermarkSummary}" IsVisible="{Binding ExportSettings.Watermark.Enabled}" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                <views:ExportWatermarkOptions/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    <TextBlock Text="Example for this photo" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding ExportPathExample}" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ExportSubfolderHelp}" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
            <StackPanel x:Name="ExportFooter" Grid.Row="1" Margin="15,8,15,15" Spacing="8">

                <views:ExportReportCard x:Name="ExportReport"/>
                <TextBlock x:Name="ExportValidationText" Text="{Binding ExportValidationReason}" IsVisible="{Binding HasExportValidationReason}" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                <StackPanel Spacing="10">
                    <TextBlock x:Name="ExportCountLineText" Text="{Binding ExportCountLine}" FontSize="{StaticResource FontSizeBody}"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button x:Name="RunExportButton" Content="{Binding ExportButtonLabel}" Classes="quiet-button accent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Command="{Binding RunExportCommand}"
                            AutomationProperties.Name="Run export"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
