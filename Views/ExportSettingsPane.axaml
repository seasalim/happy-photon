<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HappyPhoton.ViewModels"
             xmlns:views="using:HappyPhoton.Views"
             x:Class="HappyPhoton.Views.ExportSettingsPane"
             x:DataType="vm:MainWindowViewModel">
    <Border Background="{DynamicResource SurfaceMid}">
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="15,0,15,15" Spacing="4">
                <TextBlock Text="Recipes" Classes="section-label" Margin="0,20,0,8"/>
                <CheckBox Classes="edit-toggle" Content="Hi-Res · Original dimensions"
                          IsChecked="{Binding ExportSettings.ExportHiRes, Mode=TwoWay}"/>
                <Grid ColumnDefinitions="70,*,Auto" Height="28">
                    <CheckBox Classes="edit-toggle" Content="Web" IsChecked="{Binding ExportSettings.ExportWeb, Mode=TwoWay}"/>
                    <TextBox x:Name="WebMaxSizeField" Grid.Column="1" Classes="edit-field" Margin="0,0,5,0"
                             IsEnabled="{Binding ExportSettings.ExportWeb}"
                             Text="{Binding ExportSettings.WebMaxSize, Mode=TwoWay}"
                             AutomationProperties.Name="Web maximum dimension"/>
                    <TextBlock Grid.Column="2" Text="px" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                </Grid>
                <Grid ColumnDefinitions="70,*,Auto" Height="28">
                    <CheckBox Classes="edit-toggle" Content="Small" IsChecked="{Binding ExportSettings.ExportSmall, Mode=TwoWay}"/>
                    <TextBox x:Name="SmallMaxSizeField" Grid.Column="1" Classes="edit-field" Margin="0,0,5,0"
                             IsEnabled="{Binding ExportSettings.ExportSmall}"
                             Text="{Binding ExportSettings.SmallMaxSize, Mode=TwoWay}"
                             AutomationProperties.Name="Small maximum dimension"/>
                    <TextBlock Grid.Column="2" Text="px" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                </Grid>

                <TextBlock Text="Destination" Classes="section-label" Margin="0,20,0,8"/>
                <TextBox x:Name="ExportFolderField" Classes="edit-field"
                         Text="{Binding ExportSettings.OutputFolder, Mode=TwoWay}"
                         ToolTip.Tip="{Binding ExportSettings.OutputFolder}" AutomationProperties.Name="Export folder"/>
                <Button Classes="quiet-button" Content="Browse…" HorizontalAlignment="Left" Margin="0,4,0,0"
                        Click="OnBrowseClick" AutomationProperties.Name="Browse export folder"/>

                <TextBlock Text="Format" Classes="section-label" Margin="0,20,0,8"/>
                <ComboBox x:Name="ExportFormatBox" Classes="edit-dropdown" SelectedIndex="{Binding ExportSettings.Format, Mode=TwoWay}">
                    <ComboBoxItem Content="JPEG"/>
                    <ComboBoxItem Content="PNG"/>
                    <ComboBoxItem Content="WebP"/>
                    <ComboBoxItem Content="TIFF (16-bit)"/>
                </ComboBox>
                <views:CompactSlider x:Name="ExportQualitySlider" Label="Quality"
                                     Minimum="1" Maximum="100" SmallChange="1" StringFormat="{}{0:0}%"
                                     IsEnabled="{Binding IsExportQualityAvailable}"
                                     Value="{Binding ExportSettings.Quality, Mode=TwoWay}" Margin="0,4,0,0"/>

                <TextBlock Text="Color Space" Classes="section-label" Margin="0,20,0,8"/>
                <ListBox x:Name="ExportColorSpaceBox" Classes="segmented" SelectedIndex="{Binding ExportSettings.OutputColorSpace, Mode=TwoWay}"
                         SelectionMode="Single,AlwaysSelected">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" ColumnSpacing="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBoxItem Content="sRGB"/>
                    <ListBoxItem Content="Display P3"/>
                </ListBox>

                <TextBlock Text="Output Sharpening" Classes="section-label" Margin="0,20,0,8"/>
                <ListBox x:Name="ExportSharpeningBox" Classes="segmented" SelectedIndex="{Binding ExportSettings.OutputSharpening, Mode=TwoWay}"
                         SelectionMode="Single,AlwaysSelected">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" ColumnSpacing="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBoxItem Content="Off"/>
                    <ListBoxItem Content="Screen"/>
                    <ListBoxItem Content="Print"/>
                </ListBox>

                <TextBlock Text="Naming Pattern" Classes="section-label" Margin="0,20,0,8"/>
                <TextBox x:Name="ExportNamingPatternField" Classes="edit-field"
                         Text="{Binding ExportSettings.NamingPattern, Mode=TwoWay}"
                         PlaceholderText="{}{name}, {date}" AutomationProperties.Name="Export naming pattern"/>
                <CheckBox Classes="edit-toggle" Content="Strip location data" IsChecked="{Binding ExportSettings.StripLocationData, Mode=TwoWay}"/>

                <views:ExportReportCard Margin="0,16,0,0"/>
                <StackPanel Spacing="10" Margin="0,16,0,0">
                    <TextBlock x:Name="ExportCountLineText" Text="{Binding ExportCountLine}" FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button x:Name="RunExportButton" Content="Export" Height="30"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="{DynamicResource ControlActive}"
                            Foreground="{DynamicResource OnControlActive}"
                            BorderThickness="0" CornerRadius="{StaticResource RadiusMedium}"
                            FontFamily="{StaticResource FontBody}" FontSize="{StaticResource FontSizeBody}"
                            FontWeight="Bold" LetterSpacing="2"
                            Command="{Binding RunExportCommand}"
                            AutomationProperties.Name="Run export"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
