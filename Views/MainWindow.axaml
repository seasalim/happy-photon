<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HappyPhoton.ViewModels"
        xmlns:models="using:HappyPhoton.Models"
        xmlns:views="using:HappyPhoton.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="HappyPhoton.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Happy Photon"
        Icon="/Assets/happy-photon-icon.ico"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40"
        Width="1200" Height="700"
        MinWidth="800" MinHeight="500">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding EnterDevelopModeCommand}"/>
        <KeyBinding Gesture="Delete" Command="{Binding DeleteImageCommand}"/>
        <KeyBinding Gesture="Ctrl+E" Command="{Binding SwitchToExportCommand}"/>
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}"/>
        <KeyBinding Gesture="Ctrl+OemQuotes" Command="{Binding NewVersionFromCurrentCommand}"/>
        <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllCommand}"/>
        <KeyBinding Gesture="Ctrl+D" Command="{Binding DeselectAllCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+C" Command="{Binding CopyEditSettingsCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+V" Command="{Binding PasteEditSettingsCommand}"/>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleColorAssessmentModeCommand}"/>
        <KeyBinding Gesture="B" Command="{Binding ToggleBeforeAfterCommand}"/>
        <KeyBinding Gesture="W" Command="{Binding ToggleWhiteBalancePickerCommand}"/>
        <KeyBinding Gesture="J" Command="{Binding ToggleClippingOverlayCommand}"/>
        <KeyBinding Gesture="P" Command="{Binding TogglePickedImageCommand}"/>
        <KeyBinding Gesture="X" Command="{Binding ToggleRejectedImageCommand}"/>
        <KeyBinding Gesture="U" Command="{Binding UnpickImageCommand}"/>
        <KeyBinding Gesture="D0" Command="{Binding SetRatingCommand}"><KeyBinding.CommandParameter><x:Int32>0</x:Int32></KeyBinding.CommandParameter></KeyBinding>
        <KeyBinding Gesture="D1" Command="{Binding SetRatingCommand}"><KeyBinding.CommandParameter><x:Int32>1</x:Int32></KeyBinding.CommandParameter></KeyBinding>
        <KeyBinding Gesture="D2" Command="{Binding SetRatingCommand}"><KeyBinding.CommandParameter><x:Int32>2</x:Int32></KeyBinding.CommandParameter></KeyBinding>
        <KeyBinding Gesture="D3" Command="{Binding SetRatingCommand}"><KeyBinding.CommandParameter><x:Int32>3</x:Int32></KeyBinding.CommandParameter></KeyBinding>
        <KeyBinding Gesture="D4" Command="{Binding SetRatingCommand}"><KeyBinding.CommandParameter><x:Int32>4</x:Int32></KeyBinding.CommandParameter></KeyBinding>
        <KeyBinding Gesture="D5" Command="{Binding SetRatingCommand}"><KeyBinding.CommandParameter><x:Int32>5</x:Int32></KeyBinding.CommandParameter></KeyBinding>
        <KeyBinding Gesture="D6" Command="{Binding SetColorLabelCommand}"><KeyBinding.CommandParameter><models:ColorLabel>Red</models:ColorLabel></KeyBinding.CommandParameter></KeyBinding>
        <KeyBinding Gesture="D7" Command="{Binding SetColorLabelCommand}"><KeyBinding.CommandParameter><models:ColorLabel>Yellow</models:ColorLabel></KeyBinding.CommandParameter></KeyBinding>
        <KeyBinding Gesture="D8" Command="{Binding SetColorLabelCommand}"><KeyBinding.CommandParameter><models:ColorLabel>Green</models:ColorLabel></KeyBinding.CommandParameter></KeyBinding>
        <KeyBinding Gesture="D9" Command="{Binding SetColorLabelCommand}"><KeyBinding.CommandParameter><models:ColorLabel>Blue</models:ColorLabel></KeyBinding.CommandParameter></KeyBinding>
        <KeyBinding Gesture="E" Command="{Binding ToggleViewModeCommand}"/>
        <KeyBinding Gesture="Escape" Command="{Binding HandleEscapeCommand}"/>
        <KeyBinding Gesture="G" Command="{Binding SwitchToBrowseCommand}"/>
        <KeyBinding Gesture="D" Command="{Binding SwitchToDevelopCommand}"/>
        <KeyBinding Gesture="F" Command="{Binding ToggleFullScreenCommand}"/>
    </Window.KeyBindings>

    <Window.Styles>
        <StyleInclude Source="avares://HappyPhoton/Views/MainWindowStyles.axaml"/>
    </Window.Styles>

    <Panel>
    <Grid RowDefinitions="40,*,Auto,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="150"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="250" MinWidth="200"/>
        </Grid.ColumnDefinitions>

        <views:HappyPhotonTitleBar x:Name="HappyPhotonTitleBar" Grid.Row="0" Grid.ColumnSpan="5"/>

        <!-- Left Panel: Navigator + Folder Tree -->
        <Border x:Name="TourLeftPanel"
                Grid.Row="1" Grid.Column="0" Background="{DynamicResource SurfaceLow}"
                Classes="tour-region"
                Classes.tour-dimmed="{Binding IsWorkflowTourPresented}"
                IsEnabled="{Binding IsWorkspaceInteractionEnabled}">
            <Panel>
            <Grid RowDefinitions="Auto,8,*" IsVisible="{Binding IsBrowseOrDevelopMode}">
                <!-- Navigator -->
                <Border x:Name="NavigatorPanel"
                        Grid.Row="0" Background="{DynamicResource SurfaceHigh}" Padding="8"
                        BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Classes="section-label" Text="NAVIGATOR" Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource SurfaceLow}" CornerRadius="3"
                                Height="140" HorizontalAlignment="Stretch">
                            <Grid>
                                <Image x:Name="NavigatorThumbnailImage"
                                       Source="{Binding SelectedImage.Thumbnail}"
                                       Stretch="Uniform"
                                       Margin="4"/>
                                <Image x:Name="NavigatorPreviewImage"
                                       Source="{Binding PreviewImage}"
                                       IsVisible="{Binding IsDevelopMode}"
                                       Stretch="Uniform"
                                       Margin="4"/>
                                <views:NavigatorViewportOverlay x:Name="NavigatorViewportOverlay"
                                                                Source="{Binding PreviewImage}"
                                                                VisibleRegion="{Binding NavigatorVisibleRegion}"
                                                                Stroke="{DynamicResource NavigatorViewportStroke}"
                                                                Halo="{DynamicResource NavigatorViewportHalo}"
                                                                IsVisible="{Binding NavigatorVisibleRegion, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                IsHitTestVisible="False"
                                                                Margin="4"/>
                            </Grid>
                        </Border>
                        <Border Background="{DynamicResource SurfaceMid}"
                                BorderBrush="{DynamicResource OutlineVariant}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Padding="8"
                                Margin="0,8,0,0"
                                IsVisible="{Binding SelectedImage.SourceRequiresHydration, FallbackValue=False}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="This original is online-only."
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                                <Button x:Name="DownloadAndOpenButton"
                                         Content="Download and open"
                                         Classes="accent"
                                         Command="{Binding DownloadAndOpenCommand}"
                                         HorizontalAlignment="Left"
                                         FontSize="10"
                                         Padding="8,4"
                                         AutomationProperties.Name="Download and open selected original"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Folder Tree (Browse mode) -->
                <views:FolderTreePanel Grid.Row="2" x:Name="FolderTreePanel"
                                       IsVisible="{Binding IsBrowseGridVisible}"
                                       RootFolders="{Binding RootFolders}"
                                       SelectedFolder="{Binding SelectedFolder, Mode=TwoWay}"
                                       BrowsingFolderName="{Binding BrowsingFolderName}"
                                       ViewingFolderName="{Binding ViewingFolderName}"/>

                <!-- Presets Panel (Develop mode) -->
                <views:PresetsPanel Grid.Row="2" x:Name="PresetsPanel"
                                     IsVisible="{Binding IsDevelopMode}"
                                     IsEnabled="{Binding CanEditSelectedImage}"
                                     CanSavePreset="{Binding CanSavePreset}"
                                     ActivePresetId="{Binding ActivePresetId}"/>
            </Grid>
            <views:ExportCapturePane x:Name="ExportCapturePane" IsVisible="{Binding IsExportMode}"/>
            </Panel>
        </Border>

        <GridSplitter Grid.Row="1" Grid.Column="1" Classes="panel-splitter"
                      ResizeDirection="Columns"
                      IsEnabled="{Binding IsWorkspaceInteractionEnabled}"/>

        <!-- Center Panel: Browse/Develop View -->
        <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource ViewerSurround}"
                IsEnabled="{Binding IsWorkspaceInteractionEnabled}">
            <Panel>
                <!-- Browse Grid View -->
                <views:BrowseGridView x:Name="BrowseGridView"
                                       IsVisible="{Binding IsBrowseMode}"
                                       Images="{Binding Browse.VisibleImages}"
                                       TotalImageCount="{Binding Browse.TotalCount}"
                                       EmptyHeadingText="{Binding BrowseEmptyHeading}"
                                       EmptyMessageText="{Binding BrowseEmptyMessage}"
                                       SuppressEmptyState="{Binding IsWorkflowTourActive}"
                                       FileTypeFilter="{Binding Browse.FileTypeFilter, Mode=TwoWay}"
                                       FlagFilter="{Binding Browse.FlagFilter, Mode=TwoWay}"
                                       MinimumRating="{Binding Browse.MinimumRating, Mode=TwoWay}"
                                       ColorLabelFilter="{Binding Browse.ColorLabelFilter, Mode=TwoWay}"
                                       ShowBursts="{Binding ShowBurstGroups, Mode=TwoWay}"
                                       ThumbnailSize="{Binding BrowseThumbnailSize, Mode=TwoWay}"
                                       SelectedImage="{Binding SelectedImage, Mode=TwoWay}"/>

                <views:DevelopViewerPane x:Name="DevelopViewerPane"
                                         IsVisible="{Binding IsDevelopMode}"/>
                <views:ExportPreviewPane x:Name="ExportPreviewPane" IsVisible="{Binding IsExportMode}"/>
            </Panel>
        </Border>

        <GridSplitter Grid.Row="1" Grid.Column="3" Classes="panel-splitter"
                      ResizeDirection="Columns"
                      IsEnabled="{Binding IsWorkspaceInteractionEnabled}"/>
        <views:WorkflowCoachmark
            Grid.Row="1"
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Margin="12"
            IsVisible="{Binding IsShapePhotographTourVisible}"
            Pointer="Right"
            StepText="2 of 3"
            Heading="Shape the photograph"
            Body="Use the editing controls to adjust composition, exposure, white balance with Kelvin and tint, and other settings."
            PrimaryText="Next: Export"
            PrimaryCommand="{Binding ShowExportTourStepCommand}"
            SecondaryText="End tour"
            SecondaryCommand="{Binding EndWorkflowTourCommand}"/>

        <views:DevelopEditPanel x:Name="DevelopEditPanel"
                                Grid.Row="1" Grid.Column="4"
                                Classes="tour-region"
                                Classes.tour-dimmed="{Binding IsWorkflowTourPresented}"
                                Classes.tour-focus="{Binding IsShapePhotographTourVisible}"
                                IsVisible="{Binding IsDevelopMode}"
                                IsEnabled="{Binding CanEditSelectedImage}"/>

        <views:BrowseReviewPane x:Name="BrowseReviewPane"
                                 Grid.Row="1" Grid.Column="4"
                                 Classes="tour-region"
                                 Classes.tour-dimmed="{Binding IsWorkflowTourPresented}"
                                 IsVisible="{Binding IsBrowseMode}"/>

        <views:ExportSettingsPane x:Name="ExportSettingsPane"
                                  Grid.Row="1" Grid.Column="4"
                                  Classes="tour-region" Classes.tour-dimmed="{Binding IsWorkflowTourPresented}"
                                  Classes.tour-focus="{Binding IsDeliverCopiesTourVisible}"
                                  IsVisible="{Binding IsExportMode}"/>

        <views:WorkflowCoachmark
            Grid.Row="1"
            Grid.Column="4"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="12"
            IsVisible="{Binding IsDeliverCopiesTourVisible}"
            Pointer="Left"
            StepText="3 of 3"
            Heading="Export the edited images"
            Body="Review the captures and recipes here, then export finished copies. Originals remain untouched."
            PrimaryText="Finish"
            PrimaryCommand="{Binding FinishWorkflowTourCommand}"
            SecondaryText="End tour"
            SecondaryCommand="{Binding EndWorkflowTourCommand}"/>

        <views:ExportQueueStrip Grid.Row="2" Grid.ColumnSpan="5"/>

        <views:StatusBarView x:Name="TourStatusBar"
                             Grid.Row="3" Grid.ColumnSpan="5"
                             Classes="tour-region"
                             Classes.tour-dimmed="{Binding IsWorkflowTourPresented}"
                             IsEnabled="{Binding IsWorkspaceInteractionEnabled}"/>

        <views:StartupGateView Grid.Row="1" Grid.Column="2"
                               IsVisible="{Binding IsStartupGateVisible}"/>
    </Grid>

    <Border x:Name="FullScreenOverlay"
            Background="{DynamicResource FullScreenBackdrop}"
            IsVisible="{Binding IsFullScreenMode}">
        <Panel>
            <Image x:Name="FullScreenPlaceholderImage"
                   Source="{Binding SelectedImage.Thumbnail}"
                   IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNull}}"
                   Stretch="Uniform"
                   Margin="24"
                   RenderOptions.BitmapInterpolationMode="LowQuality"/>

            <views:ZoomPanControl x:Name="FullScreenZoomPanControl"
                                  Source="{Binding PreviewImage}"
                                  SourceIdentity="{Binding SelectedImage}"
                                  ZoomLevel="{Binding ZoomLevel}"
                                  OriginalViewPixelSize="{Binding OriginalViewPixelSize}"
                                  AutoFit="{Binding IsZoomFitMode}"
                                  IsColorAssessment="{Binding IsColorAssessmentMode}"
                                  IsDisplayTraceActive="{Binding IsFullScreenPreviewSurfaceActive}"
                                  ScrollBarVisibility="Hidden"/>

            <Border x:Name="FullScreenSelectionBadge"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="16,16,16,48"
                    Opacity="1"
                    IsHitTestVisible="False"
                    IsVisible="{Binding IsFullScreenSelectionRestricted}">
                <TextBlock Text="{Binding FullScreenSelectionBadgeText}"
                           FontFamily="{StaticResource FontLabel}"
                           FontSize="{StaticResource FontSizeLabel}"
                           Foreground="{DynamicResource TextMuted}"/>
            </Border>
            <Button x:Name="FullScreenExitButton"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="12" Padding="0"
                    Background="Transparent" Foreground="{DynamicResource TextMuted}"
                    BorderThickness="0" CornerRadius="999"
                    Opacity="0" IsHitTestVisible="False"
                    Command="{Binding ToggleFullScreenCommand}"
                    ToolTip.Tip="Exit fullscreen (Escape)"
                    AutomationProperties.Name="Exit fullscreen">
                <Button.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.18"
                                          Easing="QuadraticEaseOut"/>
                    </Transitions>
                </Button.Transitions>
                <Grid>
                    <Border Background="{DynamicResource SurfaceLowest}" Opacity="0.62" CornerRadius="999"/>
                    <StackPanel Orientation="Horizontal" Spacing="7" Margin="10,4">
                    <Viewbox Width="11" Height="11">
                        <Canvas Width="16" Height="16">
                            <Path Data="M 6,2 L 6,6 L 2,6 M 14,6 L 10,6 L 10,2 M 10,14 L 10,10 L 14,10 M 2,10 L 6,10 L 6,14"
                                  Fill="Transparent" Stroke="{DynamicResource TextMuted}"
                                  StrokeThickness="1.5" StrokeLineCap="Round"
                                  StrokeJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="EXIT FULLSCREEN · ESC" FontFamily="{StaticResource FontLabel}"
                               FontSize="9" LetterSpacing="1.2"/>
                    </StackPanel>
                </Grid>
            </Button>
        </Panel>
    </Border>
    </Panel>
</Window>
