<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HappyPhoton.ViewModels"
        xmlns:models="using:HappyPhoton.Models"
        xmlns:views="using:HappyPhoton.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="HappyPhoton.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Happy Photon"
        Icon="/Assets/happy-photon-icon.ico"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40"
        Width="1200" Height="700"
        MinWidth="800" MinHeight="500">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding EnterDevelopModeCommand}"/>
        <KeyBinding Gesture="Delete" Command="{Binding DeleteImageCommand}"/>
        <KeyBinding Gesture="Ctrl+E" Command="{Binding ShowExportDialogCommand}"/>
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}"/>
        <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllCommand}"/>
        <KeyBinding Gesture="Ctrl+D" Command="{Binding DeselectAllCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+C" Command="{Binding CopyEditSettingsCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+V" Command="{Binding PasteEditSettingsCommand}"/>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleColorAssessmentModeCommand}"/>
        <KeyBinding Gesture="B" Command="{Binding ToggleBeforeAfterCommand}"/>
        <KeyBinding Gesture="W" Command="{Binding ToggleWhiteBalancePickerCommand}"/>
        <KeyBinding Gesture="J" Command="{Binding ToggleClippingOverlayCommand}"/>
        <KeyBinding Gesture="P" Command="{Binding TogglePickedImageCommand}"/>
        <KeyBinding Gesture="X" Command="{Binding ToggleRejectedImageCommand}"/>
        <KeyBinding Gesture="U" Command="{Binding UnpickImageCommand}"/>
        <KeyBinding Gesture="D0" Command="{Binding SetRatingCommand}"><KeyBinding.CommandParameter><x:Int32>0</x:Int32></KeyBinding.CommandParameter></KeyBinding>
        <KeyBinding Gesture="D1" Command="{Binding SetRatingCommand}"><KeyBinding.CommandParameter><x:Int32>1</x:Int32></KeyBinding.CommandParameter></KeyBinding>
        <KeyBinding Gesture="D2" Command="{Binding SetRatingCommand}"><KeyBinding.CommandParameter><x:Int32>2</x:Int32></KeyBinding.CommandParameter></KeyBinding>
        <KeyBinding Gesture="D3" Command="{Binding SetRatingCommand}"><KeyBinding.CommandParameter><x:Int32>3</x:Int32></KeyBinding.CommandParameter></KeyBinding>
        <KeyBinding Gesture="D4" Command="{Binding SetRatingCommand}"><KeyBinding.CommandParameter><x:Int32>4</x:Int32></KeyBinding.CommandParameter></KeyBinding>
        <KeyBinding Gesture="D5" Command="{Binding SetRatingCommand}"><KeyBinding.CommandParameter><x:Int32>5</x:Int32></KeyBinding.CommandParameter></KeyBinding>
        <KeyBinding Gesture="D6" Command="{Binding SetColorLabelCommand}"><KeyBinding.CommandParameter><models:ColorLabel>Red</models:ColorLabel></KeyBinding.CommandParameter></KeyBinding>
        <KeyBinding Gesture="D7" Command="{Binding SetColorLabelCommand}"><KeyBinding.CommandParameter><models:ColorLabel>Yellow</models:ColorLabel></KeyBinding.CommandParameter></KeyBinding>
        <KeyBinding Gesture="D8" Command="{Binding SetColorLabelCommand}"><KeyBinding.CommandParameter><models:ColorLabel>Green</models:ColorLabel></KeyBinding.CommandParameter></KeyBinding>
        <KeyBinding Gesture="D9" Command="{Binding SetColorLabelCommand}"><KeyBinding.CommandParameter><models:ColorLabel>Blue</models:ColorLabel></KeyBinding.CommandParameter></KeyBinding>
        <KeyBinding Gesture="E" Command="{Binding ToggleViewModeCommand}"/>
        <KeyBinding Gesture="Escape" Command="{Binding HandleEscapeCommand}"/>
        <KeyBinding Gesture="G" Command="{Binding SwitchToLibraryCommand}"/>
        <KeyBinding Gesture="D" Command="{Binding SwitchToDevelopCommand}"/>
        <KeyBinding Gesture="F" Command="{Binding ToggleFullScreenCommand}"/>
    </Window.KeyBindings>

    <Window.Styles>
        <Style Selector="GridSplitter.panel-splitter">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Margin" Value="-2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Width="1" Background="{DynamicResource Divider}"
                            HorizontalAlignment="Center"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector=":is(Control).tour-region.tour-dimmed">
            <Setter Property="Opacity" Value="{DynamicResource TourDimmedOpacity}"/>
        </Style>
        <Style Selector=":is(Control).tour-region.tour-dimmed.tour-focus">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <!-- Opt-in focus glow. Deliberately not applied to DevelopEditPanel: on a
             full-height column the glow is invisible, while the effect would force
             the live editing controls through an offscreen surface on every slider
             change. Small targets only. -->
        <Style Selector=":is(Control).tour-region.tour-dimmed.tour-focus.tour-glow">
            <Setter Property="Effect">
                <DropShadowEffect Color="{StaticResource PrimaryContainerColor}"
                                  BlurRadius="18"
                                  OffsetX="0"
                                  OffsetY="0"
                                  Opacity="{DynamicResource TourFocusGlowOpacity}"/>
            </Setter>
        </Style>
    </Window.Styles>

    <Panel>
    <Grid RowDefinitions="40,*,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="150"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="250" MinWidth="200"/>
        </Grid.ColumnDefinitions>

        <views:HappyPhotonTitleBar Grid.Row="0" Grid.ColumnSpan="5"/>

        <!-- Left Panel: Navigator + Folder Tree -->
        <Border x:Name="TourLeftPanel"
                Grid.Row="1" Grid.Column="0" Background="{DynamicResource SurfaceLow}"
                Classes="tour-region"
                Classes.tour-dimmed="{Binding IsWorkflowTourPresented}"
                IsEnabled="{Binding IsWorkspaceInteractionEnabled}">
            <Grid RowDefinitions="Auto,8,*">
                <!-- Navigator -->
                <Border x:Name="NavigatorPanel"
                        Grid.Row="0" Background="{DynamicResource SurfaceHigh}" Padding="8"
                        BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1"
                        IsVisible="{Binding HasSelectedImage}">
                    <StackPanel>
                        <TextBlock Classes="section-label" Text="NAVIGATOR" Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource SurfaceLow}" CornerRadius="3"
                                Height="140" HorizontalAlignment="Stretch">
                            <Grid>
                                <Image x:Name="NavigatorThumbnailImage"
                                       Source="{Binding SelectedImage.Thumbnail}"
                                       Stretch="Uniform"
                                       Margin="4"/>
                                <Image x:Name="NavigatorPreviewImage"
                                       Source="{Binding PreviewImage}"
                                       IsVisible="{Binding IsDevelopMode}"
                                       Stretch="Uniform"
                                       Margin="4"/>
                                <views:NavigatorViewportOverlay x:Name="NavigatorViewportOverlay"
                                                                Source="{Binding PreviewImage}"
                                                                VisibleRegion="{Binding NavigatorVisibleRegion}"
                                                                Stroke="{DynamicResource NavigatorViewportStroke}"
                                                                Halo="{DynamicResource NavigatorViewportHalo}"
                                                                IsVisible="{Binding NavigatorVisibleRegion, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                IsHitTestVisible="False"
                                                                Margin="4"/>
                            </Grid>
                        </Border>
                        <Border Background="{DynamicResource SurfaceMid}"
                                BorderBrush="{DynamicResource OutlineVariant}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Padding="8"
                                Margin="0,8,0,0"
                                IsVisible="{Binding SelectedImage.SourceRequiresHydration}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="This original is online-only."
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                                <Button x:Name="DownloadAndOpenButton"
                                         Content="Download and open"
                                         Classes="accent"
                                         Command="{Binding DownloadAndOpenCommand}"
                                         HorizontalAlignment="Left"
                                         FontSize="10"
                                         Padding="8,4"
                                         AutomationProperties.Name="Download and open selected original"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Folder Tree (Library mode) -->
                <views:FolderTreePanel Grid.Row="2" x:Name="FolderTreePanel"
                                       IsVisible="{Binding !IsDevelopMode}"
                                       RootFolders="{Binding RootFolders}"
                                       SelectedFolder="{Binding SelectedFolder, Mode=TwoWay}"
                                       BrowsingFolderName="{Binding BrowsingFolderName}"
                                       ViewingFolderName="{Binding ViewingFolderName}"/>

                <!-- Presets Panel (Develop mode) -->
                <views:PresetsPanel Grid.Row="2" x:Name="PresetsPanel"
                                     IsVisible="{Binding IsDevelopMode}"
                                     IsEnabled="{Binding CanEditSelectedImage}"
                                     CanSavePreset="{Binding CanSavePreset}"
                                     ActivePresetId="{Binding ActivePresetId}"/>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="1" Grid.Column="1" Classes="panel-splitter"
                      ResizeDirection="Columns"
                      IsEnabled="{Binding IsWorkspaceInteractionEnabled}"/>

        <!-- Center Panel: Library/Develop View -->
        <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource ViewerSurround}"
                IsEnabled="{Binding IsWorkspaceInteractionEnabled}">
            <Panel>
                <!-- Library Grid View (when not in Develop mode) -->
                <views:LibraryGridView x:Name="LibraryGridView"
                                       IsVisible="{Binding !IsDevelopMode}"
                                       Images="{Binding Library.VisibleImages}"
                                       TotalImageCount="{Binding Library.TotalCount}"
                                       EmptyHeadingText="{Binding LibraryEmptyHeading}"
                                       EmptyMessageText="{Binding LibraryEmptyMessage}"
                                       SuppressEmptyState="{Binding IsWorkflowTourActive}"
                                       FileTypeFilter="{Binding Library.FileTypeFilter, Mode=TwoWay}"
                                       FlagFilter="{Binding Library.FlagFilter, Mode=TwoWay}"
                                       MinimumRating="{Binding Library.MinimumRating, Mode=TwoWay}"
                                       ColorLabelFilter="{Binding Library.ColorLabelFilter, Mode=TwoWay}"
                                       ShowBursts="{Binding ShowBurstGroups, Mode=TwoWay}"
                                       ThumbnailSize="{Binding LibraryThumbnailSize, Mode=TwoWay}"
                                       SelectedImage="{Binding SelectedImage, Mode=TwoWay}"/>

                <!-- Develop View (when in Develop mode) -->
                <Grid IsVisible="{Binding IsDevelopMode}" RowDefinitions="*,Auto">
                        <!-- Zoomable Image -->
                        <Panel Grid.Row="0">
                            <!-- Placeholder thumbnail (scaled up, shown while full preview loads) -->
                            <Image x:Name="DevelopPlaceholderImage"
                                   Source="{Binding SelectedImage.Thumbnail}"
                                   IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNull}}"
                                   Stretch="Uniform"
                                   Margin="10"
                                   RenderOptions.BitmapInterpolationMode="LowQuality"/>

                            <views:ZoomPanControl x:Name="ZoomPanControl"
                                                  Source="{Binding PreviewImage}"
                                                  ZoomLevel="{Binding ZoomLevel}"
                                                  OriginalViewPixelSize="{Binding OriginalViewPixelSize}"
                                                  AutoFit="{Binding IsZoomFitMode}"
                                                  IsCropMode="{Binding IsCropMode}"
                                                  IsWhiteBalancePicking="{Binding IsWhiteBalancePicking}"
                                                  IsColorAssessment="{Binding IsColorAssessmentMode}"
                                                  IsDisplayTraceActive="{Binding IsDevelopPreviewSurfaceActive}"
                                                  ClippingMask="{Binding PreviewClippingMask}"
                                                  VisibleClippingSides="{Binding VisibleClippingOverlaySides}"
                                                  IsClippingOverlayLatched="{Binding IsClippingOverlayLatched}"
                                                  IsCropAspectLocked="{Binding IsCropAspectLocked}"
                                                  Crop="{Binding CurrentCrop, Mode=TwoWay}"
                                                  ScrollBarVisibility="Hidden"
                                                  ContentInset="10"/>

                            <views:AssessmentFeedbackOverlay x:Name="DevelopAssessmentFeedbackOverlay"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Bottom"
                                                             Margin="16,16,16,32"/>

                            <Border x:Name="DevelopEmptyState"
                                    IsVisible="{Binding IsDevelopEmptyStateVisible}"
                                    Background="{DynamicResource SurfaceLow}"
                                    CornerRadius="{StaticResource RadiusMedium}"
                                    Padding="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Select an image to edit"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="16"/>
                            </Border>
                        </Panel>

                        <!-- Rotation and Zoom Controls -->
                        <Border x:Name="DevelopControlBar" Grid.Row="1" Padding="12,6"
                                Background="{DynamicResource ViewerControlBarBackground}"
                                CornerRadius="{StaticResource RadiusMedium}"
                                IsEnabled="{Binding HasSelectedImage}"
                                HorizontalAlignment="Center" Margin="0,4,0,8">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="RotateLeftButton"
                                        Command="{Binding RotateLeftCommand}"
                                        IsEnabled="{Binding CanEditSelectedImage}"
                                        Content="↶"
                                        ToolTip.Tip="Rotate Left (90° counter-clockwise)"
                                        FontSize="14" Padding="8,3"
                                        BorderThickness="0"/>
                                <Button Command="{Binding RotateRightCommand}"
                                        IsEnabled="{Binding CanEditSelectedImage}"
                                        Content="↷"
                                        ToolTip.Tip="Rotate Right (90° clockwise)"
                                        FontSize="14" Padding="8,3"
                                        BorderThickness="0"/>
                                <ToggleButton IsChecked="{Binding IsCropMode, Mode=OneWay}"
                                              Command="{Binding ToggleCropModeCommand}"
                                              IsEnabled="{Binding CanEditSelectedImage}"
                                              ToolTip.Tip="Crop Image (C)"
                                              FontSize="14" Padding="8,3"
                                              BorderThickness="0">
                                    <TextBlock Text="⬚" FontSize="14"/>
                                </ToggleButton>
                                <Rectangle Width="1" Height="16" Fill="{DynamicResource Outline}" Margin="4,0"/>
                                <views:CompactSlider Label="Zoom"
                                                     Value="{Binding ManualZoomLevel, Mode=TwoWay}"
                                                     Minimum="0.1" Maximum="5"
                                                     SmallChange="0.1"
                                                     StringFormat="{}{0:P0}"
                                                     Width="180"/>
                                <Button Command="{Binding ZoomFitCommand}"
                                        Content="Fit"
                                        ToolTip.Tip="Fit to View"
                                        FontSize="10" Padding="8,3"
                                        BorderThickness="0"/>
                                <ToggleButton x:Name="ColorAssessmentButton"
                                              IsChecked="{Binding IsColorAssessmentMode, Mode=OneWay}"
                                              Command="{Binding ToggleColorAssessmentModeCommand}"
                                              Content="Assess"
                                              ToolTip.Tip="Color assessment mode (Ctrl+B)"
                                              FontSize="10" Padding="8,3"
                                              BorderThickness="0"/>
                                <!-- Crop action buttons (visible in crop mode) -->
                                <Rectangle Width="1" Height="16" Fill="{DynamicResource Outline}" Margin="4,0"
                                           IsVisible="{Binding IsCropMode}"/>
                                <StackPanel Orientation="Horizontal" Spacing="4"
                                            IsVisible="{Binding IsCropMode}"
                                            IsEnabled="{Binding CanEditSelectedImage}">
                                    <views:CompactSlider Label="Horizon"
                                                         Value="{Binding HorizonRotation}"
                                                         Minimum="-5" Maximum="5"
                                                         SmallChange="0.1"
                                                         StringFormat="{}{0:+0.0;-0.0;0.0}°"
                                                         EnableDoubleClickReset="True"
                                                         Width="150"/>
                                    <ToggleButton IsChecked="{Binding IsCropAspectLocked}"
                                                  ToolTip.Tip="Lock Aspect Ratio"
                                                  FontSize="10" Padding="8,4"
                                                  BorderThickness="0">
                                        <TextBlock Text="🔒" FontSize="12"/>
                                    </ToggleButton>
                                    <Button Command="{Binding ApplyCropCommand}"
                                            Content="Apply"
                                            ToolTip.Tip="Apply Crop (Enter)"
                                            FontSize="10" Padding="10,4"
                                            Classes="accent"
                                            BorderThickness="0"/>
                                    <Button Command="{Binding ResetCropCommand}"
                                            Content="Reset"
                                            ToolTip.Tip="Reset Crop"
                                            FontSize="10" Padding="8,4"
                                            BorderThickness="0"/>
                                    <Button Command="{Binding CancelCropCommand}"
                                            Content="Cancel"
                                            ToolTip.Tip="Cancel (Escape)"
                                            FontSize="10" Padding="8,4"
                                            BorderThickness="0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
            </Panel>
        </Border>

        <GridSplitter Grid.Row="1" Grid.Column="3" Classes="panel-splitter"
                      ResizeDirection="Columns"
                      IsEnabled="{Binding IsWorkspaceInteractionEnabled}"/>
        <views:WorkflowCoachmark
            Grid.Row="1"
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Margin="12"
            IsVisible="{Binding IsShapePhotographTourVisible}"
            Pointer="Right"
            StepText="2 of 3"
            Heading="Shape the photograph"
            Body="Use the editing controls to adjust composition, exposure, white balance with Kelvin and tint, and other settings."
            PrimaryText="Next: Export"
            PrimaryCommand="{Binding ShowExportTourStepCommand}"
            SecondaryText="End tour"
            SecondaryCommand="{Binding EndWorkflowTourCommand}"/>

        <views:DevelopEditPanel x:Name="DevelopEditPanel"
                                Grid.Row="1" Grid.Column="4"
                                Classes="tour-region"
                                Classes.tour-dimmed="{Binding IsWorkflowTourPresented}"
                                Classes.tour-focus="{Binding IsShapePhotographTourVisible}"
                                IsVisible="{Binding IsDevelopMode}"
                                IsEnabled="{Binding CanEditSelectedImage}"/>

        <views:LibraryReviewPane x:Name="LibraryReviewPane"
                                 Grid.Row="1" Grid.Column="4"
                                 Classes="tour-region"
                                 Classes.tour-dimmed="{Binding IsWorkflowTourPresented}"
                                 IsVisible="{Binding !IsDevelopMode}"/>

        <views:StatusBarView x:Name="TourStatusBar"
                             Grid.Row="2" Grid.ColumnSpan="5"
                             Classes="tour-region"
                             Classes.tour-dimmed="{Binding IsWorkflowTourPresented}"
                             IsEnabled="{Binding IsWorkspaceInteractionEnabled}"/>

        <views:StartupGateView Grid.Row="1" Grid.Column="2"
                               IsVisible="{Binding IsStartupGateVisible}"/>
    </Grid>

    <Border Background="{DynamicResource FullScreenBackdrop}"
            IsVisible="{Binding IsFullScreenMode}">
        <Panel>
            <Image x:Name="FullScreenPlaceholderImage"
                   Source="{Binding SelectedImage.Thumbnail}"
                   IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNull}}"
                   Stretch="Uniform"
                   Margin="24"
                   RenderOptions.BitmapInterpolationMode="LowQuality"/>

            <views:ZoomPanControl x:Name="FullScreenZoomPanControl"
                                  Source="{Binding PreviewImage}"
                                  ZoomLevel="{Binding ZoomLevel}"
                                  OriginalViewPixelSize="{Binding OriginalViewPixelSize}"
                                  AutoFit="{Binding IsZoomFitMode}"
                                  IsColorAssessment="{Binding IsColorAssessmentMode}"
                                  IsDisplayTraceActive="{Binding IsFullScreenPreviewSurfaceActive}"
                                  ScrollBarVisibility="Hidden"/>

            <Border x:Name="FullScreenSelectionBadge"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="16"
                    Opacity="1"
                    IsHitTestVisible="False"
                    IsVisible="{Binding IsFullScreenSelectionRestricted}">
                <TextBlock Text="{Binding FullScreenSelectionBadgeText}"
                           FontFamily="{StaticResource FontLabel}"
                           FontSize="{StaticResource FontSizeLabel}"
                           Foreground="{DynamicResource TextMuted}"/>
            </Border>

        </Panel>
    </Border>
    </Panel>
</Window>
