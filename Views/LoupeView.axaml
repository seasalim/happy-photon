<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:HappyPhoton.Views"
             xmlns:vm="using:HappyPhoton.ViewModels"
             x:Class="HappyPhoton.Views.LoupeView"
             x:DataType="vm:MainWindowViewModel"
             Focusable="True"
             Background="{DynamicResource ViewerSurround}">
    <Grid RowDefinitions="*,Auto">
        <Panel>
            <Image Source="{Binding LoupePane.Image.Thumbnail}"
                   IsVisible="{Binding LoupePane.Preview, Converter={x:Static ObjectConverters.IsNull}}"
                   Stretch="Uniform" Margin="10" RenderOptions.BitmapInterpolationMode="LowQuality"/>
            <views:ZoomPanControl x:Name="LoupeZoomPanControl"
                                  Source="{Binding LoupePane.Preview}"
                                  DisplayTransform="{Binding DisplayTransform}"
                                  SourceIdentity="{Binding LoupePane.Image}"
                                  ZoomLevel="{Binding ZoomLevel}"
                                  OriginalViewPixelSize="{Binding LoupePane.OriginalViewPixelSize}"
                                  AutoFit="{Binding IsZoomFitMode}" ScrollBarVisibility="Hidden"
                                  ContentInset="10"/>
            <TextBlock Text="Loading preview…"
                       IsVisible="{Binding LoupePane.ShowLoadingMessage}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
            <views:AssessmentFeedbackOverlay x:Name="LoupeAssessmentFeedbackOverlay"
                                             HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,16,16,32"/>
        </Panel>
        <Border Grid.Row="1" Padding="12,6"
                Background="{DynamicResource ViewerControlBarBackground}"
                CornerRadius="{StaticResource RadiusMedium}" HorizontalAlignment="Center" Margin="0,4,0,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="LoupePreviousButton" Command="{Binding SelectPreviousImageCommand}"
                        Content="←" ToolTip.Tip="Previous image (←)" Padding="7,3" BorderThickness="0"/>
                <Button x:Name="LoupeNextButton" Command="{Binding SelectNextImageCommand}"
                        Content="→" ToolTip.Tip="Next image (→)" Padding="7,3" BorderThickness="0"/>
                <Rectangle Width="1" Height="16" Fill="{DynamicResource Outline}" Margin="4,0"/>
                <ToggleButton x:Name="LoupeActualSizeButton"
                              IsChecked="{Binding !IsZoomFitMode, Mode=OneWay}" Command="{Binding ToggleActualSizeCommand}"
                              Content="1:1" ToolTip.Tip="Fit / 1:1 (Space or Z)" FontSize="10" Padding="8,3" BorderThickness="0"/>
                <Button x:Name="LoupeFullScreenButton" Command="{Binding ToggleFullScreenCommand}"
                        Content="Full" ToolTip.Tip="Fullscreen (F)" FontSize="10" Padding="8,3" BorderThickness="0"/>
                <Button x:Name="LoupeGridButton"
                        Command="{Binding ExitLoupeCommand}" Content="Grid"
                        ToolTip.Tip="Return to grid (G)" FontSize="10" Padding="8,3" BorderThickness="0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
