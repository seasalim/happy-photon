<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HappyPhoton.ViewModels"
        x:Class="HappyPhoton.Views.PasteSettingsDialog"
        x:DataType="vm:PasteSettingsViewModel"
        Title="{Binding WindowTitle}" Width="660" Height="572"
        CanResize="False" WindowStartupLocation="CenterOwner"
        Classes="dialog">
    <Window.Styles>
        <Style Selector="Button.accent:disabled">
            <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}"/>
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Classes="dialog-content">
            <StackPanel Spacing="7">
                <TextBlock Text="{Binding Heading}" Classes="dialog-title"/>
                <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding Summary}"
                           Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="20,0,20,16" ColumnDefinitions="*,*">
            <StackPanel Spacing="8">
                <TextBlock Text="Look" Classes="section-label"/>
                <ItemsControl ItemsSource="{Binding LookGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PasteSettingsGroupViewModel">
                            <StackPanel>
                                <CheckBox Content="{Binding Group.Name}" IsChecked="{Binding IsSelected}"
                                          FontSize="{StaticResource FontSizeLabel}"/>
                                <TextBlock Text="{Binding Note}" TextWrapping="Wrap"
                                           IsVisible="{Binding HasOwnValues}"
                                           Classes="dialog-note"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="18">
                    <Button Content="All" Classes="compact-button" Command="{Binding AllCommand}"/>
                    <Button Content="None" Classes="compact-button" Command="{Binding NoneCommand}"/>
                    <Button Content="Defaults" Classes="compact-button" Command="{Binding DefaultsCommand}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock Text="This photo's own" Classes="section-label"/>
                <ItemsControl ItemsSource="{Binding PhotoGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PasteSettingsGroupViewModel">
                            <StackPanel Margin="0,0,0,12">
                                <CheckBox Content="{Binding Group.Name}" IsChecked="{Binding IsSelected}"
                                          FontSize="{StaticResource FontSizeLabel}"/>
                                <TextBlock Text="{Binding Note}" TextWrapping="Wrap"
                                           Classes="dialog-note"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" Classes="dialog-footer">
            <StackPanel Classes="dialog-buttons">
                <Button x:Name="CancelButton" Content="Cancel" Classes="quiet-button" Click="OnCancel"/>
                <Button x:Name="PasteButton" Content="{Binding PrimaryLabel}" Classes="quiet-button accent"
                        IsEnabled="{Binding CanPaste}" Click="OnPaste"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
