<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:HappyPhoton.Views"
             x:Class="HappyPhoton.Views.WorkflowCoachmark"
             x:Name="Root"
             x:DataType="views:WorkflowCoachmark"
             MinWidth="280"
             MaxWidth="370">
    <Border Background="{StaticResource SurfaceHigh}"
            BorderBrush="{StaticResource Divider}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusLarge}"
            Padding="18"
            BoxShadow="0 12 30 0 #99000000">
        <StackPanel Spacing="10">
            <TextBlock Text="{Binding StepText, ElementName=Root}"
                       FontFamily="{StaticResource FontLabel}"
                       FontSize="{StaticResource FontSizeSmall}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryContainer}"
                       LetterSpacing="1"/>
            <TextBlock Text="{Binding Heading, ElementName=Root}"
                       FontFamily="{StaticResource FontHeading}"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Body, ElementName=Root}"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondary}"
                       LineHeight="18"
                       TextWrapping="Wrap"/>
            <WrapPanel Margin="0,4,0,0"
                       Orientation="Horizontal">
                <Button Content="{Binding PrimaryText, ElementName=Root}"
                        Command="{Binding PrimaryCommand, ElementName=Root}"
                        Classes="accent"
                        Margin="0,0,8,8"
                        Padding="12,6"/>
                <Button Content="{Binding SecondaryText, ElementName=Root}"
                        Command="{Binding SecondaryCommand, ElementName=Root}"
                        Margin="0,0,8,8"
                        Padding="12,6"/>
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
