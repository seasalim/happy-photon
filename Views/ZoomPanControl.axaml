<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:HappyPhoton.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="HappyPhoton.Views.ZoomPanControl"
             ClipToBounds="True">

    <UserControl.Styles>
        <Style Selector="Panel#SurroundLayer.assessment-on">
            <Setter Property="Background" Value="{StaticResource AssessmentGray}"/>
        </Style>
        <Style Selector="Border#AssessmentMat.assessment-on">
            <Setter Property="Background" Value="{StaticResource AssessmentWhite}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Panel x:Name="SurroundLayer">
        <ScrollViewer x:Name="ScrollViewer"
                      Margin="{Binding $parent[views:ZoomPanControl].ContentInset}"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="Transparent">
            <Border x:Name="AssessmentMat">
                <Panel x:Name="ImagePanel">
                    <Image x:Name="ImageControl"
                           Stretch="Uniform"/>
                    <views:CropOverlayControl x:Name="CropOverlay"
                                              IsVisible="False"/>
                </Panel>
            </Border>
        </ScrollViewer>
    </Panel>
</UserControl>
