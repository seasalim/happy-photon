<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:HappyPhoton.Views"
        x:Class="HappyPhoton.Views.HelpAboutDialog"
        x:DataType="views:HelpAboutDialog"
        Title="Help &amp; About"
        Width="680"
        Height="680"
        MinWidth="520"
        MinHeight="460"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceLow}">
    <Window.Styles>
        <StyleInclude Source="avares://HappyPhoton/Views/DialogTabStyles.axaml"/>
        <Style Selector="Border.key">
            <Setter Property="Background" Value="{DynamicResource SurfaceHighest}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Border.key TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontLabel}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="Button.about-link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        </Style>
        <Style Selector="Button.about-link:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
        </Style>
        <Style Selector="Button.about-link:focus-visible">
            <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlActive}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceMid}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,0,0,1"
                Padding="20,16">
            <StackPanel Spacing="3">
                <TextBlock Text="Help &amp; About"
                           FontFamily="{StaticResource FontHeading}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="Shortcuts, build details, and project information."
                           FontSize="12"
                           Foreground="{DynamicResource TextMuted}"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="HelpAboutTabs"
                    Grid.Row="1"
                    SelectedIndex="0"
                    Background="{DynamicResource SurfaceLow}"
                    AutomationProperties.Name="Help and About sections">
            <TabItem Header="Keyboard shortcuts"
                     Classes="dialog-tab"
                     AutomationProperties.Name="Keyboard shortcuts">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Groups}" Margin="20,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="views:ShortcutGroup">
                                <StackPanel Margin="0,0,0,20" Spacing="8">
                                    <TextBlock Text="{Binding Title}" Classes="section-label"/>
                                    <ItemsControl ItemsSource="{Binding Entries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="views:ShortcutEntry">
                                                <Grid ColumnDefinitions="180,*" Margin="0,2">
                                                    <Border Grid.Column="0" Classes="key">
                                                        <TextBlock Text="{Binding Keys}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Action}"
                                                               Margin="12,3,0,0"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               TextWrapping="Wrap"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="About"
                     Classes="dialog-tab"
                     AutomationProperties.Name="About Happy Photon">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24" Spacing="18" MaxWidth="560">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Image Source="/Assets/happy-photon-icon.png"
                                   Width="64"
                                   Height="64"
                                   AutomationProperties.Name="Happy Photon icon"/>
                            <StackPanel VerticalAlignment="Center" Spacing="5">
                                <TextBlock x:Name="AboutIdentityText"
                                           FontFamily="{StaticResource FontHeading}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           AutomationProperties.Name="Product name">
                                    <Run Text="Happy " Foreground="{DynamicResource TextPrimary}"/>
                                    <Run Text="Photon" Foreground="{DynamicResource ControlActive}"/>
                                </TextBlock>
                                <TextBlock Text="A fast, non-destructive photo workflow for RAW and JPEG shoots."
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           MaxWidth="430"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Background="{DynamicResource SurfaceMid}"
                                BorderBrush="{DynamicResource Divider}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMedium}"
                                Padding="16,14">
                            <StackPanel Spacing="7">
                                <TextBlock x:Name="VersionText"
                                           Text="{Binding VersionDisplayText}"
                                           FontFamily="{StaticResource FontLabel}"
                                           Foreground="{DynamicResource TextPrimary}"
                                           AutomationProperties.Name="Application version"/>
                                <TextBlock x:Name="SourceRevisionText"
                                           Text="{Binding SourceRevisionDisplayText}"
                                           FontFamily="{StaticResource FontLabel}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           AutomationProperties.Name="Source revision"/>
                                <TextBlock x:Name="BuildDateText"
                                           Text="{Binding BuildDateDisplayText}"
                                           FontFamily="{StaticResource FontLabel}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           AutomationProperties.Name="Build date provenance"/>
                                <TextBlock Text="{Binding CopyrightText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="4">
                            <TextBlock x:Name="RawRuntimePendingText"
                                       Text="Checking native RAW support…"
                                       IsVisible="{Binding ViewModel.IsRawRuntimeHealthPending}"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="11"
                                       AutomationProperties.Name="RAW runtime check status"/>
                            <TextBlock x:Name="RawRuntimeStatusText"
                                       Text="{Binding ViewModel.RawRuntimeStatusText}"
                                       IsVisible="{Binding ViewModel.IsRawRuntimeDegraded}"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="RAW runtime status"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <Button x:Name="CheckForUpdatesButton"
                                    Content="Check for updates"
                                    Command="{Binding ViewModel.CheckForUpdatesCommand}"
                                    HorizontalAlignment="Left"
                                    Padding="14,7"
                                    AutomationProperties.Name="Check for updates"/>
                            <TextBlock x:Name="UpdateStatusText"
                                       Text="{Binding ViewModel.UpdateStatusText}"
                                       MinHeight="16"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="Update check status"/>
                            <StackPanel IsVisible="{Binding ViewModel.IsUpdateAvailable}"
                                        Spacing="5">
                                <TextBlock x:Name="UpdateChannelText"
                                           Text="{Binding ViewModel.UpdateChannelText}"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="Update channel information"/>
                                <Button x:Name="UpgradeButton"
                                        Content="{Binding ViewModel.UpgradeActionText}"
                                        Classes="about-link"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="Open update destination"
                                        Click="OnUpgradeClick"/>
                                <TextBlock x:Name="UpdateActionFeedbackText"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="7">
                            <TextBlock Text="GPL-3.0-or-later"
                                       FontFamily="{StaticResource FontBody}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Original images are never modified. Happy Photon has no account, advertising, or product telemetry."
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Name="ProjectLink"
                                    Content="Project"
                                    Classes="about-link"
                                    IsEnabled="{Binding HasProjectUrl}"
                                    AutomationProperties.Name="Open Happy Photon project"
                                    Click="OnProjectClick"/>
                            <Button x:Name="LicenseLink"
                                    Content="License"
                                    Classes="about-link"
                                    IsEnabled="{Binding HasLicenseUrl}"
                                    AutomationProperties.Name="Open GPL license"
                                    Click="OnLicenseClick"/>
                            <Button x:Name="ThirdPartyNoticesLink"
                                    Content="Third-party notices"
                                    Classes="about-link"
                                    IsEnabled="{Binding HasThirdPartyNoticesUrl}"
                                    AutomationProperties.Name="Open third-party notices"
                                    Click="OnThirdPartyNoticesClick"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <Button x:Name="CopyVersionInfoButton"
                                    Content="Copy version info"
                                    HorizontalAlignment="Left"
                                    Padding="14,7"
                                    AutomationProperties.Name="Copy version info"
                                    Click="OnCopyVersionInfoClick"/>
                            <TextBlock x:Name="CopyFeedbackText"
                                       MinHeight="16"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="Version information action status"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceMid}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Button Content="Close"
                    HorizontalAlignment="Right"
                    MinWidth="84"
                    Padding="16,6"
                    Classes="accent"
                    AutomationProperties.Name="Close Help and About"
                    Click="OnCloseClick"/>
        </Border>
    </Grid>
</Window>
