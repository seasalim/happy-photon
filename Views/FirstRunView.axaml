<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HappyPhoton.ViewModels"
             x:Class="HappyPhoton.Views.FirstRunView"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <Style Selector="Button.quiet-button">
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.storage-row">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceMid}"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer x:Name="FirstRunViewport" Margin="24"
                  Classes="overlay-scrollbar" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Border Width="760" MaxWidth="{Binding Bounds.Width, ElementName=FirstRunViewport}" Padding="32"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource SurfaceLow}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="1">
            <StackPanel Spacing="18">
                <StackPanel IsVisible="{Binding IsFirstRunWelcomeStep}"
                            Spacing="18">
                    <TextBlock Text="Welcome to Happy Photon"
                               FontFamily="{StaticResource FontHeading}"
                               FontSize="{StaticResource FontSizeDisplay}"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrandCyan}"
                               TextAlignment="Center"/>
                    <TextBlock Text="A calm, local workspace for browsing and non-destructive photo editing."
                               Classes="dialog-body" Foreground="{DynamicResource TextSecondary}"
                               LineHeight="22" TextAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Local catalog · no photo import · originals untouched"
                               FontFamily="{StaticResource FontBody}"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{DynamicResource TextMuted}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <Button x:Name="WelcomeContinueButton"
                            Classes="quiet-button accent"
                            Content="Continue"
                            HorizontalAlignment="Right"
                            Command="{Binding ContinueFirstRunCommand}"/>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsFirstRunStorageStep}"
                            Spacing="16">
                    <TextBlock Text="Confirm Happy Photon storage location"
                               Classes="dialog-title" TextAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="The catalog holds your edits, ratings, and presets. The separate cache contains thumbnails and previews."
                               Classes="dialog-body" Foreground="{DynamicResource TextSecondary}"
                               TextAlignment="Center" TextWrapping="Wrap"/>

                    <Border Classes="storage-row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Catalog + presets" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SetupCatalogRoot}"
                                           Foreground="{DynamicResource TextMuted}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Change…"
                                    Classes="quiet-button"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding CanChangeFirstRunStorage}"
                                    Command="{Binding ChangeSetupCatalogCommand}"/>
                        </Grid>
                    </Border>
                    <Border Classes="storage-row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Regenerable cache" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SetupCacheRoot}"
                                           Foreground="{DynamicResource TextMuted}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Change…"
                                    Classes="quiet-button"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding CanChangeFirstRunStorage}"
                                    Command="{Binding ChangeSetupCacheCommand}"/>
                        </Grid>
                    </Border>

                    <Border IsVisible="{Binding ShowSetupUninstallWarning}"
                            Padding="12"
                            Background="{DynamicResource ErrorContainer}">
                        <TextBlock Text="Store uninstall warning: Windows removes app data for packaged builds. Keep precious catalog data in Pictures unless you have another backup."
                                   Foreground="{DynamicResource OnErrorContainer}"
                                   TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock IsVisible="{Binding IsFirstRunStorageReadOnly}"
                               Text="These storage locations are already configured and cannot be changed here."
                               Foreground="{DynamicResource TextMuted}"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <Button Content="Back" Classes="quiet-button" HorizontalAlignment="Left"
                                Command="{Binding BackFirstRunCommand}"/>
                        <Button Grid.Column="1" x:Name="StorageContinueButton"
                                Classes="quiet-button accent"
                                Content="Continue"
                                HorizontalAlignment="Right"
                                Command="{Binding ContinueFirstRunCommand}"/>
                    </Grid>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsFirstRunPicturesStep}"
                            Spacing="18">
                    <TextBlock Text="Select your Pictures folder"
                               Classes="dialog-title" TextAlignment="Center"/>
                    <TextBlock Text="Choose the top-level location to show in the folder tree. Happy Photon browses it in place; nothing is imported or moved."
                               Classes="dialog-body" Foreground="{DynamicResource TextSecondary}"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <Border IsVisible="{Binding HasDefaultFirstRunLocation}"
                             Classes="storage-row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Detected Pictures folder" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding FirstRunDefaultPath}"
                                           Foreground="{DynamicResource TextMuted}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Change…"
                                    Classes="quiet-button"
                                    VerticalAlignment="Center"
                                    Command="{Binding BrowseElsewhereCommand}"/>
                        </Grid>
                    </Border>
                    <TextBlock IsVisible="{Binding IsPickerLedFirstRun}"
                               Text="Happy Photon could not find a Pictures folder. Browse to the location you want to use."
                               Foreground="{DynamicResource TextMuted}"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <Button Content="Back" Classes="quiet-button" HorizontalAlignment="Left"
                                Command="{Binding BackFirstRunCommand}"/>
                        <Button Grid.Column="1" x:Name="PicturesDefaultButton"
                                Classes="quiet-button accent"
                                Content="Continue"
                                IsVisible="{Binding HasDefaultFirstRunLocation}"
                                HorizontalAlignment="Right"
                                Command="{Binding StartInDefaultLocationCommand}"/>
                        <Button Grid.Column="1" x:Name="PicturesChooseButton"
                                Classes="quiet-button accent"
                                Content="Choose a folder"
                                IsVisible="{Binding IsPickerLedFirstRun}"
                                HorizontalAlignment="Right"
                                Command="{Binding BrowseElsewhereCommand}"/>
                    </Grid>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsFirstRunLightroomStep}"
                            Spacing="18">
                    <TextBlock Text="Bring your Lightroom assessments?"
                               Classes="dialog-title" TextAlignment="Center"/>
                    <TextBlock Text="We noticed you may use Lightroom Classic. Import your ratings, flags, and color labels? Happy Photon reads a safe snapshot and never changes Lightroom or your photographs."
                               Classes="dialog-body" Foreground="{DynamicResource TextSecondary}"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <ComboBox Classes="edit-dropdown" ItemsSource="{Binding DetectedLightroomCatalogPaths}"
                              SelectedItem="{Binding DetectedLightroomCatalogPath}"
                              IsVisible="{Binding HasDetectedLightroomCatalogs}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"/>
                    <Button Content="Choose another…"
                            Classes="quiet-button"
                            HorizontalAlignment="Center"
                            Command="{Binding ChooseAnotherLightroomCatalogCommand}"/>
                    <TextBlock Text="You can always import later from Folders → More folder actions → Import from Lightroom…"
                               Foreground="{DynamicResource TextMuted}"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <Button Content="Back" Classes="quiet-button" HorizontalAlignment="Left"
                                Command="{Binding BackFirstRunCommand}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Skip" Classes="quiet-button"
                                    Command="{Binding SkipDetectedLightroomCommand}"/>
                            <Button x:Name="LightroomImportButton"
                                    Classes="quiet-button accent"
                                    Content="Import"
                                    Command="{Binding ImportDetectedLightroomCommand}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsFirstRunAllSetStep}"
                            Spacing="18">
                    <TextBlock Text="You're all set"
                               Classes="dialog-title" TextAlignment="Center"/>
                    <TextBlock Text="Happy Photon is ready for your photographs."
                               Classes="dialog-body" Foreground="{DynamicResource TextSecondary}"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <Button x:Name="StartBrowsingButton" Content="Start browsing"
                            Classes="quiet-button accent" HorizontalAlignment="Center"
                            Command="{Binding FinishFirstRunCommand}"/>
                </StackPanel>

                <TextBlock Text="{Binding FirstRunErrorMessage}"
                           IsVisible="{Binding FirstRunErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{DynamicResource OnErrorContainer}"
                           TextAlignment="Center" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive"/>
                <ProgressBar Name="FirstRunProgressBar" Height="3"
                             IsIndeterminate="{Binding IsFirstRunBusy}"
                             IsVisible="{Binding IsFirstRunBusy}"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
