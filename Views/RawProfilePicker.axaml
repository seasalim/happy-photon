<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HappyPhoton.ViewModels"
             x:Class="HappyPhoton.Views.RawProfilePicker"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <Style Selector="Grid.raw-profile-row:disabled">
            <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}"/>
        </Style>
        <Style Selector="TextBlock.profile-source-line">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>
        <Style Selector="TextBlock.profile-menu-header">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="4,5,4,2"/>
        </Style>
        <Style Selector="TextBlock.profile-menu-item">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>
        <Style Selector="TextBlock.profile-menu-subtext">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>
        <Style Selector="StackPanel.global-edits.locked Grid.raw-profile-row">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </UserControl.Styles>

    <StackPanel>
        <Grid Classes="raw-profile-row"
              ColumnDefinitions="*,Auto"
              IsEnabled="{Binding RawProfilePickerState.IsVisible}"
              Margin="0,0,0,2">
            <ComboBox x:Name="RawProfileComboBox"
                      Grid.Column="0"
                      Classes="edit-dropdown"
                      ItemsSource="{Binding RawProfilePickerState.Options}"
                      SelectedItem="{Binding RawProfilePickerState.SelectedOption, Mode=OneWay}"
                      SelectionChanged="OnSelectionChanged"
                      DropDownOpened="OnDropDownOpened"
                      HorizontalAlignment="Stretch"
                      MaxDropDownHeight="360"
                      ToolTip.Tip="{Binding RawProfilePickerState.SelectedOption.ClosedRowTooltip}"
                      AutomationProperties.Name="Camera profile">
                <ComboBox.Styles>
                    <Style Selector="ComboBoxItem">
                        <Setter Property="IsEnabled"
                                Value="{ReflectionBinding CanActivate}"/>
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>
                        <Setter Property="ToolTip.Tip"
                                Value="{ReflectionBinding Status}"/>
                        <Setter Property="ToolTip.ShowOnDisabled" Value="True"/>
                    </Style>
                </ComboBox.Styles>
                <ComboBox.SelectionBoxItemTemplate>
                    <DataTemplate x:DataType="vm:RawProfileOptionViewModel">
                        <TextBlock Text="{Binding Label}"
                                   TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ComboBox.SelectionBoxItemTemplate>
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:RawProfileOptionViewModel">
                        <Grid HorizontalAlignment="Stretch">
                            <TextBlock Classes="profile-menu-header"
                                       Text="{Binding Label}"
                                       IsVisible="{Binding IsGroupHeader}"/>
                            <StackPanel Margin="4,2"
                                        IsVisible="{Binding IsProfile}">
                                <TextBlock Classes="profile-menu-item"
                                           Margin="0"
                                           Text="{Binding Label}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Classes="profile-menu-subtext"
                                           Text="{Binding DeclaredCameraModel}"
                                           IsVisible="{Binding HasDeclaredCameraModel}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Separator Margin="4,3"
                                       IsVisible="{Binding IsDivider}"/>
                            <TextBlock Classes="profile-menu-item"
                                       Text="{Binding Label}"
                                       IsVisible="{Binding IsChooseFile}"/>
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Border Grid.Column="1"
                    Classes="raw-chip"
                    Margin="6,0,0,0">
                <TextBlock Text="RAW"/>
            </Border>
        </Grid>
        <TextBlock x:Name="RawProfileStatusText"
                   Classes="profile-source-line"
                   Text="{Binding RawProfilePickerState.StatusMessage}"
                   TextWrapping="Wrap"
                   Margin="0"/>
        <Button x:Name="GetAdobeProfilesLink"
                Classes="link-button"
                Content="Get Adobe camera profiles…"
                FontSize="{StaticResource FontSizeSmall}"
                IsVisible="{Binding RawProfilePickerState.ShowGetAdobeProfilesLink}"
                Command="{Binding GetAdobeProfilesCommand}"
                ToolTip.Tip="After installing, open this picker again."
                AutomationProperties.Name="Get Adobe camera profiles"/>
    </StackPanel>
</UserControl>
