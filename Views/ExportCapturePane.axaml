<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:HappyPhoton.ViewModels" x:Class="HappyPhoton.Views.ExportCapturePane"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <StyleInclude Source="avares://HappyPhoton/Views/BrowseThumbnailStyles.axaml"/>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*" Margin="10" Background="{DynamicResource SurfaceLow}">
        <StackPanel Spacing="3" Margin="2,0,2,8">
            <TextBlock Text="{Binding ExportPhotoCount}" Classes="section-label"/>
            <Button x:Name="ChangeExportPhotosButton" Content="Change photos…" Classes="quiet-button">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="Choose in Browse…" Command="{Binding ChooseExportPhotosInBrowseCommand}"/>
                        <MenuItem Header="{Binding UsePickedPhotosLabel}" Command="{Binding UsePickedPhotosCommand}"
                                  ToolTip.Tip="{Binding UsePickedPhotosScope}" ToolTip.ShowOnDisabled="True"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <TextBlock Text="All listed photos will export. Click to preview." IsVisible="{Binding !HasNoExportCaptures}" FontSize="10" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
        </StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding ExportCaptures}"
                 SelectedItem="{Binding ActiveExportCapture, Mode=TwoWay}"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="Transparent" BorderThickness="0">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
                <Style Selector="ListBoxItem:pointerover,
                                 ListBoxItem:selected,
                                 ListBoxItem:selected:pointerover">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
                <!-- Fluent paints selection on this template part rather than
                     on ListBoxItem.Background. The thumbnail owns selection. -->
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                                 ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                                 ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter:pointerover">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="ListBoxItem:selected Border.thumbnail">
                    <Setter Property="BorderBrush" Value="{DynamicResource ActiveImageRing}"/>
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ExportCaptureViewModel">
                    <Border Margin="0,3" Padding="5"
                            Classes="thumbnail">
                        <Grid ColumnDefinitions="56,*">
                            <Panel Width="56" Height="42">
                                <Border Background="{DynamicResource SurfaceHigh}"
                                        CornerRadius="4"/>
                                <Border CornerRadius="4" ClipToBounds="True">
                                    <Image Source="{Binding Image.Thumbnail}"
                                           Width="56" Height="42"
                                           Stretch="UniformToFill"/>
                                </Border>
                            </Panel>
                            <StackPanel Grid.Column="1" Margin="8,0,3,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Image.FileName}" TextTrimming="CharacterEllipsis" FontSize="11"/>
                                <TextBlock Text="{Binding Image.VersionReportLabel}" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="1" Text="No photos selected in Browse" IsVisible="{Binding HasNoExportCaptures}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
