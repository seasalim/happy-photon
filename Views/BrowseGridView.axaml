<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="using:HappyPhoton.Converters"
             xmlns:models="using:HappyPhoton.Models"
             xmlns:views="using:HappyPhoton.Views"
             xmlns:vm="using:HappyPhoton.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="HappyPhoton.Views.BrowseGridView"
             x:Name="Root"
             x:DataType="vm:MainWindowViewModel"
             Focusable="True"
             Background="{DynamicResource ViewerSurround}">

    <UserControl.Resources>
        <converters:BurstColorConverter x:Key="BurstColorConverter"/>
        <converters:ColorLabelBrushConverter x:Key="ColorLabelBrushConverter"/>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://HappyPhoton/Views/BrowseFilterBarStyles.axaml"/>
        <StyleInclude Source="avares://HappyPhoton/Views/BrowseThumbnailStyles.axaml"/>
        <StyleInclude Source="avares://HappyPhoton/Views/DevelopActionStyles.axaml"/>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Selection Controls -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceMid}" Padding="8,4"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1"
                x:Name="SelectionBar"
                IsVisible="{Binding IsBrowseGridVisible}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock x:Name="FilterLabel"
                           Classes="tour-region"
                           Classes.tour-dimmed="{Binding IsWorkflowTourPresented}"
                           Text="Filter" FontSize="10" Foreground="{DynamicResource TextMuted}"
                           FontFamily="{StaticResource FontBody}"
                           VerticalAlignment="Center" Margin="0,0,7,0"/>

                <Grid Grid.Column="1" ClipToBounds="True">
                    <ScrollViewer x:Name="FilterScrollViewer"
                                  Classes="tour-region"
                                  Classes.tour-dimmed="{Binding IsWorkflowTourPresented}"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                        <Button x:Name="FilterRawButton" Content="RAW" Classes="filter"
                                Click="OnFilterRawClick"/>
                        <Button x:Name="FilterJpegButton" Content="JPEG" Classes="filter"
                                Click="OnFilterJpegClick"/>
                        <Rectangle Width="1" Fill="{DynamicResource Outline}" Margin="5,2"/>
                        <TextBlock Text="Pick" FontSize="10" Foreground="{DynamicResource TextMuted}" FontFamily="{StaticResource FontBody}"
                                   VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <Button x:Name="FlagFilterPickedButton" Content="Picked" Classes="filter"
                                Click="OnFlagFilterPickedClick"/>
                        <Button x:Name="FlagFilterRejectedButton" Content="Rejected" Classes="filter"
                                Click="OnFlagFilterRejectedClick"/>
                        <Rectangle Width="1" Fill="{DynamicResource Outline}" Margin="5,2"/>
                        <TextBlock Text="Rating" FontSize="10" Foreground="{DynamicResource TextMuted}" FontFamily="{StaticResource FontBody}"
                                   VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <views:BrowseRatingFilter x:Name="RatingFilter"
                            MinimumRating="{Binding MinimumRating, ElementName=Root, Mode=TwoWay}"/>
                        <views:BrowseColorLabelFilter
                            x:Name="ColorLabelFilterControl"
                            Choices="{Binding ColorLabelFilterChoices}"
                            Filter="{Binding ColorLabelFilter, ElementName=Root, Mode=TwoWay}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Border x:Name="FilterLeftFade" Width="18"
                            HorizontalAlignment="Left" IsVisible="False"
                            IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                <GradientStop Color="{DynamicResource SurfaceMidColor}" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="FilterRightFade" Width="18"
                            HorizontalAlignment="Right" IsVisible="False"
                            IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="{DynamicResource SurfaceMidColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>

                <StackPanel x:Name="BrowseActionsPanel"
                            Grid.Column="2" Orientation="Horizontal" Spacing="5"
                            Margin="10,0,0,0"
                            Classes="tour-region"
                            Classes.tour-dimmed="{Binding IsWorkflowTourPresented}">
                    <Button x:Name="BrowseActionsButton" Content="⋯" FontSize="10" Width="24" Padding="4,4"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            IsEnabled="{Binding Browse.HasVisibleImages}"
                            ToolTip.Tip="More Browse actions"
                            AutomationProperties.Name="More Browse actions">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem x:Name="SelectAllMenuItem"
                                          Header="Select All" InputGesture="Ctrl+A"
                                          IsEnabled="{Binding Browse.HasVisibleImages}"
                                          Click="OnSelectAllClick"/>
                                <MenuItem x:Name="DeselectAllMenuItem"
                                          Header="Deselect All" InputGesture="Ctrl+D"
                                          IsEnabled="{Binding Browse.HasSelectedImages}"
                                          Click="OnDeselectAllClick"/>
                                <Separator/>
                                <MenuItem Header="Delete Rejected…"
                                          IsEnabled="{Binding Browse.HasVisibleImages}"
                                          Click="OnDeleteRejectedClick"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" x:Name="FilteredEmptyState"
                    IsVisible="False" Orientation="Horizontal" Spacing="4"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="No images match the current filters"
                       Foreground="{DynamicResource TextMuted}" FontSize="12"
                       VerticalAlignment="Center"/>
            <Button x:Name="FilteredEmptyClearButton"
                    Content="Clear" Classes="filter-clear"
                    Click="OnClearFiltersClick"
                    AutomationProperties.Name="Clear all filters"/>
        </StackPanel>

        <!-- Thumbnail Grid with Virtualization -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden"
                      IsVisible="{Binding IsBrowseGridVisible}"
                      x:Name="ThumbnailScrollViewer">
            <ItemsRepeater x:Name="ThumbnailGrid" Margin="5">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="{Binding ThumbnailItemWidth, ElementName=Root}"
                                       MinItemHeight="{Binding ThumbnailItemHeight, ElementName=Root}"
                                       MinRowSpacing="5" MinColumnSpacing="5"
                                       ItemsStretch="None"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate DataType="models:ImageFile">
                        <Border x:Name="ThumbnailTile"
                                Padding="5"
                                Classes="thumbnail"
                                Classes.selected="{Binding IsSelected}"
                                Classes.active="{Binding IsActive}"
                                ToolTip.Tip="{Binding GridToolTip}"
                                PointerPressed="OnThumbnailPointerPressed"
                                PointerEntered="OnThumbnailPointerEntered"
                                PointerExited="OnThumbnailPointerExited"
                                DoubleTapped="OnThumbnailDoubleTapped">
                            <Border.ContextMenu>
                                <ContextMenu Opened="OnThumbnailContextMenuOpened">
                                    <MenuItem Header="Copy path"
                                              Click="OnCopyImagePathsClick"/>
                                    <MenuItem Header="Reveal in File Explorer"
                                              Click="OnRevealImageClick"/>
                                    <Separator/>
                                    <MenuItem x:Name="NewVersionMenuItem"
                                              Header="New Version from Current"
                                              IsEnabled="{Binding CanCreateVersion}"
                                              ToolTip.ShowOnDisabled="True"
                                              ToolTip.Tip="{Binding CreateVersionToolTip}"
                                              Click="OnNewVersionClick"/>
                                    <MenuItem Header="Rename version label…"
                                              Click="OnRenameVersionClick"/>
                                    <MenuItem x:Name="DeleteVersionMenuItem"
                                              Header="Delete version"
                                              IsEnabled="{Binding CanDeleteVersion}"
                                              ToolTip.ShowOnDisabled="True"
                                              ToolTip.Tip="{Binding DeleteVersionToolTip}"
                                              Click="OnDeleteVersionClick"/>
                                    <Separator/>
                                    <MenuItem x:Name="DeleteImageMenuItem"
                                              Header="Delete selection…"
                                              Click="OnDeleteImagesClick"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel>
                                <Panel Width="{Binding $parent[views:BrowseGridView].ImageViewportWidth}"
                                       Height="{Binding $parent[views:BrowseGridView].ImageViewportHeight}">
                                    <!-- Background: darker blue-gray for RAW, standard for others -->
                                    <Border Background="{DynamicResource RawFileBackground}" CornerRadius="8"
                                            IsVisible="{Binding IsRaw}" ToolTip.Tip="RAW file"/>
                                    <Border Background="{DynamicResource SurfaceHigh}" CornerRadius="8"
                                            IsVisible="{Binding !IsRaw}"/>
                                    <!-- Thumbnail content -->
                                    <Border x:Name="ThumbnailContentClip" CornerRadius="8">
                                        <Border.Clip>
                                            <RectangleGeometry Rect="{Binding Bounds, ElementName=ThumbnailContentClip}"
                                                               RadiusX="8" RadiusY="8"/>
                                        </Border.Clip>
                                        <Panel>
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="Uniform"
                                                   IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                            <Border Name="TileLoadingPlaceholder"
                                                    Background="{DynamicResource SurfaceHighest}"
                                                    IsVisible="{Binding IsLoading}"
                                                    Width="50" Height="4"
                                                    CornerRadius="2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                            <StackPanel IsVisible="{Binding ShowCloudPlaceholder}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Spacing="2">
                                                <TextBlock Text="☁" FontSize="24"
                                                           Foreground="{DynamicResource ControlActive}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="Online" FontSize="9"
                                                           FontFamily="{StaticResource FontBody}"
                                                           Foreground="{DynamicResource TextMuted}"/>
                                            </StackPanel>
                                        </Panel>
                                    </Border>
                                    <Border Classes="img-hairline" CornerRadius="8"
                                            IsHitTestVisible="False"/>
                                    <Border Background="{DynamicResource SurfaceHighest}"
                                            BorderBrush="{DynamicResource ControlActive}"
                                            BorderThickness="1"
                                            CornerRadius="999"
                                            Padding="5,1"
                                            Margin="0,5,5,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            IsVisible="{Binding SourceRequiresHydration}"
                                            ToolTip.Tip="Online-only original">
                                        <TextBlock Text="☁" FontSize="10"
                                                   Foreground="{DynamicResource ControlActive}"/>
                                    </Border>
                                    <Border Background="{DynamicResource ErrorContainer}" CornerRadius="999"
                                            Padding="6,2" Margin="0,5,5,0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            IsVisible="{Binding HasVisibleLoadFailure}" ToolTip.Tip="{Binding LoadFailureText}">
                                        <TextBlock Text="!" FontFamily="{StaticResource FontBody}" FontWeight="Bold"
                                                   Foreground="{DynamicResource OnErrorContainer}"/>
                                    </Border>
                                    <Border Width="4" HorizontalAlignment="Left"
                                            CornerRadius="2,0,0,2"
                                            Classes="burst-stripe"
                                            Classes.highlighted="{Binding IsBurstHighlighted}"
                                            IsVisible="{Binding HasBurstGroup}"
                                            IsHitTestVisible="False"
                                            >
                                        <Border.Background>
                                            <MultiBinding Converter="{StaticResource BurstColorConverter}">
                                                <Binding Path="BurstColorIndex"/>
                                                <Binding Path="$parent[views:BrowseGridView].ActualThemeVariant"/>
                                            </MultiBinding>
                                        </Border.Background>
                                    </Border>
                                    <Button x:Name="SelectionBadgeButton"
                                            Width="17" Height="17"
                                            Padding="0"
                                            CornerRadius="5"
                                            BorderThickness="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="8,6,0,0"
                                            Classes="check-badge"
                                            Classes.selected="{Binding IsSelected}"
                                            Background="Transparent"
                                            Focusable="False"
                                            ToolTip.Tip="Toggle selection (Ctrl+Space)"
                                            AutomationProperties.Name="Toggle image selection"
                                            PointerPressed="OnSelectionBadgePointerPressed"
                                            Click="OnSelectionBadgeClick">
                                        <Border Width="17" Height="17"
                                                CornerRadius="5"
                                                Background="{DynamicResource SelectionSurface}"
                                                BoxShadow="{StaticResource BadgeShadow}">
                                            <Path Data="M 3,7.5 L 6.5,11 L 12,4"
                                                  Stretch="Uniform" Width="9" Height="7"
                                                  Stroke="{DynamicResource SelectionCheck}"
                                                  StrokeThickness="1.8"
                                                  StrokeLineCap="Round"
                                                  StrokeJoin="Round"/>
                                        </Border>
                                    </Button>
                                </Panel>
                                <Grid Width="{Binding $parent[views:BrowseGridView].ImageViewportWidth}"
                                      Margin="0,5,0,0"
                                      ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Border Background="{DynamicResource ControlActive}"
                                                    CornerRadius="{StaticResource RadiusSmall}"
                                                    Padding="4,1"
                                                    IsVisible="{Binding HasVersions}"
                                                    ToolTip.Tip="Version">
                                                <TextBlock Text="{Binding VersionDisplayLabel}"
                                                           FontSize="9"
                                                           MaxWidth="72"
                                                           TextTrimming="CharacterEllipsis"
                                                           FontFamily="{StaticResource FontBody}"
                                                           Foreground="{DynamicResource OnControlActive}"/>
                                            </Border>
                                            <Border Background="{DynamicResource ControlActive}" CornerRadius="2"
                                                    Padding="3,0" IsVisible="{Binding IsPicked}" ToolTip.Tip="Picked">
                                                <TextBlock Text="P" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource OnControlActive}"/>
                                            </Border>
                                            <Border Background="{StaticResource RejectSurface}"
                                                    BorderBrush="{StaticResource RejectOutline}"
                                                    BorderThickness="1"
                                                    CornerRadius="2" Padding="3,0"
                                                    IsVisible="{Binding IsRejected}" ToolTip.Tip="Rejected">
                                                <TextBlock Text="X" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{StaticResource RejectGlyph}"/>
                                            </Border>
                                            <TextBlock Text="{Binding RatingStars}" FontSize="10"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       VerticalAlignment="Center" IsVisible="{Binding HasRating}"
                                                       ToolTip.Tip="Rating"/>
                                            <Border x:Name="RawJpegPairChip"
                                                    Background="{DynamicResource SurfaceHighest}"
                                                    CornerRadius="2" Padding="3,0"
                                                    IsVisible="{Binding IsRawJpegPair}"
                                                    ToolTip.Tip="RAW+JPEG pair">
                                                <TextBlock Text="J+R"
                                                           FontFamily="{StaticResource FontBody}"
                                                           FontSize="9"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                            </Border>
                                            <Border CornerRadius="2" Padding="3,0"
                                                    IsVisible="{Binding HasBurstGroup}" ToolTip.Tip="Burst frame">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource BurstColorConverter}">
                                                        <Binding Path="BurstColorIndex"/>
                                                        <Binding Path="$parent[views:BrowseGridView].ActualThemeVariant"/>
                                                    </MultiBinding>
                                                </Border.Background>
                                                <TextBlock Text="{Binding BurstChipText}" FontSize="9"
                                                           FontWeight="SemiBold"
                                                           Foreground="{x:Static views:HappyPhotonColors.BurstChipInk}"/>
                                            </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3"
                                                Margin="3,0,8,0">
                                        <Border Background="Transparent"
                                                Padding="2,1"
                                                IsVisible="{Binding HasEdits}"
                                                ToolTip.Tip="Has edits">
                                            <TextBlock Text="±" FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}"/>
                                        </Border>
                                        <Border Width="12" Height="12" CornerRadius="999"
                                                VerticalAlignment="Center"
                                                Classes="color-label-marker"
                                                IsVisible="{Binding HasColorLabel}" IsHitTestVisible="False"
                                                ToolTip.Tip="Color label"
                                                Background="{Binding ColorLabel, Converter={StaticResource ColorLabelBrushConverter}}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Empty state -->
        <Border Grid.Row="1"
                x:Name="EmptyState"
                IsVisible="False"
                Background="{DynamicResource SurfaceLow}"
                CornerRadius="{StaticResource RadiusMedium}"
                Padding="20"
                MaxWidth="520"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="8">
                <TextBlock x:Name="EmptyHeading"
                           Text="Select a folder to view photographs"
                           FontFamily="{StaticResource FontHeading}"
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="16"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="EmptyMessage"
                           Text="Choose a folder in the folder tree."
                           Foreground="{DynamicResource TextMuted}"
                           FontSize="12"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <views:CompareView x:Name="CompareView" Grid.Row="1"
                           IsVisible="{Binding IsCompareMode}"/>
        <views:LoupeView x:Name="LoupeView" Grid.Row="1"
                         IsVisible="{Binding IsLoupeMode}"/>

        <views:BrowseGridFooter x:Name="BrowseGridFooter"
                                Grid.Row="2"
                                ShowBursts="{Binding ShowBursts, ElementName=Root, Mode=TwoWay}"
                                ShowPairs="{Binding ShowPairs, ElementName=Root, Mode=TwoWay}"
                                ThumbnailSize="{Binding ThumbnailSize, ElementName=Root, Mode=TwoWay}"/>

        <views:WorkflowCoachmark
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="12"
            IsVisible="{Binding IsChooseWhatMattersTourVisible}"
            Pointer="Down"
            StepText="1 of 3"
            Heading="Curate your images"
            Body="Use the controls below to pick, reject, and curate your photographs"
            PrimaryText="Show me Develop"
            PrimaryCommand="{Binding ShowDevelopTourStepCommand}"
            SecondaryText="End tour"
            SecondaryCommand="{Binding EndWorkflowTourCommand}"/>

    </Grid>

</UserControl>
