<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="using:HappyPhoton.Converters"
             xmlns:models="using:HappyPhoton.Models"
             xmlns:views="using:HappyPhoton.Views"
             xmlns:vm="using:HappyPhoton.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="HappyPhoton.Views.BrowseGridView"
             x:Name="Root"
             x:DataType="vm:MainWindowViewModel"
             Focusable="True"
             Background="{DynamicResource ViewerSurround}">

    <UserControl.Resources>
        <converters:BurstColorConverter x:Key="BurstColorConverter"/>
        <converters:ColorLabelBrushConverter x:Key="ColorLabelBrushConverter"/>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://HappyPhoton/Views/BrowseFilterBarStyles.axaml"/>
        <StyleInclude Source="avares://HappyPhoton/Views/BrowseThumbnailStyles.axaml"/>
        <StyleInclude Source="avares://HappyPhoton/Views/DevelopActionStyles.axaml"/>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Selection Controls -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceMid}" Padding="8,4"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1"
                x:Name="SelectionBar"
                IsVisible="{Binding IsBrowseGridVisible}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock x:Name="FilterLabel"
                           Classes="tour-region"
                           Classes.tour-dimmed="{Binding IsWorkflowTourPresented}"
                           Text="Filter" FontSize="10" Foreground="{DynamicResource TextMuted}"
                           FontFamily="{StaticResource FontLabel}"
                           VerticalAlignment="Center" Margin="0,0,7,0"/>

                <Grid Grid.Column="1" ClipToBounds="True">
                    <ScrollViewer x:Name="FilterScrollViewer"
                                  Classes="tour-region"
                                  Classes.tour-dimmed="{Binding IsWorkflowTourPresented}"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                        <Button x:Name="FilterRawButton" Content="RAW" Classes="filter"
                                Click="OnFilterRawClick"/>
                        <Button x:Name="FilterJpegButton" Content="JPEG" Classes="filter"
                                Click="OnFilterJpegClick"/>
                        <Rectangle Width="1" Fill="{DynamicResource Outline}" Margin="5,2"/>
                        <TextBlock Text="Pick" FontSize="10" Foreground="{DynamicResource TextMuted}" FontFamily="{StaticResource FontLabel}"
                                   VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <Button x:Name="FlagFilterPickedButton" Content="Picked" Classes="filter"
                                Click="OnFlagFilterPickedClick"/>
                        <Button x:Name="FlagFilterRejectedButton" Content="Rejected" Classes="filter"
                                Click="OnFlagFilterRejectedClick"/>
                        <Rectangle Width="1" Fill="{DynamicResource Outline}" Margin="5,2"/>
                        <TextBlock Text="Rating" FontSize="10" Foreground="{DynamicResource TextMuted}" FontFamily="{StaticResource FontLabel}"
                                   VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <views:BrowseRatingFilter x:Name="RatingFilter"
                            MinimumRating="{Binding MinimumRating, ElementName=Root, Mode=TwoWay}"/>
                        <views:BrowseColorLabelFilter
                            x:Name="ColorLabelFilterControl"
                            Choices="{Binding ColorLabelFilterChoices}"
                            Filter="{Binding ColorLabelFilter, ElementName=Root, Mode=TwoWay}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Border x:Name="FilterLeftFade" Width="18"
                            HorizontalAlignment="Left" IsVisible="False"
                            IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                <GradientStop Color="{DynamicResource SurfaceMidColor}" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="FilterRightFade" Width="18"
                            HorizontalAlignment="Right" IsVisible="False"
                            IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="{DynamicResource SurfaceMidColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>

                <StackPanel x:Name="BrowseActionsPanel"
                            Grid.Column="2" Orientation="Horizontal" Spacing="5"
                            Margin="10,0,0,0"
                            Classes="tour-region tour-glow"
                            Classes.tour-dimmed="{Binding IsWorkflowTourPresented}"
                            Classes.tour-focus="{Binding IsDeliverCopiesTourVisible}">
                    <Button x:Name="BrowseExportButton" Content="Export…" FontSize="10" Padding="10,4"
                            Classes="accent"
                            ToolTip.Tip="Export (Ctrl+E)"
                            Click="OnBatchExportClick"/>
                    <Button x:Name="BrowseActionsButton" Content="⋯" FontSize="10" Width="24" Padding="4,4"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            IsEnabled="{Binding Browse.HasVisibleImages}"
                            ToolTip.Tip="More Browse actions"
                            AutomationProperties.Name="More Browse actions">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem x:Name="SelectAllMenuItem"
                                          Header="Select All" InputGesture="Ctrl+A"
                                          IsEnabled="{Binding Browse.HasVisibleImages}"
                                          Click="OnSelectAllClick"/>
                                <MenuItem x:Name="DeselectAllMenuItem"
                                          Header="Deselect All" InputGesture="Ctrl+D"
                                          IsEnabled="{Binding Browse.HasSelectedImages}"
                                          Click="OnDeselectAllClick"/>
                                <Separator/>
                                <MenuItem Header="Delete Rejected…"
                                          IsEnabled="{Binding Browse.HasVisibleImages}"
                                          Click="OnDeleteRejectedClick"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" x:Name="FilteredEmptyState"
                    IsVisible="False" Orientation="Horizontal" Spacing="4"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="No images match the current filters"
                       Foreground="{DynamicResource TextMuted}" FontSize="12"
                       VerticalAlignment="Center"/>
            <Button x:Name="FilteredEmptyClearButton"
                    Content="Clear" Classes="filter-clear"
                    Click="OnClearFiltersClick"
                    AutomationProperties.Name="Clear all filters"/>
        </StackPanel>

        <!-- Thumbnail Grid with Virtualization -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden"
                      IsVisible="{Binding IsBrowseGridVisible}"
                      x:Name="ThumbnailScrollViewer">
            <ItemsRepeater x:Name="ThumbnailGrid" Margin="5">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="{Binding ThumbnailItemWidth, ElementName=Root}"
                                       MinItemHeight="{Binding ThumbnailItemHeight, ElementName=Root}"
                                       MinRowSpacing="5" MinColumnSpacing="5"
                                       ItemsStretch="None"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate DataType="models:ImageFile">
                        <Border x:Name="ThumbnailTile"
                                Padding="5"
                                Classes="thumbnail"
                                Classes.selected="{Binding IsSelected}"
                                Classes.active="{Binding IsActive}"
                                PointerPressed="OnThumbnailPointerPressed"
                                PointerEntered="OnThumbnailPointerEntered"
                                PointerExited="OnThumbnailPointerExited"
                                DoubleTapped="OnThumbnailDoubleTapped">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy path"
                                              Click="OnCopyImagePathsClick"/>
                                    <MenuItem Header="Reveal in File Explorer"
                                              Click="OnRevealImageClick"/>
                                    <Separator/>
                                    <MenuItem x:Name="DeleteImageMenuItem"
                                              Header="Delete…"
                                              Click="OnDeleteImagesClick"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel>
                                <Panel Width="{Binding $parent[views:BrowseGridView].ImageViewportWidth}"
                                       Height="{Binding $parent[views:BrowseGridView].ImageViewportHeight}">
                                    <!-- Background: darker blue-gray for RAW, standard for others -->
                                    <Border Background="{DynamicResource RawFileBackground}" CornerRadius="8"
                                            IsVisible="{Binding IsRaw}" ToolTip.Tip="RAW file"/>
                                    <Border Background="{DynamicResource SurfaceHigh}" CornerRadius="8"
                                            IsVisible="{Binding !IsRaw}"/>
                                    <!-- Thumbnail content -->
                                    <Border CornerRadius="8" ClipToBounds="True">
                                        <Panel>
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="Uniform"
                                                   IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                            <Border Name="TileLoadingPlaceholder"
                                                    Background="{DynamicResource SurfaceHighest}"
                                                    IsVisible="{Binding IsLoading}"
                                                    Width="50" Height="4"
                                                    CornerRadius="2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                            <StackPanel IsVisible="{Binding ShowCloudPlaceholder}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Spacing="2">
                                                <TextBlock Text="☁" FontSize="24"
                                                           Foreground="{StaticResource PrimaryContainer}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="ONLINE" FontSize="9"
                                                           FontFamily="{StaticResource FontLabel}"
                                                           Foreground="{DynamicResource TextMuted}"/>
                                            </StackPanel>
                                        </Panel>
                                    </Border>
                                    <Border Classes="img-hairline" CornerRadius="8"
                                            IsHitTestVisible="False"/>
                                    <Border Background="{DynamicResource SurfaceHighest}"
                                            BorderBrush="{StaticResource PrimaryContainer}"
                                            BorderThickness="1"
                                            CornerRadius="999"
                                            Padding="5,1"
                                            Margin="0,5,5,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            IsVisible="{Binding SourceRequiresHydration}"
                                            ToolTip.Tip="Online-only original">
                                        <TextBlock Text="☁" FontSize="10"
                                                   Foreground="{StaticResource PrimaryContainer}"/>
                                    </Border>
                                    <Border Background="{DynamicResource ErrorContainer}" CornerRadius="999"
                                            Padding="6,2" Margin="0,5,5,0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            IsVisible="{Binding HasVisibleLoadFailure}" ToolTip.Tip="{Binding LoadFailureText}">
                                        <TextBlock Text="!" FontFamily="{StaticResource FontLabel}" FontWeight="Bold"
                                                   Foreground="{DynamicResource OnErrorContainer}"/>
                                    </Border>
                                    <Border Width="4" HorizontalAlignment="Left"
                                            CornerRadius="2,0,0,2"
                                            Classes="burst-stripe"
                                            Classes.highlighted="{Binding IsBurstHighlighted}"
                                            IsVisible="{Binding HasBurstGroup}"
                                            IsHitTestVisible="False"
                                            >
                                        <Border.Background>
                                            <MultiBinding Converter="{StaticResource BurstColorConverter}">
                                                <Binding Path="BurstColorIndex"/>
                                                <Binding Path="$parent[views:BrowseGridView].ActualThemeVariant"/>
                                            </MultiBinding>
                                        </Border.Background>
                                    </Border>
                                    <Button x:Name="SelectionBadgeButton"
                                            Width="17" Height="17"
                                            Padding="0"
                                            CornerRadius="5"
                                            BorderThickness="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="8,6,0,0"
                                            Classes="check-badge"
                                            Classes.selected="{Binding IsSelected}"
                                            Background="Transparent"
                                            Focusable="False"
                                            ToolTip.Tip="Toggle selection (Space)"
                                            AutomationProperties.Name="Toggle image selection"
                                            PointerPressed="OnSelectionBadgePointerPressed"
                                            Click="OnSelectionBadgeClick">
                                        <Border Width="17" Height="17"
                                                CornerRadius="5"
                                                Background="{DynamicResource SelectionSurface}"
                                                BoxShadow="{StaticResource BadgeShadow}">
                                            <Path Data="M 3,7.5 L 6.5,11 L 12,4"
                                                  Stretch="Uniform" Width="9" Height="7"
                                                  Stroke="{DynamicResource SelectionCheck}"
                                                  StrokeThickness="1.8"
                                                  StrokeLineCap="Round"
                                                  StrokeJoin="Round"/>
                                        </Border>
                                    </Button>
                                </Panel>
                                <Grid Width="{Binding $parent[views:BrowseGridView].ImageViewportWidth}"
                                      Margin="0,5,0,0"
                                      RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding FileName}"
                                               FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding FileName}"/>
                                    <Border Grid.Row="0" Grid.Column="1"
                                            Background="{StaticResource Tertiary}"
                                            CornerRadius="{StaticResource RadiusSmall}"
                                            Padding="4,1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="6,0,8,0"
                                            IsVisible="{Binding HasEdits}"
                                            ToolTip.Tip="Has edits">
                                        <TextBlock Text="EDIT" FontSize="9" FontWeight="SemiBold"
                                                   FontFamily="{StaticResource FontLabel}"
                                                   Foreground="{StaticResource OnTertiary}"/>
                                    </Border>
                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto"
                                          Margin="0,2,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Border Background="{StaticResource PrimaryContainer}" CornerRadius="2"
                                                    Padding="3,0" IsVisible="{Binding IsPicked}" ToolTip.Tip="Picked">
                                                <TextBlock Text="P" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{StaticResource OnPrimary}"/>
                                            </Border>
                                            <Border Background="{StaticResource ErrorContainer}" CornerRadius="2"
                                                    Padding="3,0" IsVisible="{Binding IsRejected}" ToolTip.Tip="Rejected">
                                                <TextBlock Text="X" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{StaticResource OnErrorContainer}"/>
                                            </Border>
                                            <TextBlock Text="{Binding RatingStars}" FontSize="10"
                                                       Foreground="{StaticResource SecondaryContainer}"
                                                       VerticalAlignment="Center" IsVisible="{Binding HasRating}"
                                                       ToolTip.Tip="Rating"/>
                                            <Border CornerRadius="2" Padding="3,0"
                                                    IsVisible="{Binding HasBurstGroup}" ToolTip.Tip="Burst frame">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource BurstColorConverter}">
                                                        <Binding Path="BurstColorIndex"/>
                                                        <Binding Path="$parent[views:BrowseGridView].ActualThemeVariant"/>
                                                    </MultiBinding>
                                                </Border.Background>
                                                <TextBlock Text="{Binding BurstChipText}" FontSize="9"
                                                           FontWeight="SemiBold"
                                                           Foreground="{x:Static views:HappyPhotonColors.BurstChipInk}"/>
                                            </Border>
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="12" Height="12" CornerRadius="999"
                                                Margin="3,0,8,0" VerticalAlignment="Center"
                                                Classes="color-label-marker"
                                                IsVisible="{Binding HasColorLabel}" IsHitTestVisible="False"
                                                ToolTip.Tip="Color label"
                                                Background="{Binding ColorLabel, Converter={StaticResource ColorLabelBrushConverter}}"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Empty state -->
        <Border Grid.Row="1"
                x:Name="EmptyState"
                IsVisible="False"
                Background="{DynamicResource SurfaceLow}"
                CornerRadius="{StaticResource RadiusMedium}"
                Padding="20"
                MaxWidth="520"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="8">
                <TextBlock x:Name="EmptyHeading"
                           Text="Select a folder to view photographs"
                           FontFamily="{StaticResource FontHeading}"
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="16"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="EmptyMessage"
                           Text="Choose a folder in the folder tree."
                           Foreground="{DynamicResource TextMuted}"
                           FontSize="12"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <views:CompareView x:Name="CompareView" Grid.Row="1"
                           IsVisible="{Binding IsCompareMode}"/>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceLow}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,1,0,0"
                Padding="14,8">
            <!-- Centering the assessment on the bar needs matching space reserved on
                 the left, or it centers on whatever the right-hand controls leave
                 behind. Column 0 mirrors the controls' measured width, so the middle
                 column is symmetric about the bar and the assessment sits on its true
                 centre. The controls keep an Auto column, so they can never be
                 clipped the way the old star column let them be; when space runs
                 short the assessment compresses instead. -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Panel Grid.Column="0"
                       Width="{Binding #ThumbnailSizePanel.Bounds.Width}"/>
                <StackPanel x:Name="ThumbnailSizePanel"
                            Grid.Column="2"
                            Classes="tour-region"
                            Classes.tour-dimmed="{Binding IsWorkflowTourPresented}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="4">
                        <ToggleButton x:Name="CompareViewButton"
                                      Classes="develop-action"
                                      Width="30"
                                      Padding="0"
                                      Command="{Binding ToggleCompareCommand}"
                                      IsChecked="{Binding IsCompareMode, Mode=OneWay}"
                                      IsEnabled="{Binding CanToggleCompare}"
                                      ToolTip.Tip="{Binding CompareViewToolTip}"
                                      ToolTip.ShowOnDisabled="True"
                                      AutomationProperties.Name="{Binding CompareViewToolTip}">
                            <TextBlock Text="X|Y"
                                       FontFamily="{StaticResource FontLabel}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       LetterSpacing="0.5"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </ToggleButton>
                        <Rectangle Width="1" Height="16"
                                   Fill="{DynamicResource Divider}"
                                   Margin="6,0"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="BurstsButton" Classes="view-toggle"
                                Click="OnBurstsClick"
                                IsEnabled="{Binding IsBrowseGridVisible}"
                                ToolTip.Tip="Group bursts"
                                AutomationProperties.Name="Group bursts">
                            <PathIcon Width="14" Height="14"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M3 1h11v10H3z M1 4h2v9h9v2H1z"/>
                        </Button>
                        <Rectangle Width="1" Height="16"
                                   Fill="{DynamicResource Divider}"
                                   Margin="6,0"
                                   VerticalAlignment="Center"/>
                        <RadioButton x:Name="SmallThumbnailButton"
                                     GroupName="BrowseThumbnailSize"
                                     Classes="thumbnail-size"
                                     IsEnabled="{Binding IsBrowseGridVisible}"
                                     Click="OnSmallThumbnailClick"
                                     ToolTip.Tip="Small thumbnails"
                                     AutomationProperties.Name="Small thumbnails">
                            <PathIcon Width="12"
                                      Height="12"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M1 1h3v3H1z M6.5 1h3v3h-3z M12 1h3v3h-3z M1 6.5h3v3H1z M6.5 6.5h3v3h-3z M12 6.5h3v3h-3z M1 12h3v3H1z M6.5 12h3v3h-3z M12 12h3v3h-3z"/>
                        </RadioButton>
                        <RadioButton x:Name="MediumThumbnailButton"
                                     GroupName="BrowseThumbnailSize"
                                     Classes="thumbnail-size"
                                     IsEnabled="{Binding IsBrowseGridVisible}"
                                     Click="OnMediumThumbnailClick"
                                     ToolTip.Tip="Medium thumbnails"
                                     AutomationProperties.Name="Medium thumbnails">
                            <PathIcon Width="12"
                                      Height="12"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M1 1h6v6H1z M9 1h6v6H9z M1 9h6v6H1z M9 9h6v6H9z"/>
                        </RadioButton>
                        <RadioButton x:Name="LargeThumbnailButton"
                                     GroupName="BrowseThumbnailSize"
                                     Classes="thumbnail-size"
                                     IsEnabled="{Binding IsBrowseGridVisible}"
                                     Click="OnLargeThumbnailClick"
                                     ToolTip.Tip="Large thumbnails"
                                     AutomationProperties.Name="Large thumbnails">
                            <PathIcon Width="12"
                                      Height="12"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M1 2h14v5H1z M1 9h14v5H1z"/>
                        </RadioButton>
                </StackPanel>
                <views:ImageAssessmentControl x:Name="ImageAssessment"
                                              Grid.Column="1"
                                              Classes="tour-region tour-glow"
                                              Classes.tour-dimmed="{Binding IsWorkflowTourPresented}"
                                              Classes.tour-focus="{Binding IsChooseWhatMattersTourVisible}"
                                              IsEnabled="{Binding HasSelectedImage}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                <!-- Bounded so a long cloud-only message cannot run under the
                     centered assessment controls. -->
                <TextBlock x:Name="OnlineOnlyMessage"
                           Grid.Column="0"
                           Classes="tour-region"
                           Classes.tour-dimmed="{Binding IsWorkflowTourPresented}"
                           Text="{Binding OnlineOnlyMessage}"
                           IsVisible="{Binding HasOnlineOnlyPhotos}"
                           Foreground="{DynamicResource TextSecondary}"
                           FontFamily="{StaticResource FontLabel}"
                           FontSize="10"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           MaxWidth="220"
                           Margin="0,0,8,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding OnlineOnlyMessage}"/>
            </Grid>
        </Border>

        <views:WorkflowCoachmark
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="12"
            IsVisible="{Binding IsChooseWhatMattersTourVisible}"
            Pointer="Down"
            StepText="1 of 3"
            Heading="Curate your images"
            Body="Use the controls below to pick, reject, and curate your photographs"
            PrimaryText="Show me Develop"
            PrimaryCommand="{Binding ShowDevelopTourStepCommand}"
            SecondaryText="End tour"
            SecondaryCommand="{Binding EndWorkflowTourCommand}"/>

    </Grid>

</UserControl>
