<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HappyPhoton.ViewModels"
             x:Class="HappyPhoton.Views.ExportPreviewPane"
             x:DataType="vm:MainWindowViewModel">
    <Grid>
        <Image Source="{Binding SelectedImage.Thumbnail}"
               IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNull}}"
               Stretch="Uniform"
               Margin="16"
               RenderOptions.BitmapInterpolationMode="LowQuality"/>
        <Image Source="{Binding PreviewImage}"
               Stretch="Uniform"
               Margin="16"/>
        <TextBlock Text="Select a capture to preview"
                   IsVisible="{Binding HasNoExportCaptures}"
                   Foreground="{DynamicResource TextMuted}"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Grid>
</UserControl>
