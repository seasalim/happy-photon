<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HappyPhoton.ViewModels"
             xmlns:views="using:HappyPhoton.Views"
             x:Class="HappyPhoton.Views.ExportPreviewPane"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <StyleInclude Source="avares://HappyPhoton/Views/DevelopActionStyles.axaml"/>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="6"
                    Margin="14,8,14,0">
            <ToggleButton x:Name="ExportProofToggle"
                          Classes="develop-action"
                          Content="Proof"
                          Width="56"
                          Height="20"
                          Padding="8,0"
                          Foreground="{DynamicResource TextMuted}"
                          FontFamily="{StaticResource FontBody}"
                          FontSize="8"
                          FontWeight="SemiBold"
                          LetterSpacing="1"
                          IsChecked="{Binding ExportSettings.ShowProof, Mode=TwoWay}"
                          ToolTip.Tip="Render a true export proof"
                          AutomationProperties.Name="Render a true export proof"/>
        </StackPanel>
        <views:UniformImageOverlayPanel x:Name="ExportPreviewImageFrame"
                                        Grid.Row="1"
                                        Margin="16">
            <Image x:Name="ExportPlaceholderImage"
                   Source="{Binding SelectedImage.Thumbnail}"
                   IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNull}}"
                   Stretch="Uniform"
                   RenderOptions.BitmapInterpolationMode="LowQuality"/>
            <Image x:Name="ExportPreviewImage"
                   Source="{Binding PreviewImage}"
                   Stretch="Uniform"/>
            <TextBlock x:Name="ExportProofCaption"
                       Text="{Binding ExportProofCaption}"
                       IsVisible="{Binding IsExportProofCaptionVisible}"
                       IsHitTestVisible="False"
                       FontFamily="{StaticResource FontBody}"
                       FontSize="8"
                       FontWeight="SemiBold"
                       LetterSpacing="1"
                       Foreground="{StaticResource ProofCaption}">
                <TextBlock.Effect>
                    <DropShadowEffect Color="{StaticResource ViewerStatusShadowColor}"
                                      BlurRadius="6"
                                      OffsetY="1"
                                      Opacity="0.8"/>
                </TextBlock.Effect>
            </TextBlock>
        </views:UniformImageOverlayPanel>
        <Border x:Name="ExportPreviewEmptyState"
                Grid.Row="1"
                IsVisible="{Binding HasNoExportCaptures}"
                Background="{DynamicResource SurfaceLow}"
                CornerRadius="{StaticResource RadiusMedium}"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <TextBlock Text="Select a capture to preview"
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="16"/>
        </Border>
    </Grid>
</UserControl>
