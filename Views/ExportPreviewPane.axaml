<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HappyPhoton.ViewModels"
             xmlns:views="using:HappyPhoton.Views"
             x:Class="HappyPhoton.Views.ExportPreviewPane"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <StyleInclude Source="avares://HappyPhoton/Views/DevelopActionStyles.axaml"/>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <Grid RowDefinitions="Auto,Auto" Margin="14,8,14,0">
            <WrapPanel HorizontalAlignment="Right" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                <ToggleButton x:Name="ExportProofToggle"
                              Classes="develop-action"
                              Content="Preview output"
                              Width="112"
                              Height="20"
                              Padding="8,0"
                              Foreground="{DynamicResource TextMuted}"
                              FontFamily="{StaticResource FontBody}"
                              FontSize="8"
                              FontWeight="SemiBold"
                              LetterSpacing="1"
                              IsChecked="{Binding ExportSettings.ShowProof, Mode=TwoWay}"
                              ToolTip.Tip="Preview size, color space and output sharpening; JPEG/WebP compression quality is not previewed."
                              AutomationProperties.Name="Preview size, color space and output sharpening; JPEG/WebP compression quality is not previewed."/>
                <ComboBox x:Name="ExportProofSizeChooser" Width="176" MinHeight="20" Height="20"
                          FontSize="10" Padding="6,0"
                          ItemsSource="{Binding ExportProofSizes}"
                          SelectedItem="{Binding SelectedExportProofSize, Mode=TwoWay}"
                          IsEnabled="{Binding ExportSettings.ShowProof}"
                          AutomationProperties.Name="Preview output size">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExportProofSize">
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </WrapPanel>
            <TextBlock x:Name="ExportProofHelp" Grid.Row="1" Margin="0,6,0,0"
                       Text="Previews size, color space and output sharpening — not JPEG/WebP compression quality."
                       IsVisible="{Binding ExportSettings.ShowProof}"
                       Foreground="{DynamicResource TextMuted}"
                       FontFamily="{StaticResource FontBody}"
                       FontSize="9" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </Grid>
        <views:UniformImageOverlayPanel x:Name="ExportPreviewImageFrame"
                                        Grid.Row="1"
                                        Margin="16"
                                        NativePixelSize="{Binding ExportPreviewNativePixelSize}">
            <views:PlaceholderImage x:Name="ExportPlaceholderImage"
                   Source="{Binding SelectedImage.Thumbnail}"
                   OriginalPixelWidth="{Binding SelectedImage.PixelWidth, FallbackValue=0}"
                   OriginalPixelHeight="{Binding SelectedImage.PixelHeight, FallbackValue=0}"
                   IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNull}}"
                   Stretch="Uniform"
                   RenderOptions.BitmapInterpolationMode="LowQuality"/>
            <views:DisplayImage x:Name="ExportPreviewImage"
                                CanonicalSource="{Binding PreviewImage}"
                                DisplayTransform="{Binding DisplayTransform}"
                                DisplaySourceColorSpace="{Binding PreviewDisplayColorSpace}"
                                Stretch="Uniform"/>
            <TextBlock x:Name="ExportProofCaption"
                       Text="{Binding ExportProofCaption}"
                       IsVisible="{Binding IsExportProofCaptionVisible}"
                       IsHitTestVisible="False"
                       FontFamily="{StaticResource FontBody}"
                       FontSize="8"
                       FontWeight="SemiBold"
                       LetterSpacing="1"
                       Foreground="{StaticResource ProofCaption}">
                <TextBlock.Effect>
                    <DropShadowEffect Color="{StaticResource ViewerStatusShadowColor}"
                                      BlurRadius="6"
                                      OffsetY="1"
                                      Opacity="0.8"/>
                </TextBlock.Effect>
            </TextBlock>
        </views:UniformImageOverlayPanel>
        <Border x:Name="ExportPreviewEmptyState"
                Grid.Row="1"
                IsVisible="{Binding HasNoExportCaptures}"
                Background="{DynamicResource SurfaceLow}"
                CornerRadius="{StaticResource RadiusMedium}"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="8">
                <TextBlock Text="Choose photos to export"
                           Foreground="{DynamicResource TextMuted}"
                           FontSize="16"/>
                <Button Content="Choose in Browse…" Classes="quiet-button" Command="{Binding ChooseExportPhotosInBrowseCommand}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
