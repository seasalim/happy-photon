<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:HappyPhoton.Models"
             xmlns:views="using:HappyPhoton.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="180"
             x:Class="HappyPhoton.Views.BatchExportPanel"
             x:DataType="models:ExportSettings"
             Background="{StaticResource SurfaceLow}">


    <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="20,12">
        <StackPanel>
            <!-- Header with close button -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                <TextBlock x:Name="HeaderText" Text="Export Images"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource FontHeading}"/>
                <Button Grid.Column="1" Content="✕" FontSize="12"
                        Background="Transparent" Padding="6,2"
                        Foreground="{StaticResource TextMuted}"
                        Click="OnCloseClick"/>
            </Grid>

            <!-- Row 1: Folder + Quality + Export -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                <!-- Folder group -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Folder:" Foreground="{StaticResource TextMuted}"
                               FontSize="{DynamicResource FontSizeLabel}"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="OutputFolderBox" Width="250"
                             FontSize="{DynamicResource FontSizeBody}"
                             VerticalAlignment="Center"
                             Padding="8,4"
                             Text="{Binding OutputFolder, Mode=TwoWay}"/>
                    <Button Content="Browse" Click="OnBrowseClick" Padding="12,4"
                            FontSize="{DynamicResource FontSizeBody}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="20,0,0,0">
                        <TextBlock Text="Format:" Foreground="{StaticResource TextMuted}"
                                   FontSize="{DynamicResource FontSizeLabel}"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="FormatBox" SelectedIndex="0" Width="80"
                                  FontSize="{DynamicResource FontSizeBody}"
                                  VerticalAlignment="Center"
                                  SelectionChanged="OnFormatChanged">
                            <ComboBoxItem Content="JPEG"/>
                            <ComboBoxItem Content="PNG"/>
                            <ComboBoxItem Content="WebP"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <!-- Quality slider (center) -->
                <views:CompactSlider x:Name="QualitySlider"
                                     Grid.Column="1"
                                     Label="Quality"
                                     Value="{Binding Quality, Mode=TwoWay}"
                                     Minimum="1" Maximum="100"
                                     SmallChange="1"
                                     StringFormat="{}{0:0}%"
                                     Width="180"
                                     Margin="20,0"
                                     HorizontalAlignment="Left"/>

                <!-- Export button + Progress (right) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <ProgressBar x:Name="ExportProgress" Width="150" Height="4"
                                 Minimum="0" Maximum="100" Value="0"
                                 VerticalAlignment="Center"
                                 IsVisible="False"/>
                    <TextBlock x:Name="ProgressText" Text="" Foreground="{StaticResource TextMuted}"
                               FontSize="{DynamicResource FontSizeBody}"
                               VerticalAlignment="Center"/>
                    <Button x:Name="CancelButton" Content="Cancel"
                            Click="OnCancelExportClick" IsVisible="False"
                            FontSize="{DynamicResource FontSizeBody}"
                            Padding="16,6"/>
                    <Button x:Name="ExportButton" Content="Export"
                            Click="OnExportClick"
                            FontSize="{DynamicResource FontSizeBody}"
                            Padding="16,6" Classes="accent"/>
                </StackPanel>
            </Grid>

            <!-- Row 2: Sizes + Naming + Preview -->
            <StackPanel Orientation="Horizontal" Spacing="20">
                <!-- Sizes group -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Sizes:" Foreground="{StaticResource TextMuted}"
                               FontSize="{DynamicResource FontSizeLabel}"
                               VerticalAlignment="Center"/>
                    <CheckBox Content="Hi-Res" IsChecked="{Binding ExportHiRes, Mode=TwoWay}"
                              FontSize="{DynamicResource FontSizeBody}" Click="OnSizesChanged"/>
                    <CheckBox Content="Web" IsChecked="{Binding ExportWeb, Mode=TwoWay}"
                              FontSize="{DynamicResource FontSizeBody}" Click="OnSizesChanged"/>
                    <TextBox Text="{Binding WebMaxSize, Mode=TwoWay}" Width="52"
                             FontSize="{DynamicResource FontSizeBody}"
                             Padding="6,4"
                             VerticalAlignment="Center" IsEnabled="{Binding ExportWeb}"/>
                    <TextBlock Text="px" Foreground="{StaticResource TextMuted}"
                               FontSize="{DynamicResource FontSizeBody}"
                               VerticalAlignment="Center"/>
                    <CheckBox Content="Small" IsChecked="{Binding ExportSmall, Mode=TwoWay}"
                              FontSize="{DynamicResource FontSizeBody}" Click="OnSizesChanged"/>
                    <TextBox Text="{Binding SmallMaxSize, Mode=TwoWay}" Width="52"
                             FontSize="{DynamicResource FontSizeBody}" Padding="6,4"
                             VerticalAlignment="Center" IsEnabled="{Binding ExportSmall}"/>
                    <TextBlock Text="px" Foreground="{StaticResource TextMuted}"
                               FontSize="{DynamicResource FontSizeBody}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Naming group + Preview -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Naming:" Foreground="{StaticResource TextMuted}"
                               FontSize="{DynamicResource FontSizeLabel}"
                               VerticalAlignment="Center"/>
                    <ComboBox x:Name="NamingPatternBox" Width="130"
                              FontSize="{DynamicResource FontSizeBody}"
                              SelectedIndex="0"
                              SelectionChanged="OnNamingPatternChanged">
                        <ComboBoxItem Content="{}{name}" Tag="{}{name}"/>
                        <ComboBoxItem Content="{}{name}_edited" Tag="{}{name}_edited"/>
                        <ComboBoxItem Content="{}{name}_{date}" Tag="{}{name}_{date}"/>
                        <ComboBoxItem Content="Custom..." Tag="custom"/>
                    </ComboBox>
                    <TextBox x:Name="CustomPatternBox" Width="100"
                             FontSize="{DynamicResource FontSizeBody}"
                             VerticalAlignment="Center"
                             Padding="6,4"
                             Text="{Binding NamingPattern, Mode=TwoWay}"
                             IsVisible="False"/>
                    <TextBlock Text="→" Foreground="{StaticResource TextMuted}"
                               FontSize="{DynamicResource FontSizeBody}"
                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <TextBlock x:Name="PreviewText" Text="image.jpg"
                               FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
