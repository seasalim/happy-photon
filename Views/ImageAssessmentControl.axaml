<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:HappyPhoton.Converters"
             xmlns:models="using:HappyPhoton.Models"
             xmlns:vm="using:HappyPhoton.ViewModels"
             x:Class="HappyPhoton.Views.ImageAssessmentControl"
             x:Name="Root"
             x:DataType="vm:MainWindowViewModel"
             IsEnabled="{Binding HasSelectedImage}">
    <UserControl.Resources>
        <converters:RatingAtLeastConverter x:Key="RatingAtLeastConverter"/>
        <converters:ColorLabelBrushConverter x:Key="ColorLabelBrushConverter"/>
        <converters:ColorLabelOutlineConverter x:Key="ColorLabelOutlineConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.assessment">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.assessment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="Button.flag.active">
            <Setter Property="Background" Value="{DynamicResource ControlActive}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnControlActive}"/>
        </Style>
        <Style Selector="Button.flag.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlActive}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnControlActive}"/>
        </Style>
        <Style Selector="Button.reject.active">
            <Setter Property="Background" Value="{StaticResource RejectSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource RejectGlyph}"/>
            <Setter Property="BorderBrush" Value="{StaticResource RejectOutline}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.reject.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RejectSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource RejectGlyph}"/>
            <Setter Property="BorderBrush" Value="{StaticResource RejectOutline}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.flag Path">
            <Setter Property="Stroke" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style Selector="Button.flag:pointerover Path">
            <Setter Property="Stroke" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="Button.flag.active Path">
            <Setter Property="Stroke" Value="{DynamicResource OnControlActive}"/>
        </Style>
        <Style Selector="Button.reject.active Path">
            <Setter Property="Stroke" Value="{StaticResource RejectGlyph}"/>
        </Style>
        <Style Selector="Button.star">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style Selector="Button.clear Path">
            <Setter Property="Stroke" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style Selector="Button.clear:pointerover Path">
            <Setter Property="Stroke" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="TextBlock.shortcut">
            <Setter Property="FontFamily" Value="{StaticResource FontLabel}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Border Background="{DynamicResource SurfaceLowest}"
                    CornerRadius="{StaticResource RadiusSmall}"
                    Padding="1">
                <StackPanel Orientation="Horizontal" Spacing="1">
                    <Button x:Name="PickImageButton"
                            Classes="assessment flag"
                            Classes.active="{Binding SelectedImage.IsPicked, FallbackValue=False}"
                            Command="{Binding TogglePickedImageCommand}"
                            ToolTip.Tip="Pick the Browse selection when non-empty, otherwise the active photo; active photo only in Develop, Loupe, or Compare (P)"
                            AutomationProperties.Name="Pick images">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Path Width="14" Height="14"
                                  Data="M 2,13 L 2,2 M 2,3 L 11,3 L 9,6 L 11,9 L 2,9"
                                  StrokeThickness="1.4"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"/>
                            <TextBlock Text="P" Classes="shortcut" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RejectImageButton"
                            Classes="assessment flag reject"
                            Classes.active="{Binding SelectedImage.IsRejected, FallbackValue=False}"
                            Command="{Binding ToggleRejectedImageCommand}"
                            ToolTip.Tip="Reject the Browse selection when non-empty, otherwise the active photo; active photo only in Develop, Loupe, or Compare (X)"
                            AutomationProperties.Name="Reject images">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Path Width="14" Height="14"
                                  Data="M 7,1 A 6,6 0 1 1 6.99,1 M 3,3 L 11,11"
                                  StrokeThickness="1.4"
                                  StrokeLineCap="Round"/>
                            <TextBlock Text="X" Classes="shortcut" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="UnflagImageButton"
                            Classes="assessment flag"
                            Command="{Binding UnpickImageCommand}"
                            ToolTip.Tip="Unflag the Browse selection when non-empty, otherwise the active photo; active photo only in Develop, Loupe, or Compare (U)"
                            AutomationProperties.Name="Unflag images">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Path Width="14" Height="14"
                                  Data="M 2,13 L 2,2 M 2,3 L 11,3 L 9,6 L 11,9 L 2,9 M 13.2,2.6 L 2.6,13.2"
                                  StrokeThickness="1.4"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"/>
                            <TextBlock Text="U" Classes="shortcut" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Rectangle Width="1" Height="18" Fill="{DynamicResource Divider}"/>

            <StackPanel Orientation="Horizontal" Spacing="0">
                <Button x:Name="Rating1Button"
                        Classes="assessment star"
                        Command="{Binding SetRatingCommand}"
                        ToolTip.Tip="Set or clear 1 star for the Browse selection when non-empty, otherwise the active photo; active photo only in Develop, Loupe, or Compare (1)"
                        AutomationProperties.Name="Set 1-star rating">
                    <Button.CommandParameter>
                        <x:Int32>1</x:Int32>
                    </Button.CommandParameter>
                    <Grid>
                        <TextBlock Text="☆" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="★" Foreground="{DynamicResource TextPrimary}"
                                   IsVisible="{Binding SelectedImage.Rating, Converter={StaticResource RatingAtLeastConverter}, ConverterParameter=1, FallbackValue=False}"/>
                    </Grid>
                </Button>
                <Button x:Name="Rating2Button"
                        Classes="assessment star"
                        Command="{Binding SetRatingCommand}"
                        ToolTip.Tip="Set or clear 2 stars for the Browse selection when non-empty, otherwise the active photo; active photo only in Develop, Loupe, or Compare (2)"
                        AutomationProperties.Name="Set 2-star rating">
                    <Button.CommandParameter>
                        <x:Int32>2</x:Int32>
                    </Button.CommandParameter>
                    <Grid>
                        <TextBlock Text="☆" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="★" Foreground="{DynamicResource TextPrimary}"
                                   IsVisible="{Binding SelectedImage.Rating, Converter={StaticResource RatingAtLeastConverter}, ConverterParameter=2, FallbackValue=False}"/>
                    </Grid>
                </Button>
                <Button x:Name="Rating3Button"
                        Classes="assessment star"
                        Command="{Binding SetRatingCommand}"
                        ToolTip.Tip="Set or clear 3 stars for the Browse selection when non-empty, otherwise the active photo; active photo only in Develop, Loupe, or Compare (3)"
                        AutomationProperties.Name="Set 3-star rating">
                    <Button.CommandParameter>
                        <x:Int32>3</x:Int32>
                    </Button.CommandParameter>
                    <Grid>
                        <TextBlock Text="☆" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="★" Foreground="{DynamicResource TextPrimary}"
                                   IsVisible="{Binding SelectedImage.Rating, Converter={StaticResource RatingAtLeastConverter}, ConverterParameter=3, FallbackValue=False}"/>
                    </Grid>
                </Button>
                <Button x:Name="Rating4Button"
                        Classes="assessment star"
                        Command="{Binding SetRatingCommand}"
                        ToolTip.Tip="Set or clear 4 stars for the Browse selection when non-empty, otherwise the active photo; active photo only in Develop, Loupe, or Compare (4)"
                        AutomationProperties.Name="Set 4-star rating">
                    <Button.CommandParameter>
                        <x:Int32>4</x:Int32>
                    </Button.CommandParameter>
                    <Grid>
                        <TextBlock Text="☆" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="★" Foreground="{DynamicResource TextPrimary}"
                                   IsVisible="{Binding SelectedImage.Rating, Converter={StaticResource RatingAtLeastConverter}, ConverterParameter=4, FallbackValue=False}"/>
                    </Grid>
                </Button>
                <Button x:Name="Rating5Button"
                        Classes="assessment star"
                        Command="{Binding SetRatingCommand}"
                        ToolTip.Tip="Set or clear 5 stars for the Browse selection when non-empty, otherwise the active photo; active photo only in Develop, Loupe, or Compare (5)"
                        AutomationProperties.Name="Set 5-star rating">
                    <Button.CommandParameter>
                        <x:Int32>5</x:Int32>
                    </Button.CommandParameter>
                    <Grid>
                        <TextBlock Text="☆" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="★" Foreground="{DynamicResource TextPrimary}"
                                   IsVisible="{Binding SelectedImage.Rating, Converter={StaticResource RatingAtLeastConverter}, ConverterParameter=5, FallbackValue=False}"/>
                    </Grid>
                </Button>
            </StackPanel>

            <Button x:Name="ClearRatingButton"
                    Classes="assessment clear"
                    Command="{Binding SetRatingCommand}"
                    ToolTip.Tip="Clear ratings on the Browse selection when non-empty, otherwise the active photo; active photo only in Develop, Loupe, or Compare (0)"
                    AutomationProperties.Name="Clear rating">
                <Button.CommandParameter>
                    <x:Int32>0</x:Int32>
                </Button.CommandParameter>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Path Width="14" Height="14"
                          Data="M 7,1 A 6,6 0 1 1 6.99,1 M 4,7 L 10,7"
                          StrokeThickness="1.4"
                          StrokeLineCap="Round"/>
                    <TextBlock Text="0" Classes="shortcut" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Rectangle Width="1" Height="18" Fill="{DynamicResource Divider}"/>

            <ItemsControl ItemsSource="{Binding ColorLabelChoices}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ColorLabelChoice">
                        <Button x:Name="ColorLabelButton"
                                Width="20" Height="20" Padding="2"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding DataContext.SetColorLabelCommand, ElementName=Root}"
                                CommandParameter="{Binding Value}"
                                ToolTip.Tip="{Binding ToolTip}"
                                AutomationProperties.Name="{Binding AutomationName}">
                            <Border Width="13" Height="13" CornerRadius="999"
                                    Background="{Binding Value, Converter={StaticResource ColorLabelBrushConverter}}"
                                    BorderThickness="2">
                                <Border.BorderBrush>
                                    <MultiBinding Converter="{StaticResource ColorLabelOutlineConverter}">
                                        <Binding Path="DataContext.SelectedImage.ColorLabel" ElementName="Root"/>
                                        <Binding Path="Value"/>
                                    </MultiBinding>
                                </Border.BorderBrush>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
    </StackPanel>
</UserControl>
