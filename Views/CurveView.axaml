<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="220" d:DesignHeight="180"
             x:Class="HappyPhoton.Views.CurveView">

    <UserControl.Styles>
        <Style Selector="ListBoxItem.red.touched">
            <Setter Property="Foreground" Value="{DynamicResource ColorLabelRed}"/>
        </Style>
        <Style Selector="ListBoxItem.green.touched">
            <Setter Property="Foreground" Value="{DynamicResource ColorLabelGreen}"/>
        </Style>
        <Style Selector="ListBoxItem.blue.touched">
            <Setter Property="Foreground" Value="{DynamicResource ColorLabelBlue}"/>
        </Style>
        <Style Selector="StackPanel.global-edits.locked ListBoxItem">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource SurfaceLow}" Padding="10">
        <Grid RowDefinitions="Auto,*,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,8">
                <ListBox x:Name="ChannelPicker" Grid.Column="2" Width="112" Margin="4,0"
                         Classes="segmented" AutoScrollToSelectedItem="False" SelectionMode="Single,AlwaysSelected" KeyboardNavigation.TabNavigation="Continue"
                         SelectionChanged="OnChannelSelectionChanged" AutomationProperties.Name="Curve channel">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" ColumnSpacing="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBoxItem x:Name="CompositeChannelButton" Content="RGB"/>
                    <ListBoxItem x:Name="RedChannelButton" Classes="red" Content="R"/>
                    <ListBoxItem x:Name="GreenChannelButton" Classes="green" Content="G"/>
                    <ListBoxItem x:Name="BlueChannelButton" Classes="blue" Content="B"/>
                </ListBox>
                <Button Grid.Column="3" Classes="icon-button compact curveReset" Click="OnResetClick"
                        ToolTip.Tip="Reset the active channel's curve"
                        AutomationProperties.Name="Reset curve">
                    <Viewbox Width="12" Height="12">
                        <Canvas Width="16" Height="16">
                            <Path Fill="Transparent"
                                  StrokeThickness="1.5"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="M 2.5,8 A 5.5,5.5 0 1 0 8,2.5 M 8,2.5 L 5.2,1.2 M 8,2.5 L 6.7,5.3"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource SurfaceBase}"
                    BorderBrush="{DynamicResource Outline}" BorderThickness="1">
                <Canvas x:Name="CurveCanvas" ClipToBounds="True" Background="Transparent"/>
            </Border>

            <TextBlock Grid.Row="2" Classes="hint-text" LineHeight="12" Text="Click: add · Drag: move · Right-click: delete"
                       Margin="0,5,0,0" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
