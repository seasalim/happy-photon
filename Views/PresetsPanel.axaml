<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="220" d:DesignHeight="500"
             x:Class="HappyPhoton.Views.PresetsPanel">

    <!-- Override FluentTheme Expander resources -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="ExpanderHeaderBorderPointerOverBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="ExpanderHeaderBorderPressedBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="{StaticResource SurfaceMidColor}"/>
        <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="{StaticResource SurfaceHighestColor}"/>
        <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="{StaticResource SurfaceHighestColor}"/>
        <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
        <Thickness x:Key="ExpanderContentDownBorderThickness">0</Thickness>
        <Thickness x:Key="ExpanderContentPadding">0</Thickness>
        <Thickness x:Key="ExpanderHeaderPadding">8,4</Thickness>
        <x:Double x:Key="ExpanderMinHeight">0</x:Double>
        <x:Double x:Key="ExpanderHeaderMinHeight">0</x:Double>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.preset">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="Button.preset:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceHigh}"/>
        </Style>
        <Style Selector="Button.preset.active">
            <Setter Property="Background" Value="{StaticResource SurfaceHigh}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryContainer}"/>
        </Style>
        <Style Selector="Button.preset.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceHigh}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryContainer}"/>
        </Style>
        <Style Selector="Button.preset.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceHighest}"/>
        </Style>

        <!-- Expander styling -->
        <Style Selector="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#PART_toggle">
            <Setter Property="Background" Value="{StaticResource SurfaceMid}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#PART_toggle /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#PART_toggle:pointerover">
            <Setter Property="Background" Value="{StaticResource SurfaceHighest}"/>
        </Style>
        <!-- Style toggle button internal border -->
        <Style Selector="Expander /template/ ToggleButton#PART_toggle /template/ Border#ToggleButtonBackground">
            <Setter Property="Background" Value="{StaticResource SurfaceMid}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#PART_toggle:pointerover /template/ Border#ToggleButtonBackground">
            <Setter Property="Background" Value="{StaticResource SurfaceHighest}"/>
        </Style>
        <!-- Remove borders and padding from expander content area -->
        <Style Selector="Expander /template/ Border#ExpanderContent">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Expander /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <!-- Style chevron icon -->
        <Style Selector="Expander /template/ Path">
            <Setter Property="Stroke" Value="{StaticResource TextMuted}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceLow}" Padding="10">
            <TextBlock Classes="section-label" Text="PRESETS"/>
        </Border>

        <!-- Presets List -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PresetsContainer" Spacing="0">
                <!-- Categories will be added programmatically -->
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
