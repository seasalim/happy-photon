<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HappyPhoton.ViewModels"
             xmlns:views="using:HappyPhoton.Views"
             x:Class="HappyPhoton.Views.CropEditSection"
             x:DataType="vm:MainWindowViewModel" IsVisible="{Binding IsCropMode}">
    <StackPanel Spacing="8" Margin="0,0,0,12" IsEnabled="{Binding CanEditSelectedImage}">
        <views:CompactSlider Label="Horizon" Value="{Binding HorizonRotation}"
                             Minimum="-5" Maximum="5" SmallChange="0.1"
                             StringFormat="{}{0:+0.0;-0.0;0.0}°" EnableDoubleClickReset="True"/>
        <Grid ColumnDefinitions="*,Auto">
            <ToggleButton IsChecked="{Binding IsCropAspectLocked}" Content="Lock aspect ratio"
                          ToolTip.Tip="Lock Aspect Ratio" FontSize="10" Padding="8,4" BorderThickness="0"/>
            <Button Grid.Column="1" Command="{Binding ResetCropCommand}" Content="Reset crop"
                    ToolTip.Tip="Reset Crop" FontSize="10" Padding="8,4" BorderThickness="0"/>
        </Grid>
        <TextBlock Text="Drag edges to crop · Enter to apply" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0"/>
    </StackPanel>
</UserControl>
