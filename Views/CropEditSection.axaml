<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HappyPhoton.ViewModels"
             xmlns:views="using:HappyPhoton.Views"
             x:Class="HappyPhoton.Views.CropEditSection"
             x:DataType="vm:MainWindowViewModel" IsVisible="{Binding IsCropMode}">
    <UserControl.Styles>
        <Style Selector="ToggleButton#CropAspectLockButton">
            <Setter Property="AutomationProperties.Name" Value="Lock aspect ratio, unlocked"/>
        </Style>
        <Style Selector="ToggleButton#CropAspectLockButton:checked">
            <Setter Property="AutomationProperties.Name" Value="Lock aspect ratio, locked"/>
        </Style>
        <Style Selector="ToggleButton#CropAspectLockButton Path">
            <Setter Property="Data" Value="M3,7 L13,7 L13,14 L3,14 Z M6,7 L6,4 A3,3 0 0 1 12,4"/>
        </Style>
        <Style Selector="ToggleButton#CropAspectLockButton:checked Path">
            <Setter Property="Data" Value="M3,7 L13,7 L13,14 L3,14 Z M5,7 L5,4 A3,3 0 0 1 11,4 L11,7"/>
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="8" Margin="0,0,0,12" IsEnabled="{Binding CanEditSelectedImage}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="70"/>
                <ColumnDefinition Width="*" MinWidth="106"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Ratio" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"
                       FontFamily="{StaticResource FontBody}" FontSize="{StaticResource FontSizeBody}"/>
            <ComboBox x:Name="CropRatioPicker" Grid.Column="1" Classes="edit-dropdown" MinWidth="0" Margin="8,0"
                      HorizontalAlignment="Stretch" IsEnabled="{Binding CanChooseCropRatio}"
                      ItemsSource="{Binding CropRatios}" SelectedItem="{Binding CropRatio, Mode=OneWay}"
                      SelectionChanged="OnRatioSelectionChanged" AutomationProperties.Name="Crop ratio"
                      ToolTip.Tip="Aspect ratio (X swaps orientation)"/>
            <ToggleButton x:Name="CropAspectLockButton" Grid.Column="2" Classes="icon-button" HorizontalAlignment="Right" IsChecked="{Binding IsCropAspectLocked}" MinWidth="0"
                          ToolTip.Tip="Lock aspect ratio">
                <Viewbox Width="14" Height="14"><Canvas Width="16" Height="16">
                    <Path Fill="Transparent" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"/>
                </Canvas></Viewbox>
            </ToggleButton>
        </Grid>
        <views:CompactSlider Label="Horizon" Value="{Binding HorizonRotation}"
                             Minimum="-5" Maximum="5" SmallChange="0.1"
                             StringFormat="{}{0:+0.0;-0.0;0.0}°" EnableDoubleClickReset="True"/>
        <Grid ColumnDefinitions="*,Auto,Auto">
            <Button x:Name="AutoStraightenButton" Grid.Column="1" Classes="compact-button" MinWidth="50"
                    Command="{Binding AutoStraightenCommand}" Content="Auto" Click="OnAutoClick"
                    ToolTip.Tip="Straighten from the photo's lines (sets Horizon)"/>
            <Button Classes="compact-button" Grid.Column="2" Command="{Binding ResetCropCommand}" Content="Reset crop"
                    ToolTip.Tip="Reset Crop"/>
        </Grid>
        <TextBlock Classes="hint-text" Text="Drag edges to crop · Enter to apply"/>
        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0"/>
    </StackPanel>
</UserControl>
