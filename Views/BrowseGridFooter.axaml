<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:HappyPhoton.Views"
             xmlns:vm="using:HappyPhoton.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="50"
             x:Class="HappyPhoton.Views.BrowseGridFooter"
             x:DataType="vm:MainWindowViewModel">

<Border x:Name="BrowseFooterSurface"
        Background="{DynamicResource SurfaceLow}"
        BorderBrush="{DynamicResource Divider}"
        BorderThickness="0,1,0,0"
        Padding="10,2">
    <views:ControlBarLayout>
        <Grid x:Name="BrowseImageActionsPanel" ColumnDefinitions="Auto,*" MinWidth="56">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="icon-button" x:Name="PreviousImageButton"
                        Click="OnNavigationClick"
                        Command="{Binding SelectPreviousImageCommand}"
                        ToolTip.Tip="Previous image (←)"
                        AutomationProperties.Name="Previous image">
                    <Viewbox Width="14" Height="14"><Canvas Width="16" Height="16">
                        <Path Data="M 10,3.5 L 5.5,8 L 10,12.5" Fill="Transparent"
                              StrokeThickness="1.5"
                              StrokeLineCap="Round" StrokeJoin="Round"/>
                    </Canvas></Viewbox>
                </Button>
                <Button Classes="icon-button" x:Name="NextImageButton"
                        Click="OnNavigationClick"
                        Command="{Binding SelectNextImageCommand}"
                        ToolTip.Tip="Next image (→)"
                        AutomationProperties.Name="Next image">
                    <Viewbox Width="14" Height="14"><Canvas Width="16" Height="16">
                        <Path Data="M 6,3.5 L 10.5,8 L 6,12.5" Fill="Transparent"
                              StrokeThickness="1.5"
                              StrokeLineCap="Round" StrokeJoin="Round"/>
                    </Canvas></Viewbox>
                </Button>
            </StackPanel>
            <TextBlock x:Name="OnlineOnlyMessage"
                       Grid.Column="1"
                       Text="{Binding OnlineOnlyMessage}"
                       IsVisible="{Binding HasOnlineOnlyPhotos}"
                       Foreground="{DynamicResource TextSecondary}"
                       FontFamily="{StaticResource FontBody}"
                       FontSize="{StaticResource FontSizeSmall}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       MaxWidth="180"
                       Margin="12,0,8,0"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding OnlineOnlyMessage}"/>
        </Grid>
        <Grid ClipToBounds="True">
            <Border Width="{x:Static views:ControlBarLayout.FullClusterWidth}" VerticalAlignment="Center">
                <views:ImageAssessmentControl x:Name="ImageAssessment"/>
            </Border>
            <views:DevelopAssessmentCluster IsVisible="False" VerticalAlignment="Center"/>
        </Grid>
        <StackPanel x:Name="ThumbnailSizePanel"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                <ToggleButton x:Name="LoupeViewButton"
                              Classes="icon-button"
                              Command="{Binding ToggleLoupeCommand}"
                              IsChecked="{Binding IsLoupeMode, Mode=OneWay}"
                              ToolTip.Tip="Loupe (E)"
                              AutomationProperties.Name="Open Browse Loupe">
                    <Viewbox><Canvas Width="16" Height="16">
                        <Path Data="M1 2h12v10H1z M3 4v6h8V4z" Fill="Transparent" StrokeThickness="1.4" StrokeJoin="Round"/>
                    </Canvas></Viewbox>
                </ToggleButton>
                <ToggleButton x:Name="CompareViewButton"
                              Classes="icon-button"
                              Command="{Binding ToggleCompareCommand}"
                              IsChecked="{Binding IsCompareMode, Mode=OneWay}"
                              IsEnabled="{Binding CanToggleCompare}"
                              ToolTip.Tip="{Binding CompareViewToolTip}"
                              ToolTip.ShowOnDisabled="True"
                              AutomationProperties.Name="{Binding CompareViewToolTip}">
                    <Viewbox><Canvas Width="16" Height="16">
                        <Path Data="M1,4 L5,12 M5,4 L1,12 M8,2 V14 M11,4 L13,8 L15,4 M13,8 V12" Fill="Transparent" StrokeThickness="1.4" StrokeJoin="Round"/>
                    </Canvas></Viewbox>
                </ToggleButton>
                <Rectangle Width="1" Height="16"
                           Fill="{DynamicResource Divider}"
                           Margin="6,0"
                           VerticalAlignment="Center"/>
                <ToggleButton x:Name="BurstsButton" Classes="icon-button"
                        Click="OnBurstsClick"
                        IsEnabled="{Binding IsBrowseGridVisible}"
                        ToolTip.Tip="Group bursts"
                        AutomationProperties.Name="Group bursts">
                    <Viewbox><Canvas Width="16" Height="16">
                        <Path Data="M3 1h11v10H3z M1 4h2v9h9v2H1z" Fill="Transparent" StrokeThickness="1.4" StrokeJoin="Round"/>
                    </Canvas></Viewbox>
                </ToggleButton>
                <ToggleButton x:Name="PairsButton" Classes="icon-button"
                        Click="OnPairsClick"
                        IsEnabled="{Binding IsBrowseGridVisible}"
                        ToolTip.Tip="Pair RAW+JPEG"
                        AutomationProperties.Name="Pair RAW+JPEG">
                    <Viewbox><Canvas Width="16" Height="16">
                        <Path Data="M1,10 Q1,12 3,12 Q5,12 5,10 V4 M8,2 V14 M11,12 V4 H13 Q15,4 15,6 Q15,8 13,8 H11 M13,8 L15,12" Fill="Transparent" StrokeThickness="1.4" StrokeJoin="Round"/>
                    </Canvas></Viewbox>
                </ToggleButton>
                <Rectangle Width="1" Height="16"
                           Fill="{DynamicResource Divider}"
                           Margin="6,0"
                           VerticalAlignment="Center"/>
                <RadioButton x:Name="SmallThumbnailButton"
                             GroupName="BrowseThumbnailSize"
                             Classes="icon-button"
                             Theme="{StaticResource {x:Type ToggleButton}}"
                             IsEnabled="{Binding IsBrowseGridVisible}"
                             Click="OnSmallThumbnailClick"
                             ToolTip.Tip="Small thumbnails"
                             AutomationProperties.Name="Small thumbnails">
                    <Viewbox><Canvas Width="16" Height="16">
                        <Path Data="M1.5 1.5h3v3h-3z M6.5 1.5h3v3h-3z M11.5 1.5h3v3h-3z M1.5 6.5h3v3h-3z M6.5 6.5h3v3h-3z M11.5 6.5h3v3h-3z M1.5 11.5h3v3h-3z M6.5 11.5h3v3h-3z M11.5 11.5h3v3h-3z" Fill="Transparent" StrokeThickness="1.4" StrokeJoin="Round"/>
                    </Canvas></Viewbox>
                </RadioButton>
                <RadioButton x:Name="MediumThumbnailButton"
                             GroupName="BrowseThumbnailSize"
                             Classes="icon-button"
                             Theme="{StaticResource {x:Type ToggleButton}}"
                             IsEnabled="{Binding IsBrowseGridVisible}"
                             Click="OnMediumThumbnailClick"
                             ToolTip.Tip="Medium thumbnails"
                             AutomationProperties.Name="Medium thumbnails">
                    <Viewbox><Canvas Width="16" Height="16">
                        <Path Data="M1.5 1.5h5v5h-5z M9.5 1.5h5v5h-5z M1.5 9.5h5v5h-5z M9.5 9.5h5v5h-5z" Fill="Transparent" StrokeThickness="1.4" StrokeJoin="Round"/>
                    </Canvas></Viewbox>
                </RadioButton>
                <RadioButton x:Name="LargeThumbnailButton"
                             GroupName="BrowseThumbnailSize"
                             Classes="icon-button"
                             Theme="{StaticResource {x:Type ToggleButton}}"
                             IsEnabled="{Binding IsBrowseGridVisible}"
                             Click="OnLargeThumbnailClick"
                             ToolTip.Tip="Large thumbnails"
                             AutomationProperties.Name="Large thumbnails">
                    <Viewbox><Canvas Width="16" Height="16">
                        <Path Data="M1.5 1.5h13v13h-13z" Fill="Transparent" StrokeThickness="1.4" StrokeJoin="Round"/>
                    </Canvas></Viewbox>
                </RadioButton>
        </StackPanel>
    </views:ControlBarLayout>
</Border>

</UserControl>
