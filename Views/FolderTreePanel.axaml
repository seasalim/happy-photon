<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="using:Avalonia.Controls.Converters"
             xmlns:models="using:HappyPhoton.Models"
             mc:Ignorable="d" d:DesignWidth="220" d:DesignHeight="500"
             x:Name="Root"
             x:Class="HappyPhoton.Views.FolderTreePanel">

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceLow}" Padding="10">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto">
                <TextBlock Classes="section-label" Text="Folders"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="RefreshFolderButton"
                        Classes="icon-button compact"
                        Margin="0,0,4,0"
                        Click="OnRefreshFolderClick"
                        IsEnabled="{Binding CanRefreshFolder, ElementName=Root}"
                        ToolTip.Tip="Refresh folder — re-read photographs in the current folder."
                        AutomationProperties.Name="Refresh current folder">
                    <Viewbox><Canvas Width="16" Height="16">
                        <Path Data="M13,5 A6,6 0 1 0 14,9 M9,5 H14 V0" Fill="Transparent" StrokeThickness="1.4" StrokeJoin="Round"/>
                    </Canvas></Viewbox>
                </Button>
                <Button Grid.Column="2" x:Name="FolderActionsButton"
                        Classes="icon-button compact"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        ToolTip.Tip="More folder actions"
                        AutomationProperties.Name="More folder actions">
                    <Button.Content>
                        <Viewbox><Canvas Width="16" Height="16">
                        <Path Data="M2,8 H3 M7.5,8 H8.5 M13,8 H14" Fill="Transparent" StrokeThickness="1.4" StrokeJoin="Round"/>
                    </Canvas></Viewbox>
                    </Button.Content>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="Import from Lightroom…"
                                      Click="OnImportCatalogClick"
                                      ToolTip.Tip="Import ratings, flags, and color labels from Lightroom Classic."
                                      AutomationProperties.Name="Import from Lightroom catalog"/>
                            <MenuItem Header="Change browsing location…"
                                      Click="OnChangeFolderClick"
                                      ToolTip.Tip="Choose the top-level location shown in the folder tree."
                                      AutomationProperties.Name="Change browsing location"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="3"
                           IsVisible="{Binding BrowsingFolderName, ElementName=Root, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Text="{Binding BrowsingFolderName, ElementName=Root, StringFormat='Browsing from: {0}'}"
                           Foreground="{DynamicResource TextMuted}" FontSize="{StaticResource FontSizeSmall}" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="2" Grid.ColumnSpan="3"
                           IsVisible="{Binding ViewingFolderName, ElementName=Root, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Text="{Binding ViewingFolderName, ElementName=Root, StringFormat='Viewing: {0}'}"
                           Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeSmall}" Margin="0,8,0,0"/>
            </Grid>
        </Border>

        <!-- Folder Tree -->
        <TreeView x:Name="FolderTree"
                  Focusable="True"
                  Classes="overlay-scrollbar"
                  Grid.Row="1"
                  Background="Transparent"
                  AutoScrollToSelectedItem="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  SelectionMode="Single">
            <TreeView.Resources>
                <x:Double x:Key="CompactTreeViewItemIndent">12</x:Double>
            </TreeView.Resources>
            <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="models:FolderNode" ItemsSource="{Binding Children}">
                    <Border Classes="folder-row"
                            Classes.active="{Binding IsSelected}"
                            Padding="7,3">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Reveal in File Explorer"
                                          CommandParameter="{Binding}"
                                          IsEnabled="{Binding !IsDummy}"
                                          Click="OnRevealFolderClick"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!-- Folder Icon -->
                            <PathIcon Width="16" Height="16">
                                <PathIcon.Data>
                                    <PathGeometry>M2 4a2 2 0 0 1 2-2h3.172a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 10.828 4H14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4z</PathGeometry>
                                </PathIcon.Data>
                            </PathIcon>
                            <!-- Folder Name -->
                            <TextBlock Text="{Binding Name}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
            <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="models:FolderNode">
                    <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="IsSelected" Value="{ReflectionBinding IsSelected, Mode=TwoWay}"/>
                    <Setter Property="Template">
                        <ControlTemplate>
                            <StackPanel>
                                <Border Name="PART_LayoutRoot"
                                        Focusable="True"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        MinHeight="{TemplateBinding MinHeight}"
                                        TemplatedControl.IsTemplateFocusTarget="True">
                                    <Grid Name="PART_Header" ColumnDefinitions="20,*">
                                        <Grid.Margin>
                                            <MultiBinding Converter="{x:Static converters:TreeViewItemIndentConverter.Instance}">
                                                <Binding Path="Level" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                <DynamicResource ResourceKey="CompactTreeViewItemIndent"/>
                                            </MultiBinding>
                                        </Grid.Margin>
                                        <Panel Name="PART_ExpandCollapseChevronContainer" Width="20">
                                            <ToggleButton Name="PART_ExpandCollapseChevron"
                                                          Width="20"
                                                          Height="20"
                                                          Focusable="False"
                                                          IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}">
                                                <ToggleButton.Template>
                                                    <ControlTemplate>
                                                        <Border Width="20" Height="20" Background="Transparent">
                                                            <Path Name="ChevronPath"
                                                                  Width="7" Height="7"
                                                                  Data="{StaticResource TreeViewItemCollapsedChevronPathData}"
                                                                  Fill="{DynamicResource TextMuted}"
                                                                  Stretch="Uniform"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  RenderTransformOrigin="50%,50%"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                        </Panel>
                                        <ContentPresenter Name="PART_HeaderPresenter"
                                                          Grid.Column="1"
                                                          Focusable="False"
                                                          Background="Transparent"
                                                          Content="{TemplateBinding Header}"
                                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                          HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                                          Margin="{TemplateBinding Padding}"/>
                                    </Grid>
                                </Border>
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                IsVisible="{TemplateBinding IsExpanded}"
                                                ItemsPanel="{TemplateBinding ItemsPanel}"/>
                            </StackPanel>
                        </ControlTemplate>
                    </Setter>
                </Style>
                <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
                    <Setter Property="Opacity" Value="0.62"/>
                </Style>
                <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron:pointerover">
                    <Setter Property="Opacity" Value="0.9"/>
                </Style>
                <Style Selector="TreeViewItem:empty /template/ Panel#PART_ExpandCollapseChevronContainer">
                    <Setter Property="Width" Value="20"/>
                </Style>
                <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron:checked /template/ Path#ChevronPath">
                    <Setter Property="RenderTransform" Value="rotate(90deg)"/>
                </Style>
                <Style Selector="TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
                <!-- FluentTheme paints the selected row's layout root with the accent
                     color; keep it transparent so Border.folder-row owns the visual. -->
                <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot,
                                 TreeViewItem:selected /template/ Border#PART_LayoutRoot:pointerover">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="Border.folder-row">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="Border.folder-row PathIcon">
                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                </Style>
                <Style Selector="Border.folder-row > StackPanel > TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                </Style>
                <Style Selector="Border.folder-row.active">
                    <Setter Property="Background" Value="{DynamicResource ControlSelected}"/>
                </Style>
                <Style Selector="Border.folder-row.active > StackPanel > TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                </Style>
                <Style Selector="Border.folder-row.active PathIcon">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                </Style>
            </TreeView.Styles>
        </TreeView>
    </Grid>
</UserControl>
