<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HappyPhoton.Views.CompactSlider"
             Height="22">

    <Grid ColumnDefinitions="70,*,40">
        <!-- Label on the left -->
        <TextBlock x:Name="LabelText"
                   Grid.Column="0"
                   Foreground="{StaticResource TextMuted}"
                   FontFamily="{StaticResource FontLabel}"
                   FontSize="11"
                   VerticalAlignment="Center"/>

        <!-- Track area (clickable/draggable) -->
        <Border x:Name="TrackArea"
                Grid.Column="1"
                Background="Transparent"
                Cursor="Hand"
                Margin="8,0">
            <Grid x:Name="TrackGrid" Height="20" VerticalAlignment="Center">
                <!-- Track background line -->
                <Border Background="{StaticResource SurfaceHighest}"
                        Height="4"
                        CornerRadius="2"
                        VerticalAlignment="Center"/>

                <!-- Fill bar (shows value position) - uses margin for positioning -->
                <Border x:Name="FillBar"
                        Background="{StaticResource PrimaryContainer}"
                        Height="4"
                        CornerRadius="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"/>

                <!-- Center mark (for bipolar sliders) -->
                <Border x:Name="CenterMark"
                        Background="{StaticResource Outline}"
                        Width="1"
                        Height="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                <!-- Round handle at the value position; visual only -->
                <Ellipse x:Name="ThumbDot"
                         Width="12" Height="12"
                         Fill="{StaticResource Primary}"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- Value on the right -->
        <TextBlock x:Name="ValueText"
                   Grid.Column="2"
                   Foreground="{StaticResource TextPrimary}"
                   FontFamily="{StaticResource FontLabel}"
                   FontSize="11"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"/>
    </Grid>
</UserControl>
