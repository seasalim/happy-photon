<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:views="using:HappyPhoton.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HappyPhoton.Views.CompactSlider"
             x:Name="SliderRoot" ClipToBounds="False">

    <UserControl.Styles>
        <Style Selector="TextBlock#LabelText">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border#TrackArea">
            <Setter Property="Grid.Row" Value="0"/>
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>
        <Style Selector="TextBlock#ValueText">
            <Setter Property="Grid.Column" Value="2"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontLabel}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border#ValueCell">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border#ValueCell:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlHover}"/>
        </Style>
        <Style Selector="TextBox#ValueEntry:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Outline}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Grid x:Name="LayoutGrid" ColumnDefinitions="70,*,40"
          RowDefinitions="Auto"
          Background="Transparent"
          Cursor="SizeWestEast">
        <!-- Label on the left -->
        <TextBlock x:Name="LabelText"
                   Grid.Row="0"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding Label, ElementName=SliderRoot}"/>

        <!-- Track area (clickable/draggable) -->
        <Border x:Name="TrackArea"
                Background="Transparent">
            <Grid x:Name="TrackGrid" Height="20" VerticalAlignment="Center">
                <!-- Track background line -->
                <Border x:Name="TrackLine"
                        Background="{DynamicResource OutlineVariant}"
                        Height="2"
                        VerticalAlignment="Center"/>

                <Border Background="{Binding TrackBrush, ElementName=SliderRoot}"
                        Height="{Binding Height, ElementName=TrackLine}"
                        VerticalAlignment="Center"/>

                <!-- Fill bar (shows value position) - uses margin for positioning -->
                <Border x:Name="FillBar"
                        Background="{DynamicResource TextMuted}"
                        Height="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"/>

                <!-- Center mark (for bipolar sliders) -->
                <Border x:Name="CenterMark"
                        Background="{DynamicResource Outline}"
                        Width="1"
                        Height="3" Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"/>

                <!-- The tip marks the value; the track remains unobstructed. -->
                <Path x:Name="ThumbMark" Theme="{StaticResource SliderThumbTheme}"
                      Classes.rowHover="{Binding IsPointerOver, ElementName=SliderRoot}"
                      HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </Grid>
        </Border>

        <!-- The overlay borrows only the existing margins, preserving the 40px column. -->
        <Border x:Name="ValueCell" Grid.Column="2" Width="49" Height="20"
                Margin="-6,0,-3,0"
                IsVisible="{Binding IsValueEntryEnabled, ElementName=SliderRoot}"/>
        <!-- Value on the right -->
        <TextBlock x:Name="ValueText"
                   Grid.Row="0" IsHitTestVisible="False"
                   IsVisible="{Binding !IsEditingValue, ElementName=SliderRoot}"/>
        <views:NumericEntryBox x:Name="ValueEntry" Grid.Column="2"
                              Width="49" Height="18" MinWidth="0" MinHeight="0"
                              Margin="-6,0,-3,0" Padding="2,0" BorderThickness="1"
                              CornerRadius="0" VerticalAlignment="Center"
                              FontFamily="{StaticResource FontLabel}" FontSize="{StaticResource FontSizeBody}"
                              TextAlignment="Right" VerticalContentAlignment="Center"
                              Background="{DynamicResource SurfaceHigh}"
                              BorderBrush="{DynamicResource Outline}"
                              Foreground="{DynamicResource TextPrimary}"
                              IsVisible="{Binding IsEditingValue, ElementName=SliderRoot}"/>
    </Grid>
</UserControl>
