<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HappyPhoton.Views.CompactSlider"
             x:Name="SliderRoot">

    <UserControl.Styles>
        <Style Selector="UserControl">
            <Setter Property="Height" Value="22"/>
        </Style>
        <Style Selector="TextBlock#LabelText">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontLabel}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border#TrackArea">
            <Setter Property="Grid.Row" Value="0"/>
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>
        <Style Selector="TextBlock#ValueText">
            <Setter Property="Grid.Column" Value="2"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontLabel}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid x:Name="LayoutGrid" ColumnDefinitions="70,*,40"
          RowDefinitions="Auto"
          Background="Transparent"
          Cursor="SizeWestEast">
        <!-- Label on the left -->
        <TextBlock x:Name="LabelText"
                   Grid.Row="0"/>

        <!-- Track area (clickable/draggable) -->
        <Border x:Name="TrackArea"
                Background="Transparent">
            <Grid x:Name="TrackGrid" Height="20" VerticalAlignment="Center">
                <!-- Track background line -->
                <Border x:Name="TrackLine"
                        Background="{DynamicResource SurfaceHighest}"
                        Height="4"
                        CornerRadius="2"
                        VerticalAlignment="Center"/>

                <Border Background="{Binding TrackBrush, ElementName=SliderRoot}"
                        Height="{Binding Height, ElementName=TrackLine}"
                        CornerRadius="{Binding CornerRadius, ElementName=TrackLine}"
                        VerticalAlignment="Center"/>

                <!-- Fill bar (shows value position) - uses margin for positioning -->
                <Border x:Name="FillBar"
                        Background="{StaticResource PrimaryContainer}"
                        Height="4"
                        CornerRadius="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"/>

                <!-- Center mark (for bipolar sliders) -->
                <Border x:Name="CenterMark"
                        Background="{DynamicResource Outline}"
                        Width="1"
                        Height="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                <!-- Round handle at the value position; visual only -->
                <Border x:Name="ThumbDot"
                        Width="12" Height="12"
                        Background="{StaticResource Primary}"
                        CornerRadius="6"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- Value on the right -->
        <TextBlock x:Name="ValueText"
                   Grid.Row="0"/>
    </Grid>
</UserControl>
