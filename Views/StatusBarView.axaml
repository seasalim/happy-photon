<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HappyPhoton.ViewModels"
             x:Class="HappyPhoton.Views.StatusBarView"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <Style Selector="ToggleButton.agent-toggle:checked">
            <Setter Property="Background" Value="{StaticResource PrimaryContainer}"/>
            <Setter Property="Foreground" Value="{StaticResource OnPrimary}"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource SurfaceLow}"
            BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0"
            Height="24">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding CurrentFolderPath, StringFormat='Folder: {0}'}"
                           Foreground="{DynamicResource TextMuted}" FontFamily="{StaticResource FontLabel}" Margin="8,0"/>
                <TextBlock Text="{Binding Library.PhotoCountText}"
                           Foreground="{DynamicResource TextMuted}" FontFamily="{StaticResource FontLabel}" Margin="8,0"/>
                <TextBlock Foreground="{DynamicResource TextMuted}" FontFamily="{StaticResource FontLabel}" Margin="8,0">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} selected">
                            <Binding Path="SelectedCount"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Text="{Binding ActiveFileName}" Foreground="{DynamicResource TextSecondary}" FontFamily="{StaticResource FontLabel}" Margin="8,0"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryContainer}" FontFamily="{StaticResource FontLabel}" Margin="8,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ToggleButton Classes="agent-toggle" FontSize="10" Padding="6,1"
                              Content="{Binding AgentServerLabel}"
                              IsChecked="{Binding IsAgentServerEnabled, Mode=TwoWay}"
                              ToolTip.Tip="{Binding AgentServerTooltip}"/>
                <TextBlock Text="HAPPY PHOTON ·" Foreground="{StaticResource Primary}"
                           FontFamily="{StaticResource FontLabel}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding BuildInfoText}" Foreground="{DynamicResource TextMuted}"
                           FontFamily="{StaticResource FontLabel}"
                           Margin="0,0,8,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
