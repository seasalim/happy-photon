<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HappyPhoton.ViewModels"
             x:Class="HappyPhoton.Views.StatusBarView"
             x:DataType="vm:MainWindowViewModel"
             FontSize="{StaticResource FontSizeBody}">
    <Border Background="{DynamicResource SurfaceLow}"
            BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0"
            Height="24">
        <Grid ColumnDefinitions="*,Auto,Auto" ClipToBounds="True">
            <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto,*" VerticalAlignment="Center">
                <TextBlock Grid.Column="0"
                           Foreground="{DynamicResource TextMuted}" FontFamily="{StaticResource FontBody}" Margin="8,0">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} · {1} selected">
                            <Binding Path="Browse.PhotoCountText"/>
                            <Binding Path="SelectedCount"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding ActiveFileName}"
                           Foreground="{DynamicResource TextSecondary}" FontFamily="{StaticResource FontBody}"
                           TextTrimming="CharacterEllipsis" MaxWidth="480" Margin="8,0"/>
                <TextBlock x:Name="StatusText" Grid.Column="2" Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource TextSecondary}" FontFamily="{StaticResource FontBody}"
                           TextTrimming="CharacterEllipsis" Margin="8,0"/>
            </Grid>
            <Button x:Name="UndoSyncButton" Grid.Column="1" Classes="compact-button filled"
                    Content="{Binding UndoBatchText}" Command="{Binding UndoBatchCommand}"
                    IsVisible="{Binding IsBatchUndoOffered}" Margin="8,0" Padding="6,0" Height="20" MinHeight="20"
                    VerticalAlignment="Center" ToolTip.Tip="Undo sync or paste (Ctrl+Z)"/>
            <StackPanel x:Name="BackgroundActivitySegment"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        Margin="8,0,24,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsBackgroundActivityStatusVisible}"
                        ToolTip.Tip="{Binding BackgroundActivity.Tooltip}"
                        AutomationProperties.Name="Background activity"
                        AutomationProperties.LiveSetting="Polite">
                <Ellipse x:Name="BackgroundActivityDot"
                         Width="6" Height="6"
                         Fill="{DynamicResource ControlActive}"/>
                <TextBlock x:Name="BackgroundActivityLabel"
                           Text="{Binding BackgroundActivity.Label}"
                           Foreground="{DynamicResource TextSecondary}"
                           FontFamily="{StaticResource FontBody}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="280"
                           VerticalAlignment="Center"/>
                <ProgressBar x:Name="BackgroundActivityProgress"
                             Width="60" Height="3"
                             Minimum="0"
                             Maximum="{Binding BackgroundActivity.ProgressMaximum}"
                             Value="{Binding BackgroundActivity.ProgressValue}"
                             IsIndeterminate="False"
                             IsVisible="{Binding BackgroundActivity.ShowProgress}"
                             VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
