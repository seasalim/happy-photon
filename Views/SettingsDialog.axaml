<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HappyPhoton.ViewModels"
        xmlns:models="using:HappyPhoton.Models"
        xmlns:services="using:HappyPhoton.Services"
        xmlns:views="using:HappyPhoton.Views"
        x:Class="HappyPhoton.Views.SettingsDialog"
        x:DataType="vm:MainWindowViewModel"
        Title="Settings"
        Width="650" Height="610" MinWidth="540" MinHeight="480"
        CanResize="True" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Classes="dialog">
    <Window.Styles>
        <StyleInclude Source="avares://HappyPhoton/Views/DialogTabStyles.axaml"/>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Classes="dialog-content">
            <StackPanel Spacing="3">
                <TextBlock Text="Settings" Classes="dialog-title"/>
                <TextBlock Text="Appearance, storage, and catalog metadata preferences."
                           Classes="dialog-note"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="SettingsTabs" Grid.Row="1" SelectedIndex="0"
                    Background="{DynamicResource SurfaceLow}">
            <TabItem Header="General" Classes="dialog-tab">
                <StackPanel Margin="20,16" Spacing="12" MaxWidth="540"
                            HorizontalAlignment="Left">
                    <TextBlock Text="Appearance" Classes="section-label"/>
                    <TextBlock Text="Theme" Foreground="{DynamicResource TextSecondary}"/>
                    <ComboBox Classes="edit-dropdown" x:Name="ThemeChoice" SelectionChanged="OnThemeChanged">
                        <ComboBoxItem Content="Dark"/>
                        <ComboBoxItem Content="Middle Gray"/>
                    </ComboBox>
                    <TextBlock Text="Changes apply immediately and are shared by the application."
                               Classes="dialog-note"/>
                    <TextBlock Text="Tips" Classes="section-label" Margin="0,8,0,0"/>
                    <CheckBox Content="Show tips the first time each workspace opens"
                              IsChecked="{Binding ShowTips, Mode=TwoWay}"/>
                    <TextBlock Text="Help &amp; About › Show tips shows dismissed tips again."
                               Classes="dialog-note"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Metadata" Classes="dialog-tab">
                <ScrollViewer Classes="overlay-scrollbar" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,16" Spacing="12" MaxWidth="540"
                                HorizontalAlignment="Left">
                        <TextBlock Text="XMP sidecars" Classes="section-label"/>
                        <TextBlock Text="Applies to this catalog" Classes="dialog-note"/>
                        <TextBlock Text="Mode" Foreground="{DynamicResource TextSecondary}"/>
                        <ComboBox Classes="edit-dropdown" x:Name="XmpModeChoice" SelectionChanged="OnXmpModeChanged">
                            <ComboBoxItem Content="Off"/>
                            <ComboBoxItem Content="Read only"/>
                            <ComboBoxItem Content="Read &amp; write"/>
                        </ComboBox>
                        <TextBlock Text="Off keeps today’s catalog-only behavior. Read only adopts supported ratings, flags, labels, and fill-empty crops onto V1. Read &amp; write also publishes V1 assessments and portable crops; other versions stay catalog-only."
                                   Classes="dialog-note"/>
                        <TextBlock Text="Naming for new sidecars"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0"/>
                        <ComboBox Classes="edit-dropdown" x:Name="XmpNamingChoice" SelectionChanged="OnXmpNamingChanged">
                            <ComboBoxItem Content="Full filename"/>
                            <ComboBoxItem Content="Base filename"/>
                        </ComboBox>
                        <TextBlock Text="Full name: IMG_1234.CR3.xmp   ·   Base name: IMG_1234.xmp. Existing sidecars keep their form and are never renamed."
                                   Classes="dialog-note"/>
                        <Border Background="{DynamicResource SurfaceMid}"
                                BorderBrush="{DynamicResource Divider}" BorderThickness="1" Padding="14" Margin="0,8,0,0">
                            <TextBlock Classes="dialog-note"
                                       Text="Sidecars are created beside photos and may sync through cloud providers. Originals are never modified. Ratings and zero-rotation crops interoperate with Lightroom; labels and flags may not. Enabling writing does not bulk-create sidecars for previously assessed images."/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Storage" Classes="dialog-tab">
                <views:StoragePanel DataContext="{Binding StorageSettings}"/>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Classes="dialog-footer">
            <Button Content="Close" HorizontalAlignment="Right"
                    Classes="quiet-button" Click="OnCloseClick"/>
        </Border>
    </Grid>
</Window>
