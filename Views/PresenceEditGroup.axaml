<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:HappyPhoton.Views"
             xmlns:vm="using:HappyPhoton.ViewModels"
             x:Class="HappyPhoton.Views.PresenceEditGroup"
             x:DataType="vm:MainWindowViewModel">
    <StackPanel Spacing="4">
        <views:CompactSlider x:Name="TextureSlider"
                             Label="Texture" Value="{Binding Texture}"
                             StringFormat="{}{0:+0;-0;0}"
                             EnableDoubleClickReset="True"/>
        <views:CompactSlider x:Name="ClaritySlider"
                             Label="Clarity" Value="{Binding Clarity}"
                             StringFormat="{}{0:+0;-0;0}"
                             EnableDoubleClickReset="True"/>
        <views:CompactSlider x:Name="VibranceSlider"
                             Classes="color-dependent dim-disabled"
                             Label="Vibrance"
                             Value="{Binding Vibrance}"
                             IsEnabled="{Binding IsColorEditingEnabled}"
                             StringFormat="{}{0:+0;-0;0}"
                             EnableDoubleClickReset="True"/>
        <views:CompactSlider x:Name="SaturationSlider"
                             Classes="color-dependent dim-disabled"
                             Label="Saturation"
                             Value="{Binding Saturation}"
                             IsEnabled="{Binding IsColorEditingEnabled}"
                             StringFormat="{}{0:+0;-0;0}"
                             EnableDoubleClickReset="True"/>
    </StackPanel>
</UserControl>
