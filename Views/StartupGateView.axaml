<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HappyPhoton.ViewModels"
             xmlns:views="using:HappyPhoton.Views"
             x:Class="HappyPhoton.Views.StartupGateView"
             x:DataType="vm:MainWindowViewModel">
    <Border>
        <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="{DynamicResource SurfaceLowestColor}" Offset="0"/>
                <GradientStop Color="{DynamicResource SurfaceBaseColor}" Offset="0.58"/>
                <GradientStop Color="{DynamicResource SurfaceMidColor}" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Panel>
            <views:FirstRunView IsVisible="{Binding IsFirstRunVisible}"/>

            <Border IsVisible="{Binding IsPointerRecoveryVisible}"
                    MaxWidth="560" Margin="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceLow}"
                    BorderBrush="{DynamicResource Divider}" BorderThickness="1">
                <Grid RowDefinitions="Auto,Auto">
                    <Border Classes="dialog-content">
                        <StackPanel Spacing="18">
                            <TextBlock Text="Storage pointer needs recovery" Classes="dialog-title"/>
                            <TextBlock Text="{Binding FirstRunErrorMessage}" Classes="dialog-body"/>
                            <TextBlock Text="Recovery quarantines the damaged pointer and looks for a conventional catalog. It never creates a replacement catalog automatically."
                                       Classes="dialog-note"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Classes="dialog-footer">
                        <StackPanel Classes="dialog-buttons">
                            <Button Classes="quiet-button" TabIndex="1" Content="Close" Command="{Binding CloseApplicationCommand}"/>
                            <Button Classes="quiet-button accent" TabIndex="0" Content="Recover pointer"
                                    Command="{Binding RecoverLocationPointerCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <StackPanel IsVisible="{Binding IsStartupProgressVisible}"
                        Width="260"
                        Spacing="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ProgressBar Name="StartupProgressBar"
                             IsIndeterminate="{Binding IsStartupProgressVisible}"
                             Height="3"/>
                <TextBlock Text="Opening your local catalog…"
                           Foreground="{DynamicResource TextSecondary}"
                           TextAlignment="Center"/>
            </StackPanel>

            <Border IsVisible="{Binding IsStartupError}"
                    MaxWidth="560" Margin="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceLow}"
                    BorderBrush="{DynamicResource Divider}" BorderThickness="1">
                <Grid RowDefinitions="Auto,Auto">
                    <Border Classes="dialog-content">
                        <StackPanel Spacing="20">
                            <TextBlock Text="Happy Photon couldn't open its local catalog." Classes="dialog-title"/>
                            <TextBlock Text="{Binding FirstRunErrorMessage}" Classes="dialog-body"/>
                            <Button Content="Restore from backup…" Classes="quiet-button" TabIndex="0" HorizontalAlignment="Left"
                                    IsVisible="{Binding !IsUpgradeBackupFailure}"
                                    Command="{Binding RestoreBackupCommand}"/>
                            <TextBlock Text="Your originals are untouched." Classes="dialog-note"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Classes="dialog-footer">
                        <StackPanel Classes="dialog-buttons">
                            <Button Content="Upgrade without a backup" Classes="quiet-button" TabIndex="2"
                                    IsVisible="{Binding IsUpgradeBackupFailure}"
                                    Command="{Binding UpgradeWithoutBackupCommand}"/>
                            <Button Content="Set aside and retry" Classes="quiet-button" TabIndex="3"
                                    IsVisible="{Binding CanSetAsideCatalog}"
                                    Command="{Binding SetAsideCatalogCommand}"
                                    AutomationProperties.Name="Set catalog and cache aside and retry"/>
                            <Button Content="Close" Classes="quiet-button" TabIndex="4"
                                    Command="{Binding CloseApplicationCommand}"
                                    AutomationProperties.Name="Close Happy Photon"/>
                            <Button Content="Retry" Classes="quiet-button accent" TabIndex="1"
                                    Command="{Binding RetryStartupCommand}"
                                    AutomationProperties.Name="Retry opening the local catalog"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Panel>
    </Border>
</UserControl>
