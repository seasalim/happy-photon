<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HappyPhoton.ViewModels"
             mc:Ignorable="d"
             x:Class="HappyPhoton.Views.LensEditGroup"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <Style Selector="StackPanel.optics-group:disabled">
            <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}"/>
        </Style>
        <Style Selector="Grid.optics-row">
            <Setter Property="Height" Value="28"/>
        </Style>
        <Style Selector="Grid.optics-row:disabled">
            <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}"/>
        </Style>
    </UserControl.Styles>

    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
    <StackPanel x:Name="OpticsGroup"
                Classes="optics-group"
                Spacing="2"
                IsEnabled="{Binding IsOpticsEnabled}">
        <TextBlock Classes="section-label" Text="Optics" Margin="0,19,0,8"/>
        <Grid x:Name="DistortionRow"
              Classes="optics-row"
              IsEnabled="{Binding HasLensDistortion}">
            <CheckBox x:Name="DistortionToggle"
                      Classes="edit-toggle"
                      Content="Distortion"
                      IsChecked="{Binding LensDistortion, Mode=TwoWay}"/>
        </Grid>
        <Grid x:Name="ChromaticAberrationRow"
              Classes="optics-row"
              IsEnabled="{Binding HasLensChromaticAberration}">
            <CheckBox x:Name="ChromaticAberrationToggle"
                      Classes="edit-toggle"
                      Content="Chromatic aberration"
                      IsChecked="{Binding LensChromaticAberration, Mode=TwoWay}"/>
        </Grid>
        <Grid x:Name="VignettingRow"
              Classes="optics-row"
              IsEnabled="{Binding HasLensVignetting}">
            <CheckBox x:Name="VignettingToggle"
                      Classes="edit-toggle"
                      Content="Vignetting"
                      IsChecked="{Binding LensVignetting, Mode=TwoWay}"/>
        </Grid>
        <TextBlock x:Name="LensSourceText"
                   Height="24"
                   Text="{Binding LensSourceText}"
                   TextTrimming="CharacterEllipsis"
                   FontFamily="{StaticResource FontBody}"
                   FontSize="9"
                   LetterSpacing="0.6"
                   Foreground="{DynamicResource TextMuted}"
                   VerticalAlignment="Center"/>
    </StackPanel>
    </Border>
</UserControl>
